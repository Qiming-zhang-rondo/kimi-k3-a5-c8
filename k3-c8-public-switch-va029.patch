@@ -0,0 +1,29 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import pytest
+
+from vllm_ascend.ascend_config import _resolve_kimi_k3_c8_flag
+
+
+@pytest.mark.parametrize("arch", ["KimiK3ForCausalLM", "KimiLinearForCausalLM", "KimiK3ForConditionalGeneration"])
+@pytest.mark.parametrize("enabled", [False, True])
+def test_public_switch_routes_k3(arch, enabled):
+    assert _resolve_kimi_k3_c8_flag([arch], {"enable_sparse_sfa_c8": enabled}, False, enabled) is enabled
+
+
+@pytest.mark.parametrize("enabled", [False, True])
+def test_legacy_switch_preserved(enabled):
+    assert _resolve_kimi_k3_c8_flag(["KimiK3ForCausalLM"], {}, enabled, False) is enabled
+
+
+@pytest.mark.parametrize("legacy,new", [(False, True), (True, False)])
+def test_conflict_fails(legacy, new):
+    with pytest.raises(ValueError, match="Conflicting"):
+        _resolve_kimi_k3_c8_flag(
+            ["KimiK3ForCausalLM"], {"enable_kimi_k3_sfa_c8": legacy, "enable_sparse_sfa_c8": new}, legacy, new
+        )
+
+
+@pytest.mark.parametrize("arch", [None, [], ["GlmMoeDsaForCausalLM"], ["DeepseekV3ForCausalLM"]])
+def test_non_k3_does_not_enter_k3_path(arch):
+    assert _resolve_kimi_k3_c8_flag(arch, {"enable_sparse_sfa_c8": True}, False, True) is False
