+def _resolve_kimi_k3_c8_flag(architectures, additional_config, legacy_enabled, sparse_enabled):
+    """Route the public SFA C8 switch to K3 without changing sparse-model derivation.
+
+    The internal K3 flag remains distinct: K3 reads full KV, unlike indexer SFA.
+    Values have already passed AscendConfig's bool validation.
+    """
+    is_k3 = any(
+        name in ("KimiK3ForCausalLM", "KimiLinearForCausalLM", "KimiK3ForConditionalGeneration")
+        for name in (architectures or [])
+    )
+    if not is_k3 or "enable_sparse_sfa_c8" not in additional_config:
+        return legacy_enabled
+    if "enable_kimi_k3_sfa_c8" in additional_config and legacy_enabled != sparse_enabled:
+        raise ValueError("Conflicting K3 C8 switches; use only enable_sparse_sfa_c8.")
+    return sparse_enabled
+
+
