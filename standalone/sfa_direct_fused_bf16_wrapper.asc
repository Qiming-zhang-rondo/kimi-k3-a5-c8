// Independent ASC TU for BF16 cold/final IO. Do not combine native/FP32/BF16
// kernel definitions in a unity TU or substitute a standalone cast operator.
#include "sfa_direct_api.h"
#include "sfa_fixed_contract.h"
#include "sfa_fusion_bf16_entry.asc"

#ifndef SFA_BF16_MERGE_TILE_ROWS
#define SFA_BF16_MERGE_TILE_ROWS SFA_MERGE_TILE_ROWS
#endif
#ifndef SFA_MERGE_TILE_ROWS
#define SFA_MERGE_TILE_ROWS 4
#endif
static_assert(SFA_BF16_MERGE_TILE_ROWS == 4 || SFA_BF16_MERGE_TILE_ROWS == 8 ||
              SFA_BF16_MERGE_TILE_ROWS == 16 || SFA_BF16_MERGE_TILE_ROWS == 32,
              "Unsupported BF16 merge rows; an AIV has at most 32 head rows");
extern "C" SFA_DIRECT_EXPORT uint32_t SfaDirectBf16MergeTileRows(void)
{
    return SFA_BF16_MERGE_TILE_ROWS;
}

extern "C" SFA_DIRECT_EXPORT int32_t SfaLaunchFusedBf16(void *stream, const SfaDirectBuffers *buffers, uint32_t aicCount)
{
    if (!buffers || !sfa_fixed::IsSupportedAicCount(aicCount)) return -1;
    sfa_cold_merge_bf16_probe<<<aicCount, nullptr, stream>>>(
        buffers->query, buffers->key, buffers->value, buffers->indices, buffers->blockTable,
        buffers->actualQuery, buffers->actualKv, buffers->queryRope, buffers->keyRope,
        buffers->output, buffers->maximum, buffers->sum, buffers->workspace, buffers->tiling,
        buffers->coldOutput, buffers->coldMax, buffers->coldSum, buffers->coldPresent, buffers->hotPresent);
    return 0;
}
