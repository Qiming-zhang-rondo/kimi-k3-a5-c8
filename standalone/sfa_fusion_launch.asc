// Isolated Phase-B device smoke. Given FP32 cold state + native BF16 hot read.
// No installed ACLNN symbol, C4-reader emulation, or old two-pass fallback.
#include <algorithm>
#include <array>
#include <cstdlib>
#include <fstream>
#include <iomanip>
#include <iostream>
#include <limits>
#include <stdexcept>
#include <string>
#include <vector>
#include "sfa_fusion_smoke_data.h"
#if !defined(SFA_FUSION_HOST_PREFLIGHT_ONLY)
#include "acl/acl.h"
#include "sfa_fusion_entry.asc"
#endif

#if SFA_PROBE_TEMPLATE_MODE != 0
#error "Fixed fusion smoke requires template mode 0"
#endif

namespace {
#if !defined(SFA_FUSION_HOST_PREFLIGHT_ONLY)
struct AclError { int code; const char *operation; };
void RequireAcl(aclError result, const char *operation)
{
    if (result != ACL_SUCCESS) throw AclError{static_cast<int>(result), operation};
}
void Fault(const AclError &error)
{
    std::ofstream file("DEVICE_FAULT.json");
    file << "{\"status\":\"EXECUTION_ERROR\",\"acl_error\":" << error.code
         << ",\"operation\":" << std::quoted(error.operation)
         << ",\"device_tests_stopped\":true}\n";
    std::cerr << "DEVICE_FAULT " << error.operation << " code=" << error.code
              << "; stopped: no further ACL calls, reset or automatic retry\n";
}
struct Allocation { uint8_t *pointer; std::size_t bytes; };
Allocation Allocate(std::size_t bytes, std::vector<Allocation> &allocations)
{
    uint8_t *pointer = nullptr;
    RequireAcl(aclrtMalloc(reinterpret_cast<void **>(&pointer), bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc");
    allocations.push_back({pointer, bytes});
    return {pointer, bytes};
}
void Upload(const Allocation &target, const void *data, std::size_t bytes)
{
    if (bytes != target.bytes) throw std::runtime_error("Host/device byte contract mismatch");
    RequireAcl(aclrtMemcpy(target.pointer, target.bytes, data, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "upload");
}
void Download(void *data, std::size_t bytes, const Allocation &source)
{
    if (bytes != source.bytes) throw std::runtime_error("Output byte contract mismatch");
    RequireAcl(aclrtMemcpy(data, bytes, source.pointer, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "download");
}
#endif
void WriteResults(const std::vector<sfa_fusion_smoke::Data> &cases,
                  const std::vector<sfa_smoke::CheckResult> &checks, bool passed)
{
    std::ofstream report("sfa_fusion_device_results.json", std::ios::trunc);
    report << "{\"status\":" << std::quoted(passed ? "DEVICE_SMOKE_VALIDATED" : "CONTROL_FAILED")
           << ",\"scope\":\"given_fp32_cold_state_plus_native_bf16_hot\""
           << ",\"c4_pipeline_validated\":false,\"native_twopass_compared\":false"
           << ",\"real_hot_empty_dispatch_validated\":false,\"combined_stats_returned\":false"
           << ",\"output_dtype\":\"float32\",\"output_bytes\":"
           << sfa_fixed::queryRows*sfa_fixed::latentDim*sizeof(float)
           << ",\"compact\":128,\"workspace_bytes\":" << sfa_fixed::userWorkspaceBytes
           << ",\"cases\":[";
    for (std::size_t i = 0; i < checks.size(); ++i) {
        if (i) report << ',';
        const auto &c = checks[i];
        report << "{\"name\":" << std::quoted(cases[i].name)
               << ",\"passed\":" << (c.passed ? "true" : "false")
               << ",\"relative_l2\":" << c.relativeL2
               << ",\"worst_row_relative_l2\":" << c.worstRowRelativeL2
               << ",\"max_abs\":" << c.maxAbs << ",\"nonfinite_count\":" << c.nonfinite
               << ",\"message\":" << std::quoted(c.message) << '}';
    }
    report << "]}\n";
}
} // namespace

int main(int argc, char **argv)
{
    bool run = false;
    int device = -1;
    for (int i = 1; i < argc; ++i) {
        const std::string arg(argv[i]);
        if (arg == "--run") run = true;
        else if (arg == "--device" && i+1 < argc) {
            char *end = nullptr;
            const long value = std::strtol(argv[++i], &end, 10);
            if (!end || *end || value < 0 || value > 1024) return 2;
            device = static_cast<int>(value);
        } else {
            std::cerr << "Usage: sfa_fusion_launch [--run --device N]\n";
            return 2;
        }
    }
    const auto tiling = sfa_fusion_smoke::MakeTiling();
    const auto bytes = sfa_fixed::GetBufferBytes();
    const auto cases = sfa_fusion_smoke::MakeCases();
    if (!sfa_fusion_smoke::ValidateTiling(tiling) || cases.empty()) return 2;
    for (const auto &data : cases) if (!sfa_fusion_smoke::ValidateData(data)) return 2;
    const std::size_t outputBytes = sfa_fixed::queryRows*sfa_fixed::latentDim*sizeof(float);
    std::cout << "HOST_PREFLIGHT_ONLY fusion FP32_output_bytes=" << outputBytes
              << " cold_output_bytes=" << outputBytes << " max_sum_stride=1"
              << " compact=128 returnSoftmaxLse=false cases=" << cases.size() << '\n';
    if (!run) return 0; // No ACL init or device access during preflight.
#if defined(SFA_FUSION_HOST_PREFLIGHT_ONLY)
    std::cerr << "Host-only build cannot run on a device; build with the matching ASC SDK\n";
    return 2;
#else
    if (device < 0) { std::cerr << "Explicit idle --device N required\n"; return 2; }
    if (std::ifstream("DEVICE_FAULT.json").good()) {
        std::cerr << "DEVICE_FAULT exists; device work refused\n"; return 2;
    }
    std::ofstream initial("sfa_fusion_device_results.json");
    if (!initial.good()) { std::cerr << "Cannot create report; no device access\n"; return 2; }
    initial << "{\"status\":\"RUNNING\",\"scope\":\"isolated_fusion_smoke\"}\n";
    initial.close();
    std::vector<Allocation> allocations;
    aclrtStream stream = nullptr;
    try {
        RequireAcl(aclInit(nullptr), "aclInit");
        RequireAcl(aclrtSetDevice(device), "aclrtSetDevice");
        RequireAcl(aclrtCreateStream(&stream), "aclrtCreateStream");
        const auto q=Allocate(bytes.query,allocations), key=Allocate(bytes.key,allocations);
        const auto qr=Allocate(bytes.queryRope,allocations), kr=Allocate(bytes.keyRope,allocations);
        const auto indices=Allocate(bytes.indices,allocations), table=Allocate(bytes.blockTable,allocations);
        const auto aq=Allocate(bytes.actualQuery,allocations), ak=Allocate(bytes.actualKv,allocations);
        const auto output=Allocate(outputBytes,allocations), maximum=Allocate(bytes.softmaxMax,allocations);
        const auto sum=Allocate(bytes.softmaxSum,allocations), scratch=Allocate(bytes.userWorkspace,allocations);
        const auto td=Allocate(bytes.tiling,allocations), cold=Allocate(outputBytes,allocations);
        const auto cm=Allocate(bytes.softmaxMax,allocations), cs=Allocate(bytes.softmaxSum,allocations);
        const auto cp=Allocate(sfa_fixed::queries,allocations), hp=Allocate(sfa_fixed::queries,allocations);
        const std::array<int32_t, 2> hostTable{{0,1}};
        const std::array<int32_t, 1> hostQ{{4}}, hostKV{{256}};
        Upload(table,hostTable.data(),sizeof(hostTable)); Upload(aq,hostQ.data(),sizeof(hostQ));
        Upload(ak,hostKV.data(),sizeof(hostKV)); Upload(td,&tiling,sizeof(tiling));
        std::vector<float> out(outputBytes/sizeof(float));
        std::vector<sfa_smoke::CheckResult> checks;
        bool allPassed = true;
        for (const auto &data : cases) {
            // Reference is independent of the candidate; absent sides may carry NaN poison.
            const auto expected = sfa_fusion_smoke::Reference(data);
            Upload(q,data.hot.query.data(),bytes.query); Upload(key,data.hot.key.data(),bytes.key);
            Upload(qr,data.hot.queryRope.data(),bytes.queryRope); Upload(kr,data.hot.keyRope.data(),bytes.keyRope);
            Upload(indices,data.hot.indices.data(),bytes.indices);
            Upload(cold,data.coldOutput.data(),outputBytes); Upload(cm,data.coldMax.data(),bytes.softmaxMax);
            Upload(cs,data.coldSum.data(),bytes.softmaxSum);
            Upload(cp,data.coldPresent.data(),cp.bytes); Upload(hp,data.hotPresent.data(),hp.bytes);
            std::fill(out.begin(),out.end(),std::numeric_limits<float>::quiet_NaN());
            Upload(output,out.data(),outputBytes);
            // Same task type, raw user scratch and fixed tiling as the passed original.
            sfa_cold_merge_probe<<<sfa_fixed::launchAic, nullptr, stream>>>(
                q.pointer,key.pointer,key.pointer,indices.pointer,table.pointer,aq.pointer,ak.pointer,
                qr.pointer,kr.pointer,output.pointer,maximum.pointer,sum.pointer,scratch.pointer,td.pointer,
                cold.pointer,cm.pointer,cs.pointer,cp.pointer,hp.pointer);
            RequireAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
            Download(out.data(),outputBytes,output);
            // Existing independent-math gate is 1% per row; this is not the
            // stricter native-two-pass comparison required before performance.
            checks.push_back(sfa_fusion_smoke::Check(data,out,expected,0.01));
            const auto &check = checks.back();
            std::cout << "case=" << data.name << " passed=" << check.passed
                      << " L2=" << check.relativeL2 << " worst_row=" << check.worstRowRelativeL2
                      << " max_abs=" << check.maxAbs << " reason=" << check.message << '\n';
            allPassed = allPassed && check.passed;
            WriteResults(cases,checks,allPassed && checks.size()==cases.size());
            if (!check.passed) break; // Retain first failure; no performance or retry.
        }
        allPassed = allPassed && checks.size()==cases.size();
        WriteResults(cases,checks,allPassed);
        for (auto it=allocations.rbegin(); it!=allocations.rend(); ++it)
            RequireAcl(aclrtFree(it->pointer), "aclrtFree");
        RequireAcl(aclrtDestroyStream(stream), "aclrtDestroyStream");
        RequireAcl(aclFinalize(), "aclFinalize"); // No device reset.
        return allPassed ? 0 : 1;
    } catch (const AclError &error) {
        Fault(error);
        std::ofstream report("sfa_fusion_device_results.json",std::ios::trunc);
        report << "{\"status\":\"EXECUTION_ERROR\",\"acl_error\":" << error.code
               << ",\"operation\":" << std::quoted(error.operation) << "}\n";
        return 1;
    } catch (const std::exception &error) {
        std::cerr << "ERROR: " << error.what() << '\n';
        return 1;
    }
#endif
}
