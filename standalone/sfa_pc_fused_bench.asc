// Phase C: Fused kernel timing only (compare against known W0 baseline ~87 µs)
// Uses the working fusion kernel entry from Codex's verified code
// ACL event timing: warmup 20, iterations 100, 10 rounds

#include "sparse_flash_attention_tiling_data.h"
#include "sfa_fusion_entry.asc"  // provides sfa_cold_merge_probe (verified working)

#include "acl/acl.h"
#include <cstdio>
#include <cstring>
#include <cmath>
#include <vector>
#include <algorithm>

static constexpr uint32_t B = 1, Q = 4, H = 64, D = 512, R = 64;
static constexpr uint32_t TOPK = 2048, KVT = 8192;
static constexpr int WARMUP = 20, ITERS = 100, ROUNDS = 10;

static constexpr size_t Q_B = B*Q*H*D*2, KV_B = KVT*H*D*2, QR_B = B*Q*H*R*2, KR_B = KVT*R*2;
static constexpr size_t IDX_B = B*Q*TOPK*4, OUT_F = B*Q*H*D*4;
static constexpr size_t ST_B = B*Q*H*4, TIL_B = 144, WS_B = 442368;

int main()
{
    printf("=== Phase C: Fused Kernel Timing ===\n");
    printf("B=%u Q=%u K=%u H=%u D=%u TopK=%u  warmup=%d iter=%d rounds=%d\n\n",
           B,Q,KVT,H,D,TOPK,WARMUP,ITERS,ROUNDS);

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream st; aclrtCreateStream(&st);
    aclrtEvent e0,e1; aclrtCreateEvent(&e0); aclrtCreateEvent(&e1);

    uint8_t *q,*k,*v,*qr,*kr,*idx,*bt,*sq,*sk,*of,*mx,*sm,*ws,*til;
    uint8_t *co,*cm,*cs,*cp,*hp;
    struct { const char*n; size_t z; uint8_t**p; } A[] = {
        {"q",Q_B,&q},{"k",KV_B,&k},{"v",KV_B,&v},{"qr",QR_B,&qr},{"kr",KR_B,&kr},
        {"idx",IDX_B,&idx},{"bt",256,&bt},{"sq",B*4,&sq},{"sk",B*4,&sk},
        {"outF",OUT_F,&of},{"max",ST_B,&mx},{"sum",ST_B,&sm},
        {"ws",WS_B,&ws},{"til",TIL_B,&til},
        {"co",OUT_F,&co},{"cm",ST_B,&cm},{"cs",ST_B,&cs},{"cp",Q,&cp},{"hp",Q,&hp},
    };
    for (auto &a : A) { aclrtMalloc((void**)a.p, a.z, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMemset(*a.p, a.z, 0, a.z); }

    // Tiling
    SparseFlashAttentionTilingDataMla t;
    memset(&t, 0, sizeof(t));
    t.baseParams.batchSize = B; t.baseParams.seqSize = KVT; t.baseParams.qSeqSize = Q;
    t.baseParams.blockSize = 128; t.baseParams.maxBlockNumPerBatch = (KVT+127)/128;
    t.baseParams.scaleValue = 1.0f/sqrtf((float)(D+R));
    t.baseParams.nNumOfQInOneGroup = 1;
    t.baseParams.actualLenDimsQ = Q; t.baseParams.actualLenDimsKV = KVT;
    t.baseParams.outputLayout = 1; t.baseParams.attentionMode = 2;
    t.baseParams.sparseBlockCount = TOPK;
    t.splitKVParams.s2 = 128;
    t.splitKVParams.accumOutSize = 1*2*1*64*576;
    t.splitKVParams.logSumExpSize = 2*1*2*1*64;
    t.singleCoreParams.usedCoreNum = 1;
    t.singleCoreTensorSize.mmResUbSize = 128*64;
    t.singleCoreTensorSize.bmm2ResUbSize = 576*64;
    t.innerSplitParams.mBaseSize = 64;
    t.innerSplitParams.s2BaseSize = 128;
    aclrtMemcpy(til, TIL_B, &t, TIL_B, ACL_MEMCPY_HOST_TO_DEVICE);

    int32_t sQ[B]={Q}, sK[B]={KVT};
    aclrtMemcpy(sq,B*4,sQ,B*4,ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(sk,B*4,sK,B*4,ACL_MEMCPY_HOST_TO_DEVICE);
    int32_t bT[64]; for(int i=0;i<64;i++) bT[i]=i;
    aclrtMemcpy(bt,256,bT,256,ACL_MEMCPY_HOST_TO_DEVICE);
    std::vector<int32_t> id(B*Q*TOPK); for(size_t i=0;i<id.size();i++) id[i]=i%KVT;
    aclrtMemcpy(idx,IDX_B,id.data(),IDX_B,ACL_MEMCPY_HOST_TO_DEVICE);
    uint8_t pr[Q]; memset(pr,1,Q);
    aclrtMemcpy(cp,Q,pr,Q,ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(hp,Q,pr,Q,ACL_MEMCPY_HOST_TO_DEVICE);

    printf("Buffers ready. Timing fused kernel...\n\n");

    std::vector<double> times;
    for (int r = 0; r < ROUNDS; r++) {
        // Warmup
        for (int i = 0; i < WARMUP; i++)
            sfa_cold_merge_probe<<<1,nullptr,st>>>(q,k,v,idx,bt,sq,sk,qr,kr,of,mx,sm,ws,til,co,cm,cs,cp,hp);
        aclrtSynchronizeStream(st);

        // Timed
        double total = 0;
        for (int i = 0; i < ITERS; i++) {
            aclrtRecordEvent(e0, st);
            sfa_cold_merge_probe<<<1,nullptr,st>>>(q,k,v,idx,bt,sq,sk,qr,kr,of,mx,sm,ws,til,co,cm,cs,cp,hp);
            aclrtRecordEvent(e1, st);
            aclrtSynchronizeEvent(e1);
            float ms; aclrtEventElapsedTime(&ms, e0, e1);
            total += ms;
        }
        double us = total / ITERS * 1000.0;
        times.push_back(us);
        printf("Round %2d: %8.2f µs\n", r, us);
    }

    std::sort(times.begin(), times.end());
    double med = times[ROUNDS/2];

    printf("\n=== PHASE C RESULTS ===\n");
    printf("Fused kernel:  median=%.2f µs [%.2f, %.2f]\n", med, times[0], times[ROUNDS-1]);
    printf("W0 baseline:   ~87.53 µs (existing framework)\n");
    printf("Two-pass ref:  ~126.17 µs (existing framework)\n");
    printf("Fused/W0:      %.3f\n", med / 87.53);
    printf("Fused/TwoPass: %.3f\n", med / 126.17);

    for (auto &a : A) aclrtFree(*a.p);
    aclrtDestroyEvent(e0); aclrtDestroyEvent(e1); aclrtDestroyStream(st);
    aclrtResetDevice(0); aclFinalize();
    return 0;
}
