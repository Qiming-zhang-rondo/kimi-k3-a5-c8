cmake_minimum_required(VERSION 3.16)
find_package(ASC REQUIRED)
project(sfa_phase_c LANGUAGES ASC CXX)
set(CMAKE_CXX_STANDARD 17)

set(SFA_BUNDLE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/..")
set(ASC_ROOT "${SFA_BUNDLE_ROOT}/standalone/../..")
set(ACL_INC "/usr/local/Ascend/cann-9.2.1/aarch64-linux/include")

# Include both kernel entries in one ASC compilation unit
add_executable(sfa_phase_c
    sfa_phase_c_bench.cpp
    sfa_standalone_entry.asc
    sfa_fusion_entry_main.asc
)

target_include_directories(sfa_phase_c PRIVATE
    ${CMAKE_CURRENT_SOURCE_DIR}
    ${SFA_BUNDLE_ROOT}/original
    ${SFA_BUNDLE_ROOT}/original/arch35
    ${SFA_BUNDLE_ROOT}/deps/sparse_flash_attention/arch35
    ${SFA_BUNDLE_ROOT}/deps/ascendc_common
    ${ACL_INC}
)

find_library(ACL_LIB ascendcl PATHS /usr/local/Ascend/cann-9.2.1/lib64 NO_DEFAULT_PATH)
target_link_libraries(sfa_phase_c PRIVATE m ${ACL_LIB})

target_compile_options(sfa_phase_c PRIVATE
    $<$<COMPILE_LANGUAGE:ASC>:--npu-arch=dav-3510>
)
