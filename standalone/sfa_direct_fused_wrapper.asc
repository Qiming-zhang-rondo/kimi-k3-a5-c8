// Separate ASC TU: original/experimental BaseApi classes share names and must
// never be parsed together in one device TU. The shared C API contains no types
// from either kernel; the caller supplies the existing current NPU stream.
#include "sfa_direct_api.h"
#include "sfa_fixed_contract.h"
#include "sfa_fusion_entry.asc"

#ifndef SFA_MERGE_TILE_ROWS
#define SFA_MERGE_TILE_ROWS 4
#endif
static_assert(SFA_MERGE_TILE_ROWS == 4 || SFA_MERGE_TILE_ROWS == 8 || SFA_MERGE_TILE_ROWS == 16,
              "Merge tile rows must be 4, 8 or 16");

extern "C" SFA_DIRECT_EXPORT uint32_t SfaDirectMergeTileRows(void)
{
    return SFA_MERGE_TILE_ROWS;
}

extern "C" SFA_DIRECT_EXPORT int32_t SfaLaunchFused(void *stream, const SfaDirectBuffers *buffers, uint32_t aicCount)
{
    if (!buffers || !sfa_fixed::IsSupportedAicCount(aicCount)) return -1;
    sfa_cold_merge_probe<<<aicCount, nullptr, stream>>>(
        buffers->query, buffers->key, buffers->value, buffers->indices, buffers->blockTable,
        buffers->actualQuery, buffers->actualKv, buffers->queryRope, buffers->keyRope,
        buffers->output, buffers->maximum, buffers->sum, buffers->workspace, buffers->tiling,
        buffers->coldOutput, buffers->coldMax, buffers->coldSum, buffers->coldPresent, buffers->hotPresent);
    return 0;
}
