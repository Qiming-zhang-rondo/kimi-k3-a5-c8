// Fixed original-BF16 smoke runner with an explicit raw USER SCRATCH ABI.
// Default is CPU preflight; --run --device N performs three checked NPU cases.
#include <array>
#include <algorithm>
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <iomanip>
#include <iostream>
#include <limits>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "sfa_fixed_contract.h"
#include "sfa_smoke_data.h"
#include "sfa_standalone_entry.asc"

#if SFA_PROBE_TEMPLATE_MODE != 0
#error "The fixed device smoke contract is validated for template mode 0 only"
#endif

namespace {
struct AclError { int code; const char* operation; };
void RequireAcl(aclError result, const char* operation)
{
    if (result != ACL_SUCCESS) throw AclError{static_cast<int>(result), operation};
}
void Fault(const AclError& error)
{
    std::ofstream file("DEVICE_FAULT.json");
    file << "{\"status\":\"EXECUTION_ERROR\",\"acl_error\":" << error.code
         << ",\"operation\":" << std::quoted(error.operation)
         << ",\"device_tests_stopped\":true}\n";
    std::cerr << "DEVICE_FAULT " << error.operation << " code=" << error.code
              << "; stopped, with no output copy, cleanup, reset or retry\n";
}
bool HasFault()
{
    std::ifstream marker("DEVICE_FAULT.json");
    return marker.good();
}
struct Allocation { uint8_t* pointer; std::size_t bytes; };
Allocation Allocate(std::size_t bytes, std::vector<Allocation>& allocations)
{
    uint8_t* pointer = nullptr;
    RequireAcl(aclrtMalloc(reinterpret_cast<void**>(&pointer), bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc");
    allocations.push_back({pointer, bytes});
    return {pointer, bytes};
}
void Upload(const Allocation& target, const void* data, std::size_t bytes)
{
    if (bytes != target.bytes) throw std::runtime_error("Host/device byte contract mismatch");
    RequireAcl(aclrtMemcpy(target.pointer, target.bytes, data, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "upload");
}
void Download(void* data, std::size_t bytes, const Allocation& source)
{
    if (bytes != source.bytes) throw std::runtime_error("Output byte contract mismatch");
    RequireAcl(aclrtMemcpy(data, bytes, source.pointer, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "download");
}
bool ValidateData(const sfa_smoke::Data& data)
{
    const std::array<int32_t, 2> table{{0,1}};
    const std::array<int32_t, 1> queryLength{{4}}, kvLength{{256}};
    const auto bytes = sfa_fixed::GetBufferBytes();
    return data.query.size()*2 == bytes.query && data.key.size()*2 == bytes.key &&
        data.queryRope.size()*2 == bytes.queryRope && data.keyRope.size()*2 == bytes.keyRope &&
        sfa_fixed::ValidateIndicesAndLengths(data.indices.data(), data.indices.size(),
            table.data(), table.size(), queryLength.data(), queryLength.size(),
            kvLength.data(), kvLength.size());
}
} // namespace

int main(int argc, char** argv)
{
    bool run = false;
    int device = -1;
    for (int i=1; i<argc; ++i) {
        const std::string arg(argv[i]);
        if (arg == "--run") run = true;
        else if (arg == "--device" && i+1 < argc) {
            char* end = nullptr;
            const long value = std::strtol(argv[++i], &end, 10);
            if (!end || *end || value < 0 || value > 1024) return 2;
            device = static_cast<int>(value);
        } else {
            std::cerr << "Usage: sfa_launch [--run --device N]\n";
            return 2;
        }
    }
    const auto tiling = sfa_fixed::MakeTiling();
    const auto bytes = sfa_fixed::GetBufferBytes();
    const std::array<sfa_smoke::Data,3> cases{{
        sfa_smoke::MakeData(true,0), sfa_smoke::MakeData(false,0), sfa_smoke::MakeData(true,1)}};
    if (!sfa_fixed::ValidateTiling(tiling) || !sfa_fixed::ValidateBufferBytes(bytes)) return 2;
    for (const auto& data : cases) if (!ValidateData(data)) return 2;
    sfa_fixed::WritePreflight(std::cout);
    std::cout << "workspace_abi=raw_user_scratch; no GetUserWorkspace/system prefix\n";
    if (!run) return 0; // No ACL call or device access during preflight.
    if (device < 0) { std::cerr << "Explicit idle --device N required\n"; return 2; }
    if (HasFault()) { std::cerr << "DEVICE_FAULT marker exists; device work refused\n"; return 2; }

    std::ofstream report("sfa_device_smoke_results.json");
    if (!report.good()) { std::cerr << "Cannot create the results file; no device operation performed\n"; return 2; }
    report << "{\"status\":\"RUNNING\",\"workspace_abi\":\"raw_user_scratch\",\"compact\":128}\n";
    report.close();
    std::vector<Allocation> allocations;
    aclrtStream stream = nullptr;
    try {
        RequireAcl(aclInit(nullptr), "aclInit");
        RequireAcl(aclrtSetDevice(device), "aclrtSetDevice");
        RequireAcl(aclrtCreateStream(&stream), "aclrtCreateStream");
        const auto q=Allocate(bytes.query,allocations), key=Allocate(bytes.key,allocations);
        const auto qr=Allocate(bytes.queryRope,allocations), kr=Allocate(bytes.keyRope,allocations);
        const auto indices=Allocate(bytes.indices,allocations), table=Allocate(bytes.blockTable,allocations);
        const auto aq=Allocate(bytes.actualQuery,allocations), ak=Allocate(bytes.actualKv,allocations);
        const auto output=Allocate(bytes.output,allocations), maximum=Allocate(bytes.softmaxMax,allocations);
        const auto sum=Allocate(bytes.softmaxSum,allocations), scratch=Allocate(bytes.userWorkspace,allocations);
        const auto td=Allocate(bytes.tiling,allocations);
        const std::array<int32_t,2> hostTable{{0,1}};
        const std::array<int32_t,1> hostQ{{4}}, hostKV{{256}};
        Upload(table,hostTable.data(),sizeof(hostTable));
        Upload(aq,hostQ.data(),sizeof(hostQ)); Upload(ak,hostKV.data(),sizeof(hostKV));
        Upload(td,&tiling,sizeof(tiling));
        // Poison all outputs before every launch; an empty kernel cannot pass.
        std::vector<uint16_t> out(bytes.output/2, 0x7fc1);
        std::vector<float> maxima(bytes.softmaxMax/4, std::numeric_limits<float>::quiet_NaN());
        std::vector<float> sums(bytes.softmaxSum/4, std::numeric_limits<float>::quiet_NaN());
        std::array<sfa_smoke::CheckResult,3> checks;
        std::size_t executed = 0;
        bool allPassed = true;
        for (std::size_t index=0; index<cases.size(); ++index) {
            const auto& data = cases[index];
            Upload(q,data.query.data(),bytes.query); Upload(key,data.key.data(),bytes.key);
            Upload(qr,data.queryRope.data(),bytes.queryRope); Upload(kr,data.keyRope.data(),bytes.keyRope);
            Upload(indices,data.indices.data(),bytes.indices);
            std::fill(out.begin(),out.end(),0x7fc1);
            std::fill(maxima.begin(),maxima.end(),std::numeric_limits<float>::quiet_NaN());
            std::fill(sums.begin(),sums.end(),std::numeric_limits<float>::quiet_NaN());
            Upload(output,out.data(),bytes.output); Upload(maximum,maxima.data(),bytes.softmaxMax);
            Upload(sum,sums.data(),bytes.softmaxSum);
            sfa_arch35_bf16_user_scratch_probe<<<sfa_fixed::launchAic, nullptr, stream>>>(
                q.pointer,key.pointer,key.pointer,indices.pointer,table.pointer,aq.pointer,ak.pointer,
                qr.pointer,kr.pointer,output.pointer,maximum.pointer,sum.pointer,scratch.pointer,td.pointer);
            RequireAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
            Download(out.data(),bytes.output,output);
            Download(maxima.data(),bytes.softmaxMax,maximum); Download(sums.data(),bytes.softmaxSum,sum);
            checks[index] = sfa_smoke::Check(data,out,maxima,sums);
            ++executed;
            const auto& check = checks[index];
            std::cout << "case=" << index << " passed=" << check.passed
                      << " L2=" << check.relativeL2 << " max_abs=" << check.maxAbs
                      << " reason=" << check.message << '\n';
            allPassed = allPassed && check.passed;
            if (!check.passed) break; // Retain the first incorrect output; no performance run.
        }
        allPassed = allPassed && executed == cases.size();
        report.open("sfa_device_smoke_results.json",std::ios::trunc);
        report << "{\"status\":" << std::quoted(allPassed ? "DEVICE_VALIDATED" : "CONTROL_FAILED")
               << ",\"compact\":128,\"workspace_bytes\":" << bytes.userWorkspace << ",\"cases\":[";
        for (std::size_t i=0; i<executed; ++i) {
            if (i) report << ',';
            report << "{\"index\":" << i << ",\"passed\":" << (checks[i].passed ? "true" : "false")
                   << ",\"relative_l2\":" << checks[i].relativeL2
                   << ",\"worst_row_relative_l2\":" << checks[i].worstRowRelativeL2
                   << ",\"max_abs\":" << checks[i].maxAbs
                   << ",\"max_relative_error\":" << checks[i].maxRelativeError
                   << ",\"sum_relative_error\":" << checks[i].sumRelativeError
                   << ",\"nonfinite_count\":" << checks[i].nonfinite
                   << ",\"message\":" << std::quoted(checks[i].message) << '}';
        }
        report << "]}\n"; report.close();
        for (auto it=allocations.rbegin();it!=allocations.rend();++it)
            RequireAcl(aclrtFree(it->pointer), "aclrtFree");
        RequireAcl(aclrtDestroyStream(stream), "aclrtDestroyStream");
        RequireAcl(aclFinalize(), "aclFinalize"); // Never reset the device.
        return allPassed ? 0 : 1;
    } catch (const AclError& error) {
        Fault(error);
        std::ofstream failed("sfa_device_smoke_results.json",std::ios::trunc);
        failed << "{\"status\":\"EXECUTION_ERROR\",\"acl_error\":" << error.code
               << ",\"operation\":" << std::quoted(error.operation) << "}\n";
        return 1; // No further ACL operations after any failed device call.
    } catch (const std::exception& error) {
        std::cerr << "ERROR: " << error.what() << '\n';
        return 1;
    }
}
