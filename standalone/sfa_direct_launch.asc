// SFA direct-launch host entry — Phase A
// Runs the compiled SFA kernel on A5 with fixed shape B1/Q4/K8192/H64/D512/R64/TopK2048
// Pattern follows add_custom template: aclInit → aclrtSetDevice → <<<block, null, stream>>> → sync
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <cmath>
#include <vector>
#include "acl/acl.h"

// Tiling struct (from sgl-kernel-npu public POD)
#include "sparse_flash_attention_tiling_data.h"

// Device kernel entry (from standalone entry, compiled as ASC)
// The kernel function name matches the standalone entry
// Kernel implementation included directly (same compilation unit for <<<>>> launch)
#include "sfa_standalone_entry.asc"

// ============================================================================
// Fixed experiment shape: B=1, Q=4, K=8192, H=64, D=512, R=64, TopK=2048, W=128
// ============================================================================
static constexpr uint32_t BATCH = 1;
static constexpr uint32_t NUM_QUERIES = 4;
static constexpr uint32_t NUM_KEYS = 8192;
static constexpr uint32_t NUM_HEADS = 64;
static constexpr uint32_t LATENT_DIM = 512;
static constexpr uint32_t ROPE_DIM = 64;
static constexpr uint32_t TOPK = 2048;
static constexpr uint32_t WINDOW = 128;
static constexpr uint32_t PAGE_SIZE = 128;
static constexpr uint32_t BLOCK_SIZE = 128;  // KV block size

static constexpr size_t Q_BYTES = BATCH * NUM_QUERIES * NUM_HEADS * LATENT_DIM * sizeof(uint16_t); // bf16
static constexpr size_t Q_ROPE_BYTES = BATCH * NUM_QUERIES * NUM_HEADS * ROPE_DIM * sizeof(uint16_t);
static constexpr size_t KV_BYTES = NUM_KEYS * NUM_HEADS * LATENT_DIM * sizeof(uint16_t);
static constexpr size_t K_ROPE_BYTES = NUM_KEYS * ROPE_DIM * sizeof(uint16_t);
static constexpr size_t INDICES_BYTES = BATCH * NUM_QUERIES * TOPK * sizeof(int32_t);
static constexpr size_t OUT_BYTES = BATCH * NUM_QUERIES * NUM_HEADS * LATENT_DIM * sizeof(uint16_t);
static constexpr size_t STATS_BYTES = BATCH * NUM_QUERIES * NUM_HEADS * sizeof(float);
static constexpr size_t SEQLEN_BYTES = BATCH * sizeof(int32_t);
static constexpr size_t BLOCK_TABLE_BYTES = 64 * sizeof(int32_t);  // max blocks per batch
static constexpr size_t WORKSPACE_BYTES = 4 * 1024 * 1024;  // 4MB workspace

// ============================================================================
// Fill tiling data for the fixed shape
// ============================================================================
static void FillTiling(SparseFlashAttentionTilingDataMla &t)
{
    memset(&t, 0, sizeof(t));
    t.baseParams.batchSize = BATCH;
    t.baseParams.seqSize = NUM_KEYS;
    t.baseParams.qSeqSize = NUM_QUERIES;
    t.baseParams.blockSize = BLOCK_SIZE;
    t.baseParams.maxBlockNumPerBatch = (NUM_KEYS + BLOCK_SIZE - 1) / BLOCK_SIZE;
    t.baseParams.scaleValue = 1.0f / sqrtf((float)(LATENT_DIM + ROPE_DIM));
    t.baseParams.nNumOfQInOneGroup = 1;
    t.baseParams.actualLenDimsQ = NUM_QUERIES;
    t.baseParams.actualLenDimsKV = NUM_KEYS;
    t.baseParams.outputLayout = 1;  // TND
    t.baseParams.sparseMode = 0;
    t.baseParams.preTokens = INT64_MAX;
    t.baseParams.nextTokens = INT64_MAX;
    t.baseParams.attentionMode = 2;
    t.baseParams.returnSoftmaxLse = 0;
    t.baseParams.sparseBlockSize = 1;
    t.baseParams.sparseBlockCount = TOPK;
    t.baseParams.isActualLenDimsNull = 0;
    t.baseParams.isActualLenDimsKVNull = 0;
    t.baseParams.dispatchKey = 0;

    // From upstream tiling.cpp: mmResUbSize = s2Aligned * Align(mBase, 16)
    // bmm2ResUbSize = dAligned * Align(mBase, 16)
    // accumOutSize = aicNum * 2 * n2Size * mBaseSize * dAligned
    // logSumExpSize = 2 * aicNum * 2 * n2Size * mBaseSize
    uint32_t mBase = 64;
    uint32_t s2Aligned = 128;
    uint32_t dAligned = 576;  // 512 latent + 64 rope, aligned
    uint32_t n2Size = 1;
    uint32_t aicNum = 1;

    t.splitKVParams.s2 = s2Aligned;
    t.splitKVParams.accumOutSize = aicNum * 2 * n2Size * mBase * dAligned;
    t.splitKVParams.logSumExpSize = 2 * aicNum * 2 * n2Size * mBase;

    t.singleCoreParams.usedCoreNum = aicNum;

    t.singleCoreTensorSize.mmResUbSize = s2Aligned * ((mBase + 15) / 16) * 16;
    t.singleCoreTensorSize.bmm2ResUbSize = dAligned * ((mBase + 15) / 16) * 16;

    t.innerSplitParams.mBaseSize = mBase;
    t.innerSplitParams.s2BaseSize = s2Aligned;
}

// ============================================================================
// Host-side reference computation (simple, for zero-Q test)
// ============================================================================
int main(int argc, char *argv[])
{
    printf("=== SFA Direct Launch Test (Phase A) ===\n");
    printf("Shape: B=%u Q=%u K=%u H=%u D=%u R=%u TopK=%u W=%u\n",
           BATCH, NUM_QUERIES, NUM_KEYS, NUM_HEADS, LATENT_DIM, ROPE_DIM, TOPK, WINDOW);

    // ACL init
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("ERROR: aclrtSetDevice failed, ret=%d\n", ret);
        return 1;
    }
    printf("Device %d set OK\n", deviceId);

    // Get core count
    int64_t coreNum = 0;
    aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreNum);
    printf("Vector cores: %ld\n", (long)coreNum);

    // Create stream
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // Allocate tiling
    SparseFlashAttentionTilingDataMla tilingData;
    FillTiling(tilingData);
    printf("Tiling size: %zu bytes\n", sizeof(tilingData));

    uint8_t *tilingDev = nullptr;
    aclrtMalloc((void **)&tilingDev, sizeof(tilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDev, sizeof(tilingData), &tilingData, sizeof(tilingData),
                ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate inputs (all zero for zero-Q test)
    uint8_t *qDev = nullptr, *kDev = nullptr, *vDev = nullptr;
    uint8_t *qRopeDev = nullptr, *kRopeDev = nullptr;
    uint8_t *indicesDev = nullptr, *blockTableDev = nullptr;
    uint8_t *seqLenQDev = nullptr, *seqLenKVDev = nullptr;
    uint8_t *outDev = nullptr, *maxDev = nullptr, *sumDev = nullptr;
    uint8_t *wsDev = nullptr;

    // Allocate device memory
    struct AllocPair { const char *name; size_t bytes; uint8_t **ptr; };
    AllocPair allocs[] = {
        {"query", Q_BYTES, &qDev},
        {"key", KV_BYTES, &kDev},
        {"value", KV_BYTES, &vDev},
        {"queryRope", Q_ROPE_BYTES, &qRopeDev},
        {"keyRope", K_ROPE_BYTES, &kRopeDev},
        {"indices", INDICES_BYTES, &indicesDev},
        {"blockTable", BLOCK_TABLE_BYTES, &blockTableDev},
        {"seqLenQ", SEQLEN_BYTES, &seqLenQDev},
        {"seqLenKV", SEQLEN_BYTES, &seqLenKVDev},
        {"out", OUT_BYTES, &outDev},
        {"max", STATS_BYTES, &maxDev},
        {"sum", STATS_BYTES, &sumDev},
        {"workspace", WORKSPACE_BYTES, &wsDev},
    };

    for (auto &a : allocs) {
        ret = aclrtMalloc((void **)a.ptr, a.bytes, ACL_MEM_MALLOC_HUGE_FIRST);
        if (ret != ACL_SUCCESS) {
            printf("ERROR: aclrtMalloc(%s) failed, ret=%d\n", a.name, ret);
            return 1;
        }
        // Zero-fill on device
        aclrtMemset(*a.ptr, a.bytes, 0, a.bytes);
    }
    printf("All device buffers allocated and zeroed\n");

    // Fill seq lengths on host, copy to device
    int32_t seqLenQ[BATCH] = {NUM_QUERIES};
    int32_t seqLenKV[BATCH] = {NUM_KEYS};
    aclrtMemcpy(seqLenQDev, SEQLEN_BYTES, seqLenQ, SEQLEN_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(seqLenKVDev, SEQLEN_BYTES, seqLenKV, SEQLEN_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);

    // Fill block table (identity: block i maps to block i)
    // For PA_BSND layout
    int32_t blockTable[64];
    uint32_t numBlocks = (NUM_KEYS + BLOCK_SIZE - 1) / BLOCK_SIZE;
    for (uint32_t i = 0; i < numBlocks && i < 64; i++) {
        blockTable[i] = i;
    }
    aclrtMemcpy(blockTableDev, BLOCK_TABLE_BYTES, blockTable, BLOCK_TABLE_BYTES,
                ACL_MEMCPY_HOST_TO_DEVICE);

    // Fill sparse indices: compact 128 hot + 1920 cold from TopK 2048
    // Simple: indices [0, 2048) = all keys selected (zero-Q test)
    std::vector<int32_t> indices(NUM_QUERIES * TOPK);
    for (uint32_t q = 0; q < NUM_QUERIES; q++) {
        for (uint32_t i = 0; i < TOPK; i++) {
            indices[q * TOPK + i] = i;  // Select first 2048 keys
        }
    }
    aclrtMemcpy(indicesDev, INDICES_BYTES, indices.data(), INDICES_BYTES,
                ACL_MEMCPY_HOST_TO_DEVICE);

    printf("Launching kernel...\n");

    // Launch kernel: <<<blockNum, shared_mem, stream>>>
    // MIX kernel uses blockDim from tiling
    uint32_t blockNum = 1;  // Use 8 AIC+AIV pairs (typical for MIX kernel)
    sfa_arch35_bf16_compile_probe<<<blockNum, nullptr, stream>>>(
        qDev, kDev, vDev,
        indicesDev, blockTableDev,
        seqLenQDev, seqLenKVDev,
        qRopeDev, kRopeDev,
        outDev, maxDev, sumDev,
        wsDev, tilingDev);

    printf("Kernel launched, syncing...\n");
    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) {
        printf("ERROR: aclrtSynchronizeStream failed, ret=%d\n", ret);
    } else {
        printf("Kernel completed OK\n");
    }

    // Copy outputs back and check
    std::vector<uint16_t> outHost(OUT_BYTES / sizeof(uint16_t));
    std::vector<float> maxHost(STATS_BYTES / sizeof(float));
    std::vector<float> sumHost(STATS_BYTES / sizeof(float));

    aclrtMemcpy(outHost.data(), OUT_BYTES, outDev, OUT_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(maxHost.data(), STATS_BYTES, maxDev, STATS_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(sumHost.data(), STATS_BYTES, sumDev, STATS_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);

    // Zero-Q test: all Q are zero → exp(max)*sum should be 2048 (TopK count)
    printf("\n=== Zero-Q validation ===\n");
    printf("softmaxMax[0]=%f, softmaxSum[0]=%f\n", maxHost[0], sumHost[0]);
    printf("Expected: max=0 (all zero scores), sum=TopK=2048\n");

    // Check for NaN/Inf
    bool hasNaN = false;
    for (size_t i = 0; i < outHost.size(); i++) {
        uint16_t val = outHost[i];
        // bf16 NaN check
        if ((val & 0x7FC0) == 0x7FC0) { hasNaN = true; break; }
    }
    printf("Output has NaN: %s\n", hasNaN ? "YES ❌" : "NO ✅");

    // Cleanup
    for (auto &a : allocs) {
        aclrtFree(*a.ptr);
    }
    aclrtFree(tilingDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("\n=== Phase A test %s ===\n", (ret == ACL_SUCCESS && !hasNaN) ? "PASSED" : "FAILED");
    return (ret == ACL_SUCCESS && !hasNaN) ? 0 : 1;
}
