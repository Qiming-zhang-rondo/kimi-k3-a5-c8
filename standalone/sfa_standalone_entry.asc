 /*!
 * \file sfa_standalone_entry.asc
 * \brief
 */

// Isolated compile-only draft. Not a deployed/private-package launch ABI.
// POD source: sgl-project/sgl-kernel-npu @
// 597250fcc1b31f2607bf817d42bd0699ea60b8eb.
// Do not execute with a private serializer until field offsets and lengths match.
#include "kernel_operator.h"
#include "impl/basic_api/kernel_macros.h"
#include "sparse_flash_attention_tiling_data.h"
#if (__CCE_AICORE__ != 310)
#error "This compile probe intentionally targets arch35 only"
#endif
#include "arch35/sparse_flash_attention_kernel_mla.h"

using namespace AscendC;

#ifndef SFA_PROBE_TEMPLATE_MODE
#define SFA_PROBE_TEMPLATE_MODE 0
#endif
static_assert(SFA_PROBE_TEMPLATE_MODE == 0 || SFA_PROBE_TEMPLATE_MODE == 1,
              "Build C/V modes separately; this is not a runtime dispatch key");
static_assert(sizeof(SparseFlashAttentionTilingDataMla) == 144,
              "Probe requires the exact pinned SGL POD");
static_assert(sizeof(SparseFlashAttentionTilingDataMla) / sizeof(uint32_t) == 36,
              "Read exactly the declared POD, never a hardcoded 160 bytes");
static_assert(alignof(SparseFlashAttentionTilingDataMla) == 8,
              "Preserve the pinned POD alignment");

// Same six template axes and argument ordering as the private arch35 entry.
// BF16 input/output and FP32 accumulation are fixed for the native baseline.
template<int FLASH_DECODE, int PAGE_ATTENTION, int LAYOUT_T, int KV_LAYOUT_T,
         int TEMPLATE_MODE, int IS_SPLIT_G>
__aicore__ inline void RunSfaArch35Bf16(
    __gm__ uint8_t *query, __gm__ uint8_t *key, __gm__ uint8_t *value,
    __gm__ uint8_t *sparseIndices, __gm__ uint8_t *blocktable,
    __gm__ uint8_t *actualSeqLengthsQuery, __gm__ uint8_t *actualSeqLengthsKV,
    __gm__ uint8_t *queryRope, __gm__ uint8_t *keyRope,
    __gm__ uint8_t *attentionOut, __gm__ uint8_t *softmaxMax, __gm__ uint8_t *softmaxSum,
    __gm__ uint8_t *workspace, __gm__ uint8_t *tiling)
{
    static_assert(FLASH_DECODE == 0 && PAGE_ATTENTION == 1 &&
                  LAYOUT_T == 1 && KV_LAYOUT_T == 2 && IS_SPLIT_G == 0,
                  "Compile probe is fixed to TND/PA_BSND without flash-decode/G split");
#define SFA_PROBE_TYPES \
    bfloat16_t, bfloat16_t, float, bfloat16_t, FLASH_DECODE, PAGE_ATTENTION, \
    static_cast<SFA_LAYOUT>(LAYOUT_T), static_cast<SFA_LAYOUT>(KV_LAYOUT_T), \
    static_cast<SFATemplateMode>(TEMPLATE_MODE), IS_SPLIT_G
    using CubeBlockType = typename std::conditional<g_coreType == AscendC::AIC,
        BaseApi::SFAMatmulService<SFA_PROBE_TYPES>,
        BaseApi::SFAMatmulServiceDummy<SFA_PROBE_TYPES>>::type;
    using VecBlockType = typename std::conditional<g_coreType == AscendC::AIC,
        BaseApi::SFAVectorServiceDummy<SFA_PROBE_TYPES>,
        BaseApi::SFAVectorService<SFA_PROBE_TYPES>>::type;
#undef SFA_PROBE_TYPES
    BaseApi::SparseFlashAttentionKernelMla<CubeBlockType, VecBlockType> op;
    TPipe tPipe;
    __gm__ uint8_t *user = GetUserWorkspace(workspace);
#if defined(__DAV_C310_CUBE__)
    // AIC receives sharedParams from AIV through the original SSBUF protocol.
    // It must not receive a UB address pretending to be a local struct pointer.
    op.Init(query, key, value, sparseIndices, actualSeqLengthsQuery, actualSeqLengthsKV,
            blocktable, queryRope, keyRope, attentionOut, softmaxMax, softmaxSum,
            user, nullptr, tiling, &tPipe);
    op.Process();
#else
    // This is local scalar storage, not static __ubuf__ storage. Its lifetime
    // encloses BOTH Init and Process. This loop is the pinned SGL entry's method.
    SparseFlashAttentionTilingDataMla tilingDataLocal;
    const __gm__ uint32_t *tilingWords =
        reinterpret_cast<const __gm__ uint32_t *>(tiling);
    uint32_t *localWords = reinterpret_cast<uint32_t *>(&tilingDataLocal);
#pragma unroll
    for (uint32_t i = 0; i < sizeof(tilingDataLocal) / sizeof(uint32_t); ++i) {
        localWords[i] = tilingWords[i];
    }
    op.Init(query, key, value, sparseIndices, actualSeqLengthsQuery, actualSeqLengthsKV,
            blocktable, queryRope, keyRope, attentionOut, softmaxMax, softmaxSum,
            user, &tilingDataLocal, tiling, &tPipe);
    op.Process();
#endif
}

// A non-template exported kernel instantiates the selected template bodies.
// Inspect SDK device objects/metadata for BOTH AIC and AIV before reporting a build pass.
// It deliberately does not read SGL's dispatchKey from private tiling bytes.
extern "C" __global__ __aicore__ void sfa_arch35_bf16_compile_probe(
    __gm__ uint8_t *query, __gm__ uint8_t *key, __gm__ uint8_t *value,
    __gm__ uint8_t *sparseIndices, __gm__ uint8_t *blocktable,
    __gm__ uint8_t *actualSeqLengthsQuery, __gm__ uint8_t *actualSeqLengthsKV,
    __gm__ uint8_t *queryRope, __gm__ uint8_t *keyRope,
    __gm__ uint8_t *attentionOut, __gm__ uint8_t *softmaxMax, __gm__ uint8_t *softmaxSum,
    __gm__ uint8_t *workspace, __gm__ uint8_t *tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    RunSfaArch35Bf16<0, 1, 1, 2, SFA_PROBE_TEMPLATE_MODE, 0>(
        query, key, value, sparseIndices, blocktable, actualSeqLengthsQuery,
        actualSeqLengthsKV, queryRope, keyRope, attentionOut, softmaxMax,
        softmaxSum, workspace, tiling);
}
