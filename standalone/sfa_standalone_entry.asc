// Standalone SFA kernel entry for A5 (dav-3510)
// Bypasses GET_TILING_DATA_WITH_STRUCT (injected by libaihac_codegen.so)
// by manually reading tiling data from GM.
// Tiling struct from sgl-kernel-npu (public POD, mirrors CANN serialized layout).
// Kernel implementation from original custom_cot arch35 (identical to upstream, diff=0).

#include "kernel_operator.h"
#include "sparse_flash_attention_tiling_data.h"
#include "sparse_flash_attention_common.h"
#include "arch35/sparse_flash_attention_kernel_mla.h"

using namespace AscendC;

// Read tiling data from GM using DataCopy (replaces GET_TILING_DATA_WITH_STRUCT)
// The original macro is injected by libaihac_codegen.so at compile time;
// for standalone builds we read the 144-byte struct manually.
static __ubuf__ uint8_t tilingScratch[256] __attribute__((aligned(32)));

__aicore__ inline const SparseFlashAttentionTilingDataMla* ReadTiling(GM_ADDR tiling)
{
    __gm__ uint8_t* tilingGm = reinterpret_cast<__gm__ uint8_t*>(tiling);
    // Read 144 bytes (sizeof(SparseFlashAttentionTilingDataMla)) into UB
    // Round up to 32-byte alignment for DataCopy
    for (int i = 0; i < 160; i += 32) {
        for (int j = 0; j < 32; ++j) {
            tilingScratch[i + j] = tilingGm[i + j];
        }
    }
    return reinterpret_cast<const SparseFlashAttentionTilingDataMla*>(tilingScratch);
}

template<int FLASH_DECODE, int PAGE_ATTENTION, int LAYOUT_T, int KV_LAYOUT_T,
         int TEMPLATE_MODE, int IS_SPLIT_G>
__global__ __aicore__ void
sparse_flash_attention_standalone(
    __gm__ uint8_t *query, __gm__ uint8_t *key, __gm__ uint8_t *value,
    __gm__ uint8_t *sparseIndices, __gm__ uint8_t *blocktable,
    __gm__ uint8_t *actualSeqLengthsQuery, __gm__ uint8_t *actualSeqLengthsKV,
    __gm__ uint8_t *queryRope, __gm__ uint8_t *keyRope,
    __gm__ uint8_t *attentionOut, __gm__ uint8_t *softmaxMax, __gm__ uint8_t *softmaxSum,
    __gm__ uint8_t *workspace, __gm__ uint8_t *tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);

    TPipe tPipe;
    __gm__ uint8_t *user = GetUserWorkspace(workspace);

    const SparseFlashAttentionTilingDataMla *tiling_data = ReadTiling(tiling);

    // A5 path: SparseFlashAttentionMla<SFAType<...>> (not BaseApi)
    // Follow original entry: SFA_OP_IMPL(SparseFlashAttentionMla, ..., bfloat16_t, bfloat16_t, bfloat16_t, ...)
    SparseFlashAttentionMla<SFAType<bfloat16_t, bfloat16_t, bfloat16_t,
        FLASH_DECODE, LAYOUT_T, KV_LAYOUT_T, TEMPLATE_MODE>> op;
    op.Init(query, key, value, sparseIndices, actualSeqLengthsQuery, actualSeqLengthsKV,
        blocktable, queryRope, keyRope, attentionOut, softmaxMax, softmaxSum,
        user, tiling_data, tiling, &tPipe);
    op.Process();
}
