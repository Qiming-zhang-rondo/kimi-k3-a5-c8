// One ASC translation unit owns ONLY the original entry and its native types.
// Never include the experimental entry here or merge this TU with its wrapper.
#include "sfa_direct_api.h"
#include "sfa_fixed_contract.h"
#include "sfa_standalone_entry.asc"

extern "C" SFA_DIRECT_EXPORT uint32_t SfaDirectAbiVersion(void)
{
    return 3;
}

extern "C" SFA_DIRECT_EXPORT uint32_t SfaDirectBuffersBytes(void)
{
    static_assert(sizeof(SfaDirectBuffers) == 19 * sizeof(uint8_t *), "C ABI pointer layout changed");
    static_assert(sizeof(SfaDirectBuffers) <= UINT32_MAX, "C ABI size exceeds its return type");
    return static_cast<uint32_t>(sizeof(SfaDirectBuffers));
}

extern "C" SFA_DIRECT_EXPORT int32_t SfaLaunchOriginal(void *stream, const SfaDirectBuffers *buffers, uint32_t aicCount)
{
    if (!buffers || !sfa_fixed::IsSupportedAicCount(aicCount)) return -1;
    sfa_arch35_bf16_user_scratch_probe<<<aicCount, nullptr, stream>>>(
        buffers->query, buffers->key, buffers->value, buffers->indices, buffers->blockTable,
        buffers->actualQuery, buffers->actualKv, buffers->queryRope, buffers->keyRope,
        buffers->output, buffers->maximum, buffers->sum, buffers->workspace, buffers->tiling);
    return 0;
}
