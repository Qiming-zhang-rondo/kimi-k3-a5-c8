// Standalone ring-writer correctness probe, NOT the Cloud Prolog kernel.
// Keep the same compiler-selected vector guard as the working KV-split reducer.
#include "prolog_ring_smoke_api.h"
#include "kernel_operator.h"

#if defined(__NPU_ARCH__) && (__NPU_ARCH__ != 0) && (__NPU_ARCH__ != 3510)
#error "Ring smoke requires compiler-selected dav-3510"
#endif
#if (defined(__DAV_C310_CUBE__) || defined(__DAV_C310_VEC__)) && \
    (!defined(__NPU_ARCH__) || __NPU_ARCH__ != 3510)
#error "Missing compiler-selected architecture; do not define SDK macros manually"
#endif

#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 3510 && defined(__DAV_C310_VEC__)
namespace QsfaRingSmoke {
using namespace AscendC;
inline __aicore__ void Run(GM_ADDR latentInput,GM_ADDR ropeInput,GM_ADDR latent,
    GM_ADDR rope,GM_ADDR positionTags,GM_ADDR epochTags,GM_ADDR banks,
    GM_ADDR positions,GM_ADDR epochs,GM_ADDR valid,uint32_t rows,uint32_t pools,
    uint32_t capacity,uint32_t enabled)
{
    if (!enabled) return;
    GlobalTensor<float> inputGm; inputGm.SetGlobalBuffer((__gm__ float*)latentInput);
    GlobalTensor<bfloat16_t> ropeInputGm; ropeInputGm.SetGlobalBuffer((__gm__ bfloat16_t*)ropeInput);
    GlobalTensor<bfloat16_t> latentGm; latentGm.SetGlobalBuffer((__gm__ bfloat16_t*)latent);
    GlobalTensor<bfloat16_t> ropeGm; ropeGm.SetGlobalBuffer((__gm__ bfloat16_t*)rope);
    GlobalTensor<int64_t> posTagsGm; posTagsGm.SetGlobalBuffer((__gm__ int64_t*)positionTags);
    GlobalTensor<int64_t> epochTagsGm; epochTagsGm.SetGlobalBuffer((__gm__ int64_t*)epochTags);
    GlobalTensor<int32_t> banksGm; banksGm.SetGlobalBuffer((__gm__ int32_t*)banks);
    GlobalTensor<int64_t> positionsGm; positionsGm.SetGlobalBuffer((__gm__ int64_t*)positions);
    GlobalTensor<int64_t> epochsGm; epochsGm.SetGlobalBuffer((__gm__ int64_t*)epochs);
    GlobalTensor<uint8_t> validGm; validGm.SetGlobalBuffer((__gm__ uint8_t*)valid);
    TPipe pipe;
    TBuf<TPosition::VECCALC> inputBuf,ropeBuf,castBuf,bankBuf,posBuf,epochBuf,validBuf,tagsBuf;
    pipe.InitBuffer(inputBuf,512*sizeof(float));
    pipe.InitBuffer(ropeBuf,64*sizeof(bfloat16_t));
    pipe.InitBuffer(castBuf,512*sizeof(bfloat16_t));
    pipe.InitBuffer(bankBuf,32); pipe.InitBuffer(posBuf,32);
    pipe.InitBuffer(epochBuf,32); pipe.InitBuffer(validBuf,32); pipe.InitBuffer(tagsBuf,64);
    auto inputUb=inputBuf.Get<float>(); auto ropeUb=ropeBuf.Get<bfloat16_t>();
    auto castUb=castBuf.Get<bfloat16_t>(); auto bankUb=bankBuf.Get<int32_t>();
    auto posUb=posBuf.Get<int64_t>(); auto epochUb=epochBuf.Get<int64_t>();
    auto validUb=validBuf.Get<uint8_t>(); auto tagsUb=tagsBuf.Get<int64_t>();
    const DataCopyPadExtParams<int32_t> pad32{false,0,0,0};
    const DataCopyPadExtParams<int64_t> pad64{false,0,0,0};
    const DataCopyPadExtParams<uint8_t> pad8{false,0,0,0};
    const DataCopyExtParams copy4{1,4,0,0,0},copy8{1,8,0,0,0},copy1{1,1,0,0,0};
    for (uint32_t token=GetBlockIdx();token<rows;token+=GetBlockNum()) {
        // Reload changing graph metadata through MTE2 -> UB -> Scalar.
        DataCopyPad(bankUb,banksGm[token],copy4,pad32);
        DataCopyPad(posUb,positionsGm[token],copy8,pad64);
        DataCopyPad(epochUb,epochsGm[token],copy8,pad64);
        DataCopyPad(validUb,validGm[token],copy1,pad8);
        SetFlag<HardEvent::MTE2_S>(EVENT_ID0); WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
        const int32_t bank=bankUb.GetValue(0);
        const int64_t position=posUb.GetValue(0),epoch=epochUb.GetValue(0);
        const bool active=validUb.GetValue(0)!=0;
        SetFlag<HardEvent::S_MTE2>(EVENT_ID0); WaitFlag<HardEvent::S_MTE2>(EVENT_ID0);
        if (!active || bank<0 || static_cast<uint32_t>(bank)>=pools || position<0 || epoch<0) continue;
        const uint64_t row=static_cast<uint64_t>(bank)*capacity+static_cast<uint64_t>(position)%capacity;
        // These aligned UB<->GM three-argument calls match the working reducer.
        DataCopy(inputUb,inputGm[static_cast<uint64_t>(token)*512],512);
        DataCopy(ropeUb,ropeInputGm[static_cast<uint64_t>(token)*64],64);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(castUb,inputUb,RoundMode::CAST_RINT,static_cast<uint32_t>(512));
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopy(latentGm[row*512],castUb,512);
        DataCopy(ropeGm[row*64],ropeUb,64);
        tagsUb.SetValue(0,position); tagsUb.SetValue(4,epoch);
        SetFlag<HardEvent::S_MTE3>(EVENT_ID0); WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
        DataCopyPad(posTagsGm[row],tagsUb,copy8);
        DataCopyPad(epochTagsGm[row],tagsUb[4],copy8);
        // Each consumer finishes before its UB source can be reused.
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0); WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE3_S>(EVENT_ID0); WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
    }
}
} // namespace QsfaRingSmoke
#endif

extern "C" __global__ __aicore__ void qsfa_prolog_ring_smoke_kernel(
    GM_ADDR inputLatent,GM_ADDR inputRope,GM_ADDR latentRing,GM_ADDR ropeRing,
    GM_ADDR positionTags,GM_ADDR epochTags,GM_ADDR banks,GM_ADDR positions,
    GM_ADDR epochs,GM_ADDR valid,uint32_t rows,uint32_t pools,uint32_t capacity,uint32_t enabled)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 3510 && defined(__DAV_C310_VEC__)
    QsfaRingSmoke::Run(inputLatent,inputRope,latentRing,ropeRing,positionTags,epochTags,
        banks,positions,epochs,valid,rows,pools,capacity,enabled);
#endif
}

extern "C" QSFA_RING_EXPORT uint32_t QsfaPrologRingSmokeAbiVersion() { return 1; }
extern "C" QSFA_RING_EXPORT uint32_t QsfaPrologRingSmokeBuffersBytes() { return sizeof(PrologRingSmokeBuffers); }
extern "C" QSFA_RING_EXPORT int32_t QsfaPrologRingSmokeLaunch(void *stream,
    const PrologRingSmokeBuffers *b,uint32_t rows,uint32_t pools,uint32_t capacity,
    uint32_t blocks,uint32_t enabled)
{
    if (!b || !rows || !pools || !capacity || capacity%128 || !blocks || blocks>rows || blocks>64 || enabled>1 ||
        !b->inputLatent || !b->inputRope || !b->latentRing || !b->ropeRing || !b->positionTags ||
        !b->epochTags || !b->tokenBanks || !b->tokenPositions || !b->tokenEpochs || !b->tokenValid) return -1;
    qsfa_prolog_ring_smoke_kernel<<<blocks,nullptr,stream>>>(b->inputLatent,b->inputRope,
        b->latentRing,b->ropeRing,b->positionTags,b->epochTags,b->tokenBanks,b->tokenPositions,
        b->tokenEpochs,b->tokenValid,rows,pools,capacity,enabled);
    return 0;
}
