// Isolated V4 load geometry plus KV-split scheduling. ABI2 is explicit.
#include "single_pass_api.h"
#define QSFA_RECENT_KV_SPLIT 1
#define KvQuantSparseFlashAttentionTilingDataMla Recent128KvSplitTilingDataMla
#include "kv_split_tiling.h"
#define QSFA_RECENT_ROUTE_HOT 1
#define QSFA_RECENT_ROUTE_FAST_PAIR 1
#define QSFA_RECENT_LOAD_ROWS 32
#define QSFA_RECENT_INPUT_ROW_BYTES 416
#define QSFA_RECENT_INPUT_BUFFERS 2
#define QSFA_RECENT_OUTPUT_BUFFERS 1
#define AntiquantBIMxfp4Tile AntiquantBIMxfp4TileKvSplit
#define AntiquantVFImplBIMxfp4 AntiquantVFImplBIMxfp4KvSplit
#define AntiquantVFImplBIMxfp4Routed AntiquantVFImplBIMxfp4RoutedKvSplit
#define QSFAMatmulService Recent128KvSplitMatmulService
#define QSFAMatmulServiceDummy Recent128KvSplitMatmulServiceDummy
#define Recent128QSFAVectorService Recent128KvSplitVectorService
#define Recent128QSFAVectorServiceDummy Recent128KvSplitVectorServiceDummy
#define Recent128KvQuantSparseFlashAttentionMla Recent128KvSplitAttention
#define QSFA_SINGLE_PASS_CANDIDATE 1
#define QSFA_SINGLE_PASS_KERNEL qsfa_recent128_kv_split_attention
#define QSFA_SINGLE_PASS_RUN RunQsfaRecent128KvSplitAttention
#include "single_pass_entry.asc"

extern "C" QSFA_SINGLE_PASS_EXPORT uint32_t QsfaSinglePassKvSplitAbiVersion() { return 2; }
extern "C" QSFA_SINGLE_PASS_EXPORT uint32_t QsfaSinglePassKvSplitTilingBytes()
{ return sizeof(recent128_single_pass::SplitTiling); }

extern "C" QSFA_SINGLE_PASS_EXPORT int32_t QsfaSinglePassLaunchKvSplit(
    void *stream, const SinglePassBuffers *b, uint32_t aicCount,
    uint32_t ringCapacity, uint32_t window, uint32_t queries, uint32_t splits,
    uint32_t returnStats)
{
    if (!b || !b->query || !b->cold || !b->indices || !b->blockTable ||
        !b->actualQuery || !b->actualKv || !b->hotLatent || !b->hotRope ||
        !b->ringTags || !b->queryPositions || !b->output || !b->workspace || !b->tiling ||
        queries == 0 || (splits != 1 && splits != 2 && splits != 4) ||
        queries > 16 / splits || aicCount != queries * splits ||
        ringCapacity < 128 + queries - 1 || ringCapacity % 128 ||
        (window != 0 && window != 128) || returnStats > 1 ||
        (returnStats && (!b->maximum || !b->sum))) return -1;
    qsfa_recent128_kv_split_attention<<<aicCount, nullptr, stream>>>(
        b->query, b->cold, b->indices, b->blockTable, b->actualQuery, b->actualKv,
        b->hotLatent, b->hotRope, b->ringTags, b->queryPositions, b->output,
        b->maximum, b->sum, b->workspace, b->tiling, ringCapacity, window);
    // Host and device share this exact layout; no GM tiling read on the host.
    const uint64_t tasks = static_cast<uint64_t>(queries) * splits;
    const uint64_t outputBytes = tasks * 64 * 512 * sizeof(float);
    const uint64_t statsBytes = tasks * 64 * sizeof(float);
    // 16 AIV blocks with grid-stride query/head assignment. Same stream creates
    // the dependency; no in-kernel cross-core spin/barrier is introduced.
    return QsfaSinglePassLaunchKvSplitReduce(stream, b->workspace, b->workspace + outputBytes,
        b->workspace + outputBytes + statsBytes, b->output, b->maximum, b->sum,
        queries, splits, 16, returnStats);
}
