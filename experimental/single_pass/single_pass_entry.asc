// Include in exactly one original/candidate ASC TU. Host/device isolation follows
// the already compiled direct SFA bridge; no TBE injected tiling macro is used.
#include "kernel_operator.h"
#include "single_pass_tiling.h"
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ != 0) && (__NPU_ARCH__ != 3510)
#error "QSFA single-pass prototype requires compiler-selected dav-3510"
#endif
#if (defined(__DAV_C310_CUBE__) || defined(__DAV_C310_VEC__)) && \
    (!defined(__NPU_ARCH__) || __NPU_ARCH__ != 3510)
#error "Device pass is missing __NPU_ARCH__=3510; do not synthesize SDK macros"
#endif
#ifndef QSFA_SINGLE_PASS_CANDIDATE
#error "Select exactly one original/candidate entry per ASC TU"
#endif

#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 3510
#if QSFA_SINGLE_PASS_CANDIDATE
#include "arch35/kv_quant_sparse_flash_attention_kernel_mla.h"
#else
#include "../../native_c4_source/source/ascendc/kv_quant_sparse_flash_attention/arch35/kv_quant_sparse_flash_attention_kernel_mla.h"
#endif
using namespace AscendC;

__aicore__ inline void QSFA_SINGLE_PASS_RUN(
    __gm__ uint8_t *query, __gm__ uint8_t *cold, __gm__ uint8_t *indices,
    __gm__ uint8_t *table, __gm__ uint8_t *qLengths, __gm__ uint8_t *kvLengths,
    __gm__ uint8_t *hot, __gm__ uint8_t *hotRope, __gm__ uint8_t *tags,
    __gm__ uint8_t *positions, __gm__ uint8_t *output, __gm__ uint8_t *maximum,
    __gm__ uint8_t *sum, __gm__ uint8_t *workspace, __gm__ uint8_t *tiling,
    uint32_t ringCapacity, uint32_t window)
{
#define QSFA_RECENT_TYPES bfloat16_t, int8_t, float, bfloat16_t, false, true, \
    QSFA_LAYOUT::TND, QSFA_LAYOUT::PA_BSND, static_cast<QSFATemplateMode>(1), false
    using Cube = typename std::conditional<g_coreType == AscendC::AIC,
        BaseApi::QSFAMatmulService<QSFA_RECENT_TYPES>,
        BaseApi::QSFAMatmulServiceDummy<QSFA_RECENT_TYPES>>::type;
#if QSFA_SINGLE_PASS_CANDIDATE
    using Vector = typename std::conditional<g_coreType == AscendC::AIC,
        BaseApi::Recent128QSFAVectorServiceDummy<QSFA_RECENT_TYPES>,
        BaseApi::Recent128QSFAVectorService<QSFA_RECENT_TYPES>>::type;
    BaseApi::Recent128KvQuantSparseFlashAttentionMla<Cube, Vector> op;
#else
    using Vector = typename std::conditional<g_coreType == AscendC::AIC,
        BaseApi::QSFAVectorServiceDummy<QSFA_RECENT_TYPES>,
        BaseApi::QSFAVectorService<QSFA_RECENT_TYPES>>::type;
    BaseApi::KvQuantSparseFlashAttentionMla<Cube, Vector> op;
#endif
#undef QSFA_RECENT_TYPES
    TPipe pipe;
#if defined(__DAV_C310_CUBE__)
    const KvQuantSparseFlashAttentionTilingDataMla *local = nullptr;
#else
    KvQuantSparseFlashAttentionTilingDataMla value;
    auto *destination = reinterpret_cast<uint32_t *>(&value);
    const auto *source = reinterpret_cast<__gm__ const uint32_t *>(tiling);
    for (uint32_t i = 0; i < sizeof(value) / sizeof(uint32_t); ++i) destination[i] = source[i];
    const auto *local = &value;
#endif
    // E8M0 scales live in packed400; keyScale/valueScale are not consumed by
    // this source's dSizeVInput==400 branch. MLA key and value alias the cache.
    // Legacy workspace is a one-byte placeholder. The isolated KV-split TU
    // uses its explicitly sized FP32 partial workspace, never vendor scratch.
    op.Init(query, cold, cold, indices, nullptr, nullptr, table, qLengths, kvLengths,
        output, maximum, sum, workspace, local, &pipe);
#if QSFA_SINGLE_PASS_CANDIDATE
    op.InitRecentHot(hot, hotRope, tags, positions, ringCapacity, window);
#endif
    op.Process();
}
#endif

extern "C" __global__ __aicore__ void QSFA_SINGLE_PASS_KERNEL(
    __gm__ uint8_t *query, __gm__ uint8_t *cold, __gm__ uint8_t *indices,
    __gm__ uint8_t *table, __gm__ uint8_t *qLengths, __gm__ uint8_t *kvLengths,
    __gm__ uint8_t *hot, __gm__ uint8_t *hotRope, __gm__ uint8_t *tags,
    __gm__ uint8_t *positions, __gm__ uint8_t *output, __gm__ uint8_t *maximum,
    __gm__ uint8_t *sum, __gm__ uint8_t *workspace, __gm__ uint8_t *tiling,
    uint32_t ringCapacity, uint32_t window)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 3510
    QSFA_SINGLE_PASS_RUN(query, cold, indices, table, qLengths, kvLengths, hot, hotRope,
        tags, positions, output, maximum, sum, workspace, tiling, ringCapacity, window);
#endif
}
