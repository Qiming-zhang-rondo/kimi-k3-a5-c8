// Isolated load micro-tile; unchanged shared 128-key attention pipeline.
#include "single_pass_api.h"
#define QSFA_RECENT_ROUTE_HOT 1
#define QSFA_RECENT_ROUTE_FAST_PAIR 1
#define QSFA_RECENT_LOAD_ROWS 16
#define QSFA_RECENT_INPUT_ROW_BYTES 416
#define QSFA_RECENT_INPUT_BUFFERS 2
#define QSFA_RECENT_OUTPUT_BUFFERS 2
// Helpers need unique symbols too: their NZ stride differs between variants.
#define AntiquantBIMxfp4Tile AntiquantBIMxfp4TileStride416
#define AntiquantVFImplBIMxfp4 AntiquantVFImplBIMxfp4Stride416
#define AntiquantVFImplBIMxfp4Routed AntiquantVFImplBIMxfp4RoutedStride416
#define Recent128QSFAVectorService Recent128LoadStride416VectorService
#define Recent128QSFAVectorServiceDummy Recent128LoadStride416VectorServiceDummy
#define Recent128KvQuantSparseFlashAttentionMla Recent128LoadStride416Attention
#define QSFA_SINGLE_PASS_CANDIDATE 1
#define QSFA_SINGLE_PASS_KERNEL qsfa_recent128_load_Stride416_attention
#define QSFA_SINGLE_PASS_RUN RunQsfaRecent128LoadStride416Attention
#include "single_pass_entry.asc"

extern "C" QSFA_SINGLE_PASS_EXPORT int32_t QsfaSinglePassLaunchLoadStride416(
    void *stream, const SinglePassBuffers *b, uint32_t aicCount,
    uint32_t ringCapacity, uint32_t window)
{
    if (window == 0) {
        return QsfaSinglePassLaunchCold(stream, b, aicCount, ringCapacity, 0);
    }
    if (!b || (aicCount != 1 && aicCount != 2 && aicCount != 4 && aicCount != 8 && aicCount != 16)
        || ringCapacity < 128 || ringCapacity % 128 || window != 128) return -1;
    qsfa_recent128_load_Stride416_attention<<<aicCount, nullptr, stream>>>(
        b->query, b->cold, b->indices, b->blockTable, b->actualQuery, b->actualKv,
        b->hotLatent, b->hotRope, b->ringTags, b->queryPositions, b->output,
        b->maximum, b->sum, b->workspace, b->tiling, ringCapacity, window);
    return 0;
}
