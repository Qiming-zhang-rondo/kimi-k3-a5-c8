// Isolated load micro-tile; unchanged shared 128-key attention pipeline.
#include "single_pass_api.h"
#define QSFA_RECENT_ROUTE_HOT 1
#define QSFA_RECENT_ROUTE_FAST_PAIR 1
#define QSFA_RECENT_LOAD_ROWS 32
#define QSFA_RECENT_INPUT_ROW_BYTES 416
#define QSFA_RECENT_INPUT_BUFFERS 1
#define QSFA_RECENT_OUTPUT_BUFFERS 1
// Helpers need unique symbols too: their NZ stride differs between variants.
#define AntiquantBIMxfp4Tile AntiquantBIMxfp4TileTile32In1
#define AntiquantVFImplBIMxfp4 AntiquantVFImplBIMxfp4Tile32In1
#define AntiquantVFImplBIMxfp4Routed AntiquantVFImplBIMxfp4RoutedTile32In1
#define Recent128QSFAVectorService Recent128LoadTile32In1VectorService
#define Recent128QSFAVectorServiceDummy Recent128LoadTile32In1VectorServiceDummy
#define Recent128KvQuantSparseFlashAttentionMla Recent128LoadTile32In1Attention
#define QSFA_SINGLE_PASS_CANDIDATE 1
#define QSFA_SINGLE_PASS_KERNEL qsfa_recent128_load_Tile32In1_attention
#define QSFA_SINGLE_PASS_RUN RunQsfaRecent128LoadTile32In1Attention
#include "single_pass_entry.asc"

extern "C" QSFA_SINGLE_PASS_EXPORT int32_t QsfaSinglePassLaunchLoadTile32In1(
    void *stream, const SinglePassBuffers *b, uint32_t aicCount,
    uint32_t ringCapacity, uint32_t window)
{
    if (window == 0) {
        return QsfaSinglePassLaunchCold(stream, b, aicCount, ringCapacity, 0);
    }
    if (!b || (aicCount != 1 && aicCount != 2 && aicCount != 4 && aicCount != 8 && aicCount != 16)
        || ringCapacity < 128 || ringCapacity % 128 || window != 128) return -1;
    qsfa_recent128_load_Tile32In1_attention<<<aicCount, nullptr, stream>>>(
        b->query, b->cold, b->indices, b->blockTable, b->actualQuery, b->actualKv,
        b->hotLatent, b->hotRope, b->ringTags, b->queryPositions, b->output,
        b->maximum, b->sum, b->workspace, b->tiling, ringCapacity, window);
    return 0;
}
