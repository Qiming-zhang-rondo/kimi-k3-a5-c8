#include "single_pass_api.h"
#define QSFA_SINGLE_PASS_CANDIDATE 0
#define QSFA_SINGLE_PASS_KERNEL qsfa_original_c4_control
#define QSFA_SINGLE_PASS_RUN RunQsfaOriginalC4Control
#include "single_pass_entry.asc"

extern "C" QSFA_SINGLE_PASS_EXPORT int32_t QsfaSinglePassLaunchCold(
    void *stream, const SinglePassBuffers *b, uint32_t aicCount,
    uint32_t ringCapacity, uint32_t window)
{
    if (!b || (aicCount != 1 && aicCount != 2 && aicCount != 4 && aicCount != 8 && aicCount != 16)) return -1;
    qsfa_original_c4_control<<<aicCount, nullptr, stream>>>(
        b->query, b->cold, b->indices, b->blockTable, b->actualQuery, b->actualKv,
        b->hotLatent, b->hotRope, b->ringTags, b->queryPositions, b->output,
        b->maximum, b->sum, b->workspace, b->tiling, ringCapacity, 0);
    return 0;
}
