// Additive multi-request TND entry; legacy entries retain their old ABI/code.
#include "batched_serving_api.h"
#define QSFA_RECENT_BATCHED 1
#define QSFA_RECENT_ROUTE_HOT 1
#define QSFA_RECENT_ROUTE_FAST_PAIR 1
#define QSFA_RECENT_LOAD_ROWS 32
#define QSFA_RECENT_INPUT_ROW_BYTES 416
#define QSFA_RECENT_INPUT_BUFFERS 2
#define QSFA_RECENT_OUTPUT_BUFFERS 1
#define AntiquantBIMxfp4Tile AntiquantBIMxfp4TileServing
#define AntiquantVFImplBIMxfp4 AntiquantVFImplBIMxfp4Serving
#define AntiquantVFImplBIMxfp4Routed AntiquantVFImplBIMxfp4RoutedServing
#define Recent128QSFAVectorService Recent128ServingVectorService
#define Recent128QSFAVectorServiceDummy Recent128ServingVectorServiceDummy
#define Recent128KvQuantSparseFlashAttentionMla Recent128ServingAttention
#include "kernel_operator.h"
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ != 0) && (__NPU_ARCH__ != 3510)
#error "Batched serving requires compiler-selected dav-3510"
#endif
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 3510
#include "arch35/kv_quant_sparse_flash_attention_kernel_mla.h"
using namespace AscendC;
#endif

extern "C" __global__ __aicore__ void qsfa_recent128_batched_serving(
    GM_ADDR query,GM_ADDR cold,GM_ADDR indices,GM_ADDR table,GM_ADDR qLengths,
    GM_ADDR kvLengths,GM_ADDR hot,GM_ADDR hotRope,GM_ADDR tags,GM_ADDR positions,
    GM_ADDR output,GM_ADDR maximum,GM_ADDR sum,GM_ADDR workspace,GM_ADDR tiling,
    GM_ADDR banks,GM_ADDR epochs,GM_ADDR ringEpochs,GM_ADDR valid,GM_ADDR faults,
    uint32_t capacity,uint32_t pools,uint32_t queries)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 3510
#define SERVING_TYPES bfloat16_t,int8_t,float,bfloat16_t,false,true, \
    QSFA_LAYOUT::TND,QSFA_LAYOUT::PA_BSND,static_cast<QSFATemplateMode>(1),false
    using Cube=typename std::conditional<g_coreType==AscendC::AIC,
        BaseApi::QSFAMatmulService<SERVING_TYPES>,BaseApi::QSFAMatmulServiceDummy<SERVING_TYPES>>::type;
    using Vector=typename std::conditional<g_coreType==AscendC::AIC,
        BaseApi::Recent128ServingVectorServiceDummy<SERVING_TYPES>,
        BaseApi::Recent128ServingVectorService<SERVING_TYPES>>::type;
    BaseApi::Recent128ServingAttention<Cube,Vector> op;
#undef SERVING_TYPES
    TPipe pipe;
#if defined(__DAV_C310_CUBE__)
    const KvQuantSparseFlashAttentionTilingDataMla *local=nullptr;
#else
    KvQuantSparseFlashAttentionTilingDataMla value;
    auto *dst=reinterpret_cast<uint32_t*>(&value);
    const auto *src=reinterpret_cast<__gm__ const uint32_t*>(tiling);
    for(uint32_t i=0;i<sizeof(value)/sizeof(uint32_t);++i)dst[i]=src[i];
    const auto *local=&value;
#endif
    op.Init(query,cold,cold,indices,nullptr,nullptr,table,qLengths,kvLengths,
        output,maximum,sum,workspace,local,&pipe);
    op.InitRecentHot(hot,hotRope,tags,positions,capacity,128);
    op.InitServingBatch(banks,epochs,ringEpochs,valid,faults,pools,queries);
    op.Process();
#endif
}

extern "C" QSFA_SINGLE_PASS_EXPORT uint32_t QsfaBatchedServingAbiVersion(){return 1;}
extern "C" QSFA_SINGLE_PASS_EXPORT uint32_t QsfaBatchedServingBuffersBytes(){return sizeof(BatchedServingBuffers);}
extern "C" QSFA_SINGLE_PASS_EXPORT int32_t QsfaBatchedServingLaunch(
    void *stream,const BatchedServingBuffers *s,uint32_t aic,uint32_t capacity,
    uint32_t pools,uint32_t queries)
{
    if(!s || !aic || aic>16 || !queries || aic>queries || !pools || capacity<128 ||
       capacity%128 || !s->requestBanks || !s->requestEpochs || !s->ringEpochs ||
       !s->queryValid || !s->faults) return -1;
    const auto &b=s->base;
    if(!b.query || !b.cold || !b.indices || !b.blockTable || !b.actualQuery ||
       !b.actualKv || !b.hotLatent || !b.hotRope || !b.ringTags ||
       !b.queryPositions || !b.output || !b.tiling || !b.workspace)return -1;
    qsfa_recent128_batched_serving<<<aic,nullptr,stream>>>(b.query,b.cold,b.indices,
        b.blockTable,b.actualQuery,b.actualKv,b.hotLatent,b.hotRope,b.ringTags,
        b.queryPositions,b.output,b.maximum,b.sum,b.workspace,b.tiling,
        s->requestBanks,s->requestEpochs,s->ringEpochs,s->queryValid,s->faults,
        capacity,pools,queries);
    return 0;
}
