#include "single_pass_api.h"
#define QSFA_SINGLE_PASS_CANDIDATE 1
#define QSFA_SINGLE_PASS_KERNEL qsfa_recent128_single_attention
#define QSFA_SINGLE_PASS_RUN RunQsfaRecent128SingleAttention
#include "single_pass_entry.asc"

extern "C" QSFA_SINGLE_PASS_EXPORT uint32_t QsfaSinglePassAbiVersion(void) { return 1; }
extern "C" QSFA_SINGLE_PASS_EXPORT uint32_t QsfaSinglePassBuffersBytes(void)
{
    static_assert(sizeof(SinglePassBuffers) == 15 * sizeof(uint8_t *));
    return sizeof(SinglePassBuffers);
}

extern "C" QSFA_SINGLE_PASS_EXPORT int32_t QsfaSinglePassLaunch(
    void *stream, const SinglePassBuffers *b, uint32_t aicCount,
    uint32_t ringCapacity, uint32_t window)
{
    // W0 is the unchanged native C4 entry, with no recent-token map or hot
    // branch resources. Keep original_c4_direct separately as an explicit
    // control; report this route rather than hiding it as candidate work.
    if (window == 0) {
        return QsfaSinglePassLaunchCold(stream, b, aicCount, ringCapacity, 0);
    }
    if (!b || (aicCount != 1 && aicCount != 2 && aicCount != 4 && aicCount != 8 && aicCount != 16)
        || ringCapacity < 128 || ringCapacity % 128 || (window != 0 && window != 128)) return -1;
    qsfa_recent128_single_attention<<<aicCount, nullptr, stream>>>(
        b->query, b->cold, b->indices, b->blockTable, b->actualQuery, b->actualKv,
        b->hotLatent, b->hotRope, b->ringTags, b->queryPositions, b->output,
        b->maximum, b->sum, b->workspace, b->tiling, ringCapacity, window);
    return 0;
}
