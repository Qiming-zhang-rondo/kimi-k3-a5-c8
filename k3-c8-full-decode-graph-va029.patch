+def _state(capacity=4, max_seq_len=48, table_width=3):
+    return graph.KimiK3C8DecodeState(capacity, max_seq_len, table_width, torch.device("cpu"))
+
+
+def _buffers(state):
+    return {name: value for name, value in vars(state).items() if isinstance(value, torch.Tensor)}
+
+
+def _snapshot(state):
+    return {name: tensor.clone() for name, tensor in _buffers(state).items()}
+
+
+def _assert_snapshot(state, snapshot):
+    for name, expected in snapshot.items():
+        torch.testing.assert_close(getattr(state, name), expected)
+
+
+def _cache(blocks=6, block_size=16):
+    """Construct valid group128 payload independently of the production packer."""
+    generator = torch.Generator().manual_seed(17)
+    latent = torch.randn(blocks, block_size, 1, 4, 128, generator=generator).bfloat16().float()
+    latent *= torch.tensor([0.125, 0.5, 2.0, 8.0]).view(1, 1, 1, 4, 1)
+    scales = latent.abs().amax(dim=-1).clamp_min(1e-12) / torch.finfo(torch.float8_e4m3fn).max
+    quantized = (latent / scales[..., None]).flatten(-2).to(torch.float8_e4m3fn)
+    raw = torch.randn(blocks, block_size, 1, 64, generator=generator).bfloat16()
+    return torch.cat((quantized.view(torch.uint8), raw.view(torch.uint8), scales.view(torch.uint8)), dim=-1).view(
+        torch.float8_e4m3fn
+    )
+
+
+def _dequantize(packed):
+    scales = packed[..., 640:].contiguous().view(torch.float32)
+    latent = (packed[..., :512].float() * scales.repeat_interleave(128, dim=-1)).bfloat16().float()
+    raw = packed[..., 512:640].contiguous().view(torch.bfloat16).float()
+    return latent, raw
+
+
+def _native_reference(query, key, value, indices, scale, **kwargs):
+    """Mock the device interface, including unwritten zero-length rows."""
+    assert key is value
+    assert query.is_contiguous() and query.dtype == torch.bfloat16
+    assert indices.is_contiguous() and indices.dtype == torch.int32
+    assert kwargs["layout_query"] == "TND" and kwargs["layout_kv"] == "PA_BSND"
+    assert kwargs["key_quant_mode"] == kwargs["value_quant_mode"] == kwargs["attention_mode"] == 2
+    assert kwargs["sparse_block_size"] == 1 and kwargs["sparse_mode"] == 3
+    assert kwargs["quant_scale_repo_mode"] == 1 and kwargs["tile_size"] == 128
+    assert kwargs["rope_head_dim"] == 64 and kwargs["return_softmax_lse"] is False
+    assert kwargs["actual_seq_lengths_query"].dtype == torch.int32
+    assert kwargs["actual_seq_lengths_kv"].dtype == torch.int32
+    sinks = kwargs["sinks"]
+    assert sinks.dtype == torch.float32 and sinks.shape == (query.shape[1],)
+    assert torch.isneginf(sinks).all()
+    output = torch.full((*query.shape[:2], 512), float("nan"), dtype=query.dtype)
+    start = 0
+    for batch, end in enumerate(kwargs["actual_seq_lengths_query"].tolist()):
+        length = int(kwargs["actual_seq_lengths_kv"][batch])
+        for row in range(start, end):
+            if length == 0:
+                continue
+            visible = length - (end - start) + row - start + 1
+            selected = indices[row, 0]
+            selected = selected[(selected >= 0) & (selected < visible)].long()
+            pages = kwargs["block_table"][batch, selected // key.shape[1]].long()
+            latent, raw = _dequantize(key[pages, selected % key.shape[1], 0])
+            scores = query[row].float() @ torch.cat((latent, raw), dim=-1).T * scale
+            probabilities = torch.softmax(torch.cat((scores, sinks[:, None]), dim=-1), dim=-1)[:, :-1]
+            output[row] = probabilities @ latent
+        start = end
+    return output, torch.empty(0), torch.empty(0)
+
+
+def _expected(query, cache, table, lengths, capacity):
+    """Dense all-KV reference that does not read the generated sparse indices."""
+    expected = torch.zeros(capacity, query.shape[1], 512, dtype=torch.bfloat16)
+    for batch, length in enumerate(lengths):
+        positions = torch.arange(length)
+        packed = cache[table[batch, positions // cache.shape[1]].long(), positions % cache.shape[1], 0]
+        latent, raw = _dequantize(packed)
+        scores = query[batch].float() @ torch.cat((latent, raw), dim=-1).T * (192**-0.5)
+        expected[batch] = torch.softmax(scores, dim=-1) @ latent
+    return expected
+
