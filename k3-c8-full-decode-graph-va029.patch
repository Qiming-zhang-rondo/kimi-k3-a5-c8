+            "raw_query": torch.empty((capacity, heads, native.RAW_DIM), dtype=torch.bfloat16, device=cache.device),
+            "latent": torch.empty((capacity, 1, native.LATENT_DIM), dtype=torch.bfloat16, device=cache.device),
+            "raw": torch.empty((capacity, 1, native.RAW_DIM), dtype=torch.bfloat16, device=cache.device),
