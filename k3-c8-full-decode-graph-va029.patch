+        patch.object(graph_utils, "set_current_vllm_config", return_value=nullcontext()),
+        patch.object(graph_utils, "_get_graph_update_backend", return_value=backend),
+        patch.object(graph_utils, "use_updatable_graph", return_value=updatable),
