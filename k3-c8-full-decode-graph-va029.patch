+        assert addresses == {
+            name: (value.data_ptr(), value.stride(), value.shape) for name, value in _buffers(state).items()
+        }
+        assert state.seq_lens.tolist() == [*lengths, *([0] * (4 - n))]
+        assert state.slots.tolist() == [*slots.tolist(), *([-1] * (4 - n))]
+        assert state.active.tolist() == [*([True] * n), *([False] * (4 - n))]
+        assert state.query_ends.tolist() == [1, 2, 3, 4]
+        assert torch.count_nonzero(state.block_table[n:]) == 0
+        assert torch.count_nonzero(state.block_table[:, 2:]) == 0
+        torch.testing.assert_close(state.block_table[:n, :2], table)
+        for row in range(4):
+            length = lengths[row] if row < n else 0
+            expected = torch.full((48,), -1, dtype=torch.int32)
+            expected[:length] = torch.arange(length, dtype=torch.int32)
+            torch.testing.assert_close(state.indices[row, 0], expected)
+            torch.testing.assert_close(state.invalid_indices[row, 0], expected == -1)
