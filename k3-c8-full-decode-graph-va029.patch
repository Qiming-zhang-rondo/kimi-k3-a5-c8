+        buckets[capacity] = buffers
+    assert len({item["state"].seq_lens.data_ptr() for item in buckets.values()}) == len(GRAPH_BUCKETS)
+    # Shared graph pools may reuse output storage between buckets. Require
+    # each captured output's address to remain fixed, not globally distinct.
+
+    # Initialize each request's first 126 tokens once. No cache reset or
+    # re-prefill is allowed during the actual bucket-switch replay sequence.
+    _prepare_bucket_replay(buckets[max(GRAPH_BUCKETS)], 0, (127,) * max(GRAPH_BUCKETS), backing, cache)
+    first_b4_output = None
+    graph_written_history = {}
+    for phase, (capacity, lengths) in enumerate((*BUCKET_REPLAYS, (4, ()))):
+        buffers = buckets[capacity]
