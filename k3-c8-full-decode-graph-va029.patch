+    for lengths in ([1, 17, 33, 48], [16], [], [5, 32]):
+        n = len(lengths)
+        table = torch.arange(n * 2, dtype=torch.int32).reshape(n, 2)
+        slots = torch.arange(n, dtype=slot_dtype) + 19
