+@torch.inference_mode()
+def test_kimi_k3_c8_single_token_has_no_attention_sink():
+    # With one zero-logit key, attention must return V. The CANN wrapper's
+    # default zero sink would instead halve it, exposing a numerical API trap.
+    latent = torch.ones(1, 1, LATENT_DIM, dtype=torch.bfloat16, device="npu")
+    raw = torch.zeros(1, 1, RAW_DIM, dtype=torch.bfloat16, device="npu")
+    packed = pack_kimi_k3_sfa_c8(latent, raw)
+    cache = torch.empty((1, PAGE_SIZE, 1, PACKED_DIM), dtype=torch.float8_e4m3fn, device="npu")
+    scatter_kimi_k3_sfa_c8(packed, torch.zeros(1, dtype=torch.int64, device="npu"), cache)
+    output = kimi_k3_sfa_c8_attention(
+        torch.zeros((1, 2, LATENT_DIM), dtype=torch.bfloat16, device="npu"),
+        torch.zeros((1, 2, RAW_DIM), dtype=torch.bfloat16, device="npu"),
+        cache,
+        torch.zeros((1, 1), dtype=torch.int32, device="npu"),
+        [0, 1],
+        [1],
+        ATTENTION_SCALE,
+    )
+    expected = _unpack_cpu(packed)[0].expand(1, 2, LATENT_DIM).float()
+    torch.testing.assert_close(output.float().cpu(), expected, atol=SAME_CACHE_ATOL, rtol=SAME_CACHE_RTOL)
