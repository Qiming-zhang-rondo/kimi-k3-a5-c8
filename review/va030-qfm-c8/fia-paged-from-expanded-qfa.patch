+qfm = base.qfm
+BLOCK = 128
+FP8_PAGE = BLOCK * 576
+NOPE_PAGE = BLOCK * 512 * 2
+RAW_PAGE = BLOCK * 64 * 2
+ROOT = Path(__file__).resolve().parents[3]
+
