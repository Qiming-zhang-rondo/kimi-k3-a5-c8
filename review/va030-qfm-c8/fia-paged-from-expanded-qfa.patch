+        SimpleNamespace(
+            size=common_backing_bytes,
+            layers=["state"],
+            offset=0,
+            layer_stride=layer_bytes,
+            block_stride=spec.page_size_bytes,
+        ),
+    ]
+    config = SimpleNamespace(
