+    assert raw.untyped_storage().data_ptr() != storage.cache.untyped_storage().data_ptr()
+    assert nope.data_ptr() - storage.parts[0].backing.data_ptr() == offset
+    assert raw.data_ptr() - storage.parts[1].backing.data_ptr() == offset
