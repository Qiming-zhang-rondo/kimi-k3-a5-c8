+    def _apply_fia_paged_memory_budget(self, available_memory: int) -> int:
+        """Reserve private BF16 histories without changing shared block layout.
+
+        The main pool keeps the upstream overlay contract. Its planner charges
+        the largest group's bytes per block; the BF16 mirrors are independent
+        dense pools, charged once for every opted-in layer and manager block.
+        Scaling the advertised main-pool budget makes the derived block count
+        cover both allocations, including the explicit KV-memory fast path.
+        """
+        layer_specs = self.get_kv_cache_spec()
+        if not isinstance(layer_specs, dict):
+            return available_memory
+        opted_specs = [spec for spec in layer_specs.values() if getattr(spec, "cache_qfm_bf16_prefill", False)]
+        if not opted_specs:
+            return available_memory
+        if getattr(self.cache_config, "num_gpu_blocks_override", None) is not None:
+            raise ValueError(
+                "fia_paged cannot use num_gpu_blocks_override: it bypasses the shared-pool plus BF16-history "
+                "memory budget; use gpu_memory_utilization or kv_cache_memory_bytes instead"
+            )
+        groups = get_kv_cache_groups(self.vllm_config, layer_specs)
+        base_bytes = 0
+        extra_bytes = 0
+        for group in groups:
+            spec = group.kv_cache_spec
+            group_specs = [
+                spec.kv_cache_specs[name] if isinstance(spec, UniformTypeKVCacheSpecs) else spec
+                for name in group.layer_names
+            ]
+            base_bytes = max(base_bytes, sum(spec.page_size_bytes for spec in group_specs))
+            # Group formation can promote a layer's manager block size. The
+            # allocator uses that derived geometry, so charge its BF16 pages
+            # rather than the smaller pre-grouping checkpoint specification.
+            extra_bytes += sum(
+                spec.bf16_prefill_page_size_bytes
+                for spec in group_specs
+                if getattr(spec, "cache_qfm_bf16_prefill", False)
+            )
+        if base_bytes <= 0 or extra_bytes <= 0:
+            raise ValueError("fia_paged requires positive shared-pool and BF16-history page budgets")
+        main_budget = available_memory * base_bytes // (base_bytes + extra_bytes)
+        logger.info(
+            "Paged FIA reserves BF16 history: shared_pool=%d BF16_history=%d bytes per manager block; "
+            "main-pool budget=%d of %d bytes.",
+            base_bytes,
+            extra_bytes,
+            main_budget,
+            available_memory,
+        )
+        return main_budget
 
