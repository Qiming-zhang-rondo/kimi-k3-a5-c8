_lse\n            else:\n                total_lse = torch.logaddexp(golden_lse, chunk_lse)\n                left = torch.nan_to_num((golden_lse - total_lse).exp(), nan=0.0)\n                right = torch.nan_to_num((chunk_lse - total_lse).exp(), nan=0.0)\n                golden = golden * left[..., None] + chunk_output * right[..., None]\n                golden_lse = total_lse\n        check(\n            torch,\n            name + "_FIA_vs_independent_FP32_reference",\n            actual.cpu()[sample_rows],\n            golden,\n            atol=0.02,\n            rtol=0.025,\n            l2_limit=0.012,\n        )\n        check(\n            torch,\n            name + "_natural_log_LSE",\n            actual_lse.cpu()[sample_rows, :, 0],\n            golden_lse,\n            atol=0.008,\n            rtol=0.002,\n            l2_limit=0.002,\n        )\n        del full, key_nope, values, keys, scores\n    emit(\n        "reference_scope",\n        sampled_rows=len(sample_rows),\n        query_rows=args.queries,\n        exhaustive=len(sample_rows) == args.queries,\n        persistent_cache="FP8 full576, unit descale",\n        current_chunk_attention="BF16 before FP8 roundtrip",\n        true_distributed=False,\n        graph=False,\n    )\n\n    # Check complete backing bytes against physical offset/page/slot layout.\n    before_reader = storage.cpu()\n    expected = torch.full_like(before_reader, guard)\n    final_result = results[args.frontend[-1]]\n    packed = (\n        torch.cat((history, final_result[1]))\n        .cpu()\n        .float()\n        .clamp(-448, 448)\n        .to(torch.float8_e4m3fn)\n        .view(torch.uint8)\n    )\n    slot_cpu = all_slots.cpu()\n    expected_view = torch.as_strided(\n        expected[offset:-offset], (pages, 18, 128, 32), (stride, 4096, 32, 1)\n    )\n    expected_view[\n        slot_cpu[:, None] // 128, torch.arange(18)[None, :], slot_cpu[:, None] % 128, :\n    ] = packed.reshape(total_rows, 18, 32)\n    if not torch.e