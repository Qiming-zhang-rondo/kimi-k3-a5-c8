+        "log": str(logfile),
+        "directory": str(directory),
+        "benchmark": args.benchmark,
+    }
+    (directory / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+    emit("summary", **summary)
+    return 0 if passed else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
