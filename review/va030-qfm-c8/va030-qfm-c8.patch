+def sidecar_spec(spec_type, manager=128, padding=0):
+    return spec_type(
+        block_size=manager,
+        num_kv_heads=1,
+        head_size=576,
+        dtype=torch.float8_e4m3fn,
+        cache_qfm_c8=True,
+        cache_qfm_bf16_prefill=True,
