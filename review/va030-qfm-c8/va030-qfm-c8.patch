+    spec.bf16_prefill_page_size_bytes = extra_page
+    method, worker, _ = load_budget({"mla": spec}, [SimpleNamespace(kv_cache_spec=spec, layer_names=["mla"])])
+    with pytest.raises(ValueError, match="positive"):
+        method(worker, 2**30)
