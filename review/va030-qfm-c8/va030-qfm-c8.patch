ed.detach().float().cpu()\n    finite = bool(torch.isfinite(a).all() and torch.isfinite(b).all())\n    result = {\n        "finite": finite,\n        "relative_l2": float(\n            (a.double() - b.double()).norm() / b.double().norm().clamp_min(1e-12)\n        )\n        if finite\n        else None,\n        "max_abs": float((a - b).abs().max()) if finite and a.numel() else 0.0,\n        "elements": a.numel(),\n    }\n    emit("numerical_report", name=name, **result)\n    return result\n\n\ndef record_qfa_reference(torch, adapter, golden, sample_rows):\n    """Collect actual encoded native inputs only during untimed correctness."""\n    state = SimpleNamespace(enabled=True, parts=[], encoded=None)\n    real_quantize, real_partial = adapter.quantize_kv, adapter.partial\n\n    def factor(scales):\n        codes = scales.detach().view(torch.uint8).cpu()\n        if bool((codes == 255).any()):\n            raise AssertionError("QFA descales contain NaN E8M0 codes")\n        return torch.pow(2.0, codes.float() - 127.0)\n\n    def quantize(key, value):\n        result = real_quantize(key, value)\n        if state.enabled:\n            state.encoded = result\n        return result\n\n    def partial(prepared, key, value, scale, mask=None, *, metadata_cache=None):\n        result = real_partial(\n            prepared, key, value, scale, mask, metadata_cache=metadata_cache\n        )\n        if not state.enabled:\n            return result\n        k8, v8, ks, vs = state.encoded\n        q8 = (\n            prepared.values.view(torch.uint8)\n            .detach()\n            .cpu()[sample_rows]\n            .view(torch.float8_e4m3fn)\n        )\n        k8 = k8.view(torch.uint8).detach().cpu().view(torch.float8_e4m3fn)\n        v8 = v8.view(torch.uint8).detach().cpu().view(torch.float8_e4m3fn)\n        heads, tokens = key.shape[1], key.shape[0]\n        q_scale = factor(prepared.descales)[sample_rows].reshape(\n            len(sample_rows), heads, 8\n        )\n        k_scale = factor(ks).reshape(tokens, heads, 8)\n        v_scale = factor(vs).permute(1, 0, 3, 2).reshape(heads, -1, 256)\n        if bool(\n            (q8[:, :, 192:].view(torch.uint8) != 0).any()\n            or (k8[:, :, 192:].view(torch.uint8) != 0).any()\n            or (v8[:, :, 128:].view(torch.uint8) != 0).any()\n        ):\n            raise AssertionError("QFA zero padding changed encoded data")\n        if tuple(vs.shape) != ((tokens + 63) // 64, heads, 256, 2):\n            raise AssertionError("QFA V token-axis Group32 scale shape mismatch")\n        q_float = q8.float() * q_scale.repeat_interleave(32, -1)\n        k_float = k8.float() * k_scale.repeat_interleave(32, -1)\n        v_float = v8.float() * v_scale.repeat_interleave(32, 1)[:, :tokens].permute(\n            1, 0, 2\n        )\n        if not all(\n            bool(torch.isfinite(tensor).all()) for tensor in (q_float, k_float, v_float)\n        ):\n            raise AssertionError(\n                "QFA actual encoded inputs do not decode to finite values"\n            )\n        scores = torch.einsum("thd,khd->thk", q_float, k_float) * scale\n        causal = (\n            torch.arange(tokens)[None, :]\n            > (sample_rows + tokens - prepared.values.shape[0])[:, None]\n        )\n        if mask is not None:\n            scores.masked_fill_(causal[:, None], -float("inf"))\n        fp32_output = torch.einsum(\n            "thk,khv->thv", torch.nan_to_num(scores.softmax(-1), nan=0.0), v_float\n        )\n        fp32_lse = scores.logsumexp(-1).unsqueeze(-1)\n\n        # Original pure arithmetic functions from the pinned official golden.\n        # Injecting a sampling mask keeps the ORIGINAL query-token positions;\n        # simply shortening actual_seq_q would give the wrong causal offset.\n        def sampling_mask(batch, sq, sk, query_lengths, key_lengths, sparse_mode):\n            if mask is None:\n                return torch.zeros((1, 1, len(sample_rows), tokens), dtype=torch.bool)\n            return causal[None, None]\n\n        golden._build_attention_mask = sampling_mask\n        golden.D, golden.N_q, golden.N_kv = 256, heads, heads\n        golden.SPARSE_MODE = 3 if mask is not None else 0\n        encoded_output, encoded_lse = golden.cpu_mxfp8_golden(\n            q8.permute(1, 0, 2).unsqueeze(0),\n            k8.permute(1, 0, 2).unsqueeze(0),\n            v8.permute(1, 0, 2).unsqueeze(0),\n            q_scale.permute(1, 0, 2).unsqueeze(0),\n            k_scale.permute(1, 0, 2).unsqueeze(0),\n            v_scale.unsqueeze(0),\n            1.0,\n            [len(sample_rows)],\n            [tokens],\n            softmax_scale=scale,\n        )\n        state.parts.append(\n            (\n                (\n                    encoded_output[0]\n                    .transpose(0, 1)[:, :, :128]\n                    .to(torch.bfloat16)\n                    .float(),\n                    encoded_lse[0].transpose(0, 1),\n                ),\n                (fp32_output[:, :, :128], fp32_lse),\n            )\n        )\n        state.encoded = None\n        return result\n\n    def restore():\n        state.enabled = False\n        adapter.quantize_kv, adapter.partial = real_quantize, real_partial\n\n    adapter.quantize_kv, adapter.partial = quantize, partial\n    state.restore = restore\n    return state\n\n\ndef combine_reference_parts(torch, parts, kind):\n    result = None\n    for item in parts:\n        output, lse = item[kind]\n        if result is None:\n            result = output, lse\n            continue\n        previous, previous_lse = result\n        total = torch.logaddexp(previous_lse, lse)\n        left = torch.nan_to_num((previous_lse - total).exp(), nan=0.0)\n        right = torch.nan_to_num((lse - total).exp(), nan=0.0)\n        result = previous * left + output * right, total\n    return result\n\n\ndef check_official_qfa(torch, golden, name, actual, expected):\n    """Keep actual BF16 output dtype so the pinned comparator selects BF16."""\n    finite = bool(\n        torch.isfinite(actual.float()).all() and torch.isfinite(expected.float()).all()\n    )\n    status, percent, max_error = golden.check_result(expected, actual)\n    passed = finite and status == "Pass"\n    emit(\n        "official_qfa_check",\n        name=name,\n        pass_=passed,\n        finite=finite,\n        coverage_percent=percent,\n        normalized_max_error=max_error,\n        standard="v9.2.0 official dtype-specific comparator; >=99.5% close; extreme error<10",\n        actual_dtype=str(actual.dtype),\n        source_revision=golden.SOURCE_REVISION,\n    )\n    return passed\n\n\ndef run(args, modules):\n    import torch\n    import torch_npu\n\n    torch.npu.set_device(0)\n    torch.manual_seed(607)\n    core, expanded_module, native_module = (\n        modules[k] for k in ("qfm", "expanded", "native")\n    )\n    hidden_size, q_rank, heads = args.hidden, args.q_rank, args.heads\n    device = "npu:0"\n\n    class MXFP8:\n        group_size = 32\n        dynamic_mx_quant_scale_alg = 0\n\n    # Only the type marker is isolated. All quantization, GEMM, norm, Scatter,\n    # native Prolog and FIA operations below are the installed NPU operators.\n    sys.modules["vllm_ascend.quantization.methods.w8a8.w8a8_mxfp8"] = SimpleNamespace(\n        AscendW8A8MXFP8DynamicLinearMethod=MXFP8\n    )\n\n    def mx_quant(tensor):\n        return torch_npu.npu_dynamic_mx_quant(\n            tensor.contiguous(), dst_type=torch.float8_e4m3fn, scale_alg=0\n        )\n\n    def decode(encoded, scales):\n        values = encoded.detach().float().cpu()\n        codes = scales.detach().view(torch.uint8).cpu().reshape(values.shape[0], -1)\n        factor = torch.pow(2.0, codes.float() - 127.0).repeat_interleave(32, dim=-1)\n        return values * factor[:, : values.shape[1]]\n\n    class Projection:\n        bias = None\n        _mxfp8_transformed = True\n\n        def __init__(self, inputs, outputs):\n            self.input_size = inputs\n            self.quant_method = SimpleNamespace(quant_method=MXFP8())\n            source = (\n                (torch.randn(outputs, inputs, device="cpu") / math.sqrt(inputs))\n                .bfloat16()\n                .to(device)\n            )\n            quantized, scales = mx_quant(source)\n            self.reference = decode(quantized, scales)\n            self.weight = torch_npu.npu_format_cast(quantized.T.contiguous(), 29)\n            self.weight_scale = (\n                scales.view(torch.uint8)\n                .reshape(outputs, inputs // 64, 2)\n                .transpose(0, 1)\n                .contiguous()\n            )\n\n        def __call__(self, value):\n            x, scale = mx_quant(value)\n            result = torch_npu.npu_quant_matmul(\n                x,\n                self.weight,\n                self.weight_scale,\n                scale_dtype=torch_npu.float8_e8m0fnu,\n                pertoken_scale=scale,\n                pertoken_scale_dtype=torch_npu.float8_e8m0fnu,\n                output_dtype=torch.bfloat16,\n                group_sizes=[1, 1, 32],\n            )\n            return result, None\n\n    class Norm:\n        variance_epsilon = 1e-6\n        bias_loaded = False\n        bias = None\n\n        def __init__(self, width):\n            self.weight = torch.ones(width, dtype=torch.bfloat16, device=device)\n\n        def __call__(self, value):\n            return torch_npu.npu_rms_norm(\n                value.contiguous(), self.weight, epsilon=self.variance_epsilon\n            )[0]\n\n    emit(\n        "stage",\n        name="prepare_synthetic_real_geometry",\n        hidden=hidden_size,\n        q_rank=q_rank,\n        heads=heads,\n    )\n    impl = SimpleNamespace(\n        use_mla_rope=False,\n        q_lora_rank=q_rank,\n        kv_lora_rank=512,\n        qk_nope_head_dim=128,\n        qk_rope_head_dim=64,\n        qk_head_dim=192,\n        v_head_dim=128,\n        num_heads=heads,\n        q_a_