+        if not all(torch.equal(backing.cpu(), wanted) for backing, wanted in zip(backings, expected)):
+            raise AssertionError("Native writer bytes, invalid-slot handling or guards differ from independent oracle")
+
+    if history:
+        write(0, history, padded=True)
+    return SimpleNamespace(
+        backings=backings,
+        expected=expected,
+        cache=cache,
+        table=table,
+        table_cpu=table_cpu,
+        slots=slots,
+        slots_cpu=slots_cpu,
+        keys=keys,
+        keys_cpu=keys_cpu,
+        adapter=adapter,
+        write=write,
+        mask=mask,
+        scale=scale,
+        heads=heads,
+        blocks=blocks,
+        offset=offset,
+        stride=stride,
+    )
+
