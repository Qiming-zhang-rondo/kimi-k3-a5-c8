+                assert (target.view(torch.uint8)[physical * ratio + k] == expected).all()
+        assert (target_raw[:512] == 77).all()
+        for page in range(2 * ratio):
+            start = 512 + page * (73728 + 512) + 73728
+            assert (target_raw[start : start + 512] == 77).all()
