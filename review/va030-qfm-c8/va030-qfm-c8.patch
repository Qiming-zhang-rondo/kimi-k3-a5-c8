+        _mxfp8_transformed=True,
+        weight=torch.full((inputs, outputs), 0x32, dtype=torch.uint8, device=device).view(torch.float8_e4m3fn),
+        weight_scale=torch.full((inputs // 64, outputs, 2), 120, dtype=torch.uint8, device=device),
