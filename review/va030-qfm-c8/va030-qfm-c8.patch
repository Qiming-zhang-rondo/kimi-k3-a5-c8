n    """\n    tokens = batch.slots.numel()\n    segments = batch.preprocess_segments\n    if not segments:\n        raise ValueError("Missing scheduler stage ranges for Prefill MLAPO routing")\n    if len(segments) == 1 and segments[0] == (0, tokens, True):\n        q, kv = ordinary_qfm_inputs(impl, hidden, tokens)\n        write_cache(kv, batch.slots, cache, impl.qfm_scale, scatter_plan=batch.scatter_plan)\n        return q, kv, None, None\n    # Byte views avoid relying on FP8 cat/indexing support on the installed PTA.\n    q_bytes = torch.empty((tokens, impl.num_heads, QFM_WIDTH), dtype=torch.uint8, device=hidden.device)\n    q_scale = torch.empty((tokens, impl.num_heads), dtype=torch.float32, device=hidden.device)\n    kv = fia_q = None\n    if batch.fia_requests:\n        kv = torch.zeros((tokens, QFM_WIDTH), dtype=torch.bfloat16, device=hidden.device)\n        fia_q = torch.zeros((tokens, impl.num_heads, QFM_WIDTH), dtype=torch.bfloat16, device=hidden.device)\n    for begin, end, prefill in segments:\n        chunk = hidden[begin:end].contiguous()\n        slots = batch.slots[begin:end]\n        scatter_plan = batch.scatter_plan.slice(begin, end) if batch.scatter_plan is not None else None\n        if prefill:\n            chunk_q, chunk_kv = ordinary_qfm_inputs(impl, chunk, end - begin)\n            write_cache(chunk_kv, slots, cache, impl.qfm_scale, scatter_plan=scatter_plan)\n            if fia_q is not None:\n                fia_q[begin:end].copy_(chunk_q)\n                kv[begin:end].copy_(chunk_kv)\n                # These rows have used_q=0 in QFM and are overwritten by\n                # FIA using the original BF16 Q. Keep legal placeholders for\n                # the unchanged whole-batch QFM/DCP descriptor and gathers.\n                q_bytes[begin:end].zero_()\n                q_scale[begin:end].fill_(1.0)\n                continue\n            chunk_q, chunk_scale = quantize_query(chunk_q)\n        else:\n            kwargs = dict(batch.prolog_kwargs)\n            if scatter_plan is not None:\n                kwargs["scatter_plan"] = scatter_plan\n            if "staging_indices" in kwargs:\n                kwargs["staging_indices"] = kwargs["staging_indices"][: end - begin]\n            chunk_q, chunk_scale = prolog(chunk, slots, cache, **kwargs)\n        q_bytes[begin:end].copy_(chunk_q.view(torch.uint8))\n        q_scale[begin:end].copy_(chunk_scale)\n    return q_bytes.view(torch.float8_e4m3fn), kv, q_scale, fia_q\n\n\ndef quantize_query(q):\n    floating = q.float()\n    scale = floating.abs().amax(-1).clamp_min(1e-12) / QFM_FP8_MAX\n    values = (floating / scale[..., None]).clamp(-QFM_FP8_MAX, QFM_FP8_MAX).to(torch.float8_e4m3fn)\n    return values, scale\n\n\ndef run_qfm_reader(impl, q, cache, batch, q_scale=None):\n    if q_scale is None:\n        q8, q_scale = quantize_query(q)\n    else:\n        q8 = q\n    attention, _ = impl.qfm_ops\n    latent, lse = attention(\n        q8,\n        cache,\n        q_scale,\n        impl.qfm_scale,\n        batch.table,\n        batch.lengths,\n        1,\n        cu_seqlens_q=batch.cu,\n        seqused_q=batch.used,\n        metadata=batch.schedule,\n        head_dim_v=QFM_VALUE,\n        attn_mask=batch.mask,\n        softmax_scale=impl.scale,\n        mask_mode=batch.mask_mode,\n        max_seqlen_q=batch.max_q,\n        max_seqlen_kv=batch.max_k,\n        layout_q="TND",\n        layout_kv="PA_NZ",\n        layout_out="TND",\n        return_softmax_lse=impl.dcp_enabled,\n    )\n    invisible = batch.invisible if batch.invisible is not None else ~batch.visible\n    latent = latent.masked_fill(invisible[:, None, None], 0)\n    if impl.dcp_enabled:\n        lse = lse.T.masked_fill(invisible[:, None], -float("inf")).unsqueeze(-1)\n    elif batch.fia_requests:\n        lse = torch.empty((*q.shape[:2], 1), device=q.device)\n    return latent, lse\n', 'sha256': '64df4c407e14a8bce729bdb1f393b6653e9f1b9e160377f7dcba4d22739054c6'}, 'weights': {'module': 'vllm_ascend.attention.kimi_k3_qfm_prolog_weights', 'source': '# SPDX-License-Identifier: Apache-2.0\n"""Private ND projection weights for K3\'s full576 QFM DSL prolog.\n\nModelSlim has already transposed weights and paired the MX scales before this\nadapter runs. Never mutate those tensors: the ordinary path still uses them.\n"""\n\nimport math\n\nimport torch\nimport torch_npu\n\nMIN_HIDDEN_SIZE = 1024\nMAX_HIDDEN_SIZE = 8192\nHIDDEN_ALIGNMENT = 256\nQ_RANKS = (640, 1024, 1536, 2048)\nKV_RANK = 512\nQ_NOPE_DIMS = (128, 192)\nRAW_DIM = 64\nMX_GROUP_SIZE = 32\nMX_SCALE_PAIR = 2\nACL_FORMAT_ND = 2\n\n\ndef _projection(layer, name, inputs, outputs):\n    # Lazy import avoids initializing the quantization/attention import cycle\n    # when this independently testable adapter is imported.\n    from vllm_ascend.quantization.methods.w8a8.w8a8_mxfp8 import AscendW8A8MXFP8DynamicLinearMethod\n\n    method = getattr(layer, "quant_method", None)\n    method = getattr(method, "quant_method", method)\n    if not isinstance(method, AscendW8A8MXFP8DynamicLinearMethod) or method.group_size != MX_GROUP_SIZE:\n        raise ValueError(f"QFM prolog {name} requires ModelSlim W8A8_MXFP8 Group32")\n    if getattr(method, "dynamic_mx_quant_scale_alg", None) != 0:\n        raise ValueError(f"QFM prolog {name} requires dynamic_mx_quant_scale_alg=0 to match the native QR quantizer")\n    if not getattr(layer, "_mxfp8_transformed", False):\n        raise ValueError(f"QFM prolog {name} must be prepared after MXFP8 weight loading")\n    if getattr(layer, "_chunk_size", 0) or getattr(layer, "_mxfp8_gmm_nz_layout", False):\n        raise ValueError(f"QFM prolog {name} does not accept chunked or grouped-GMM projection weights")\n    if getattr(layer, "bias", None) is not None:\n        raise ValueError(f"QFM prolog {name} requires a bias-free projection")\n    if any(getattr(layer, "mxfp8_tp_padding", (0, 0))):\n        raise ValueError(f"QFM prolog {name} does not accept TP-padded MX groups")\n\n    weight, scale = layer.weight, layer.weight_scale\n    if weight.dtype != torch.float8_e4m3fn or tuple(weight.shape) != (inputs, outputs):\n        raise ValueError(f"QFM prolog {name} expects processed E4M3 weight [{inputs}, {outputs}]")\n    expected_scale = (inputs // (MX_GROUP_SIZE * MX_SCALE_PAIR), outputs, MX_SCALE_PAIR)\n    if tuple(scale.shape) != expected_scale or scale.dtype not in (torch.uint8, torch.float8_e8m0fnu):\n        raise ValueError(f"QFM prolog {name} expects paired E8M0 scales {expected_scale}")\n    if weight.device != scale.device:\n        raise ValueError(f"QFM prolog {name} weight and scale must share a device")\n    # Convert the internal NZ format before slicing/transposing. Tensor shape\n    # alone cannot reveal that physical storage is NZ rather than ND.\n    weight_nd = torch_npu.npu_format_cast(weight.detach(), ACL_FORMAT_ND)\n    private_weight = weight_nd.transpose(0, 1).contiguous().clone()\n    private_scale = scale.detach().transpose(0, 1).contiguous().view(torch.float8_e8m0fnu).clone()\n    return private_weight, private_scale\n\n\ndef prepare_prolog_weights(impl):\n    """Return DSL kwargs without replacing or modifying any original parameter."""\n    if getattr(impl, "use_mla_rope", True):\n        raise ValueError("QFM prolog requires K3 NoRoPE")\n    q_rank, nope_dim = impl.q_lora_rank, impl.qk_nope_head_dim\n    if q_rank not in Q_RANKS or nope_dim not in Q_NOPE_DIMS:\n        raise ValueError(f"QFM prolog requires q rank in {Q_RANKS} and q_nope dim in {Q_NOPE_DIMS}")\n    if impl.kv_lora_rank != KV_RANK or impl.qk_rope_head_dim != RAW_DIM:\n        raise ValueError("QFM prolog requires latent512 + raw64")\n    heads = impl.num_heads\n    if isinstance(heads, bool) or not isinstance(heads, int) or not 1 <= heads <= 128:\n        raise ValueError("QFM prolog requires 1..128 TP-local heads")\n\n    norm_qa, norm_kva = impl.q_a_layernorm, impl.kv_a_layernorm\n    eps = float(norm_qa.variance_epsilon)\n    if not math.isfinite(eps) or eps <= 0 or eps != float(norm_kva.variance_epsilon):\n        raise ValueError("QFM prolog requires equal positive finite Q/KV RMSNorm epsilon")\n    for name, norm, size in (("q_a", norm_qa, q_rank), ("kv_a", norm_kva, KV_RANK)):\n        # Loading-time check only. The native schema has no norm-bias input;\n        # zero correction is harmless, nonzero/NaN correction must not vanish.\n        bias = getattr(norm, "bias", None)\n        if getattr(norm, "bias_loaded", False) and (bias is None or bool(torch.count_nonzero(bias).item())):\n            raise ValueError(\n                f"QFM DSL Prolog cannot apply loaded nonzero {name} RMSNorm bias; "\n                "disable enable_mlapo or use a bias-aware Prolog implementation"\n            )\n        if norm.weight.dtype not in (torch.bfloat16, torch.float32) or tuple(norm.weight.shape) != (size,):\n            raise ValueError(f"QFM prolog {name} RMSNorm weight must be BF16 or FP32 [{size}]")\n\n    fused = getattr(impl, "fused_qkv_a_proj", None)\n    first_projection = fused if fused is not None else getattr(impl, "q_a_proj", None)\n    hidden_size = getattr(first_projection, "input_size", None)\n    if (\n        not isinstance(hidden_size, int)\n        or not MIN_HIDDEN_SIZE <= hidden_size <= MAX_HIDDEN_SIZE\n        or hidden_size % HIDDEN_ALIGNMENT\n    ):\n        raise ValueError("QFM prolog requires hidden size 1024..8192 aligned to 256")\n    if fused is not None:\n        weight, scale = _projection(fused, "fused_qkv_a_proj", hidden_size, q_rank + KV_RANK + RAW_DIM)\n        wqa, wkva = weight.split((q_rank, KV_RANK + RAW_DIM), dim=0)\n        descale_wqa, descale_wkva = scale.split((q_rank, KV_RANK + RAW_DIM), dim=0)\n    else:\n        q_a = getattr(impl, "q_a_proj", None)\n        kv_a = getattr(impl, "kv_a_proj_with_mqa", None)\n        if q_a is None or kv_a is None:\n            raise ValueError("QFM prolog needs fused_qkv_a_proj or explicit q_a_proj and kv_a_proj_with_mqa")\n        wqa, descale_wqa = _projection(q_a, "q_a_proj", hidden_size, q_rank)\n        wkva, descale_wkva = _projection(kv_a, "kv_a_proj_with_mqa", hidden_size, KV_RANK + RAW_DIM)\n\n    wqb, descale_wqb = _projection(impl.q_proj, "q_b_proj", q_rank, heads * (nope_dim + RAW_DIM))\n    wkb = impl.W_UK_T\n    if wkb.dtype != torch.bfloat16 or tuple(wkb.shape) != (heads, nope_dim, KV_RANK):\n        raise ValueError("QFM prolog W_UK_T must be BF16 [local_heads, q_nope_dim, 512], without padded/global heads")\n    result = {\n        "wqa": wqa,\n        "wqb": wqb,\n        "wkva": wkva,\n        "wkb": torch_npu.npu_format_cast(wkb.detach(), ACL_FORMAT_ND).contiguous().clone(),\n        "descale_wqa": descale_wqa,\n        "descale_wqb": descale_wqb,\n        "descale_wkva": descale_wkva,\n        "norm_weight_qa": norm_qa.weight.detach().float().contiguous().clone(),\n        "norm_weight_kva": norm_kva.weight.detach().float().contiguous().clone(),\n        "norm_eps": eps,\n    }\n    if any(value.device != wqa.device for value in result.values() if isinstance(value, torch.Tensor)):\n        raise ValueError("QFM prolog projections and norms must share a device")\n    return result\n', 'sha256': '55161bea45afbfb88b3a40eba79e90b0612d32e58c197db46b5d62ddbf1c0070'}, 'qfa': {'module': 'vllm_ascend.attention.kimi_k3_qfa_expanded', 'source': '# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n"""Experimental MXFP8 QFA over temporarily expanded K3 Prefill KV.\n\nCANN 9.2 supports QFA D=256 and requires equal Q/K/V dimensions. Pad the\nexpanded QK192/V128 with zeros, retain the model\'s original softmax scale,\nand discard the extra output columns. The persistent latent576 FP8 cache\nand QFM Decode contract are unchanged. This introduces another quantization\nof temporary expanded tensors and requires separate model accuracy testing.\n"""\n\nimport importlib\nimport inspect\nfrom contextlib import suppress\nfrom dataclasses import dataclass, field\n\nimport torch\nimport torch.nn.functional as F\nimport torch_npu\n\nQFA_DIM = 256\nQFA_QUERY_DIM = 192\nQFA_VALUE_DIM = 128\nQFA_QUANT_MODE = 1\nQFA_GROUP = 32\nQFA_SCALE_PAIR = 64\n\n\n@dataclass\nclass PreparedQFAQuery:\n    values: torch.Tensor\n    descales: torch.Tensor\n    cu_query: torch.Tensor\n    # Step-local plans may be reused for equally sized history chunks. They\n    # never survive a prepared query or retain per-layer KV tensors.\n    plans: dict = field(default_factory=dict)\n\n\ndef _validate_abi(operator, positional_names, keywords, optional_names, name):\n    if not callable(operator):\n        raise RuntimeError(f"Expanded QFA requires callable CANN 9.2 {name}")\n    source = None\n    signature = None\n    with suppress(TypeError):\n        source = inspect.getsourcefile(operator)\n    try:\n        signature = inspect.signature(operator)\n        # The delivered 9.2 Python wrappers have explicit named arguments.\n        # An unknown variadic shim must not silently bypass this ABI check.\n        if any(\n            value.kind in (inspect.Parameter.VAR_POSITIONAL, inspect.Parameter.VAR_KEYWORD)\n            for value in signature.parameters.values()\n        ):\n            raise ValueError("variadic wrapper does not expose the required ABI")\n        expected = set((*positional_names, *keywords, *optional_names))\n        found = set(signature.parameters)\n        if found != expected:\n            raise ValueError(\n                f"unexpected parameters={sorted(found - expected)}, missing parameters={sorted(expected - found)}"\n            )\n        signature.bind(*([None] * len(positional_names)), **dict.fromkeys(keywords))\n    except (TypeError, ValueError) as exc:\n        raise RuntimeError(\n            f"Expanded QFA requires the fixed CANN 9.2 {name} ABI: {exc}; "\n            f"loaded source={source}, signature={signature}. No newer tail ABI or FIA fallback is selected."\n        ) from exc\n    return {"source": source, "signature": str(signature)}\n\n\nclass ExpandedQFA:\n    """Use the explicit CANN QFA/metadata wrappers, with no FIA fallback."""\n\n    def __init__(self):\n        try:\n            ops = importlib.import_module("cann_ops_transformer.ops")\n            self.attention = ops.quant_flash_attn\n            self.metadata = ops.quant_flash_attn_metadata\n        except (ImportError, AttributeError) as exc:\n            raise RuntimeError("Expanded QFA needs installed CANN 9.2 quant_flash_attn and metadata wrappers") from exc\n        common = (\n            "cu_seqlens_q",\n            "cu_seqlens_kv",\n            "seqused_q",\n            "seqused_kv",\n            "max_seqlen_q",\n            "max_seqlen_kv",\n            "mask_mode",\n            "win_left",\n            "win_right",\n            "layout_q",\n            "layout_q_descale",\n            "layout_kv",\n            "layout_out",\n        )\n        self.abi = {\n            "metadata": _validate_abi(\n                self.metadata,\n                ("num_heads_q", "num_heads_kv", "head_dim", "quant_mode"),\n                common,\n                ("batch_size", "head_dim_v", "is_grad_enabled"),\n                "quant_flash_attn_metadata",\n            ),\n            "attention": _validate_abi(\n                self.attention,\n                ("q", "k", "v", "q_descale", "k_descale", "v_descale", "quant_mode"),\n                (\n                    *common,\n                    "block_table",\n                    "p_scale",\n                    "sinks",\n                    "attn_mask",\n                    "metadata",\n                    "softmax_scale",\n                    "return_softmax_lse",\n                ),\n                (),\n                "quant_flash_attn",\n            ),\n        }\n        if not callable(getattr(torch_npu, "npu_dynamic_mx_quant", None)):\n            raise RuntimeError("Expanded QFA requires torch_npu.npu_dynamic_mx_quant")\n\n    @staticmethod\n    def _quantize_last_dim(value):\n        values, scales = torch_npu.npu_dynamic_mx_quant(value, dst_type=torch.float8_e4m3fn, scale_alg=0)\n        expected_shape = (*value.shape[:-1], value.shape[-1] // QFA_SCALE_PAIR, 2)\n        if (\n            values.dtype != torch.float8_e4m3fn\n            or values.shape != value.shape\n            or scales.element_size() != 1\n            or scales.numel() != value.numel() // QFA_GROUP\n        ):\n            raise RuntimeError("Expanded QFA dynamic MXFP8 returned an incompatible value/scale layout")\n        # Scale storage is E8M0 bytes. Byte copies avoid float8 layout\n        # conversions that can fall back to AICPU on some PTA deliveries.\n        values = values.view(torch.uint8).contiguous().view(torch.float8_e4m3fn)\n        scales = scales.view(torch.uint8).reshape(expected_shape).contiguous().view(torch.float8_e8m0fnu)\n        return values, scales\n\n    def prepare_query(self, query):\n        """Pad and quantize Q once per request, reusing it for every KV chunk."""\n        if (\n            query.ndim != 3\n            or query.dtype != torch.bfloat16\n            or query.shape[-1] != QFA_QUERY_DIM\n            or query.shape[0] <= 0\n            or not 0 < query.shape[1] <= 256\n        ):\n            raise ValueError("Expanded QFA Query must be nonempty BF16 [T,heads<=256,192]")\n        values, scales = self._quantize_last_dim(F.pad(query, (0, QFA_DIM - QFA_QUERY_DIM)).contiguous())\n        cu = torch.tensor([0, query.shape[0]], dtype=torch.int32, device=query.device)\n        return PreparedQFAQuery(values, scales, cu)\n\n    def quantize_kv(self, key, value):\n        """Return actual encoded K/V and scales, useful for independent probes.\n\n        Q/K share scales along their D axis. V shares scales along its token\n        axis, with two Group32 scales per 64-token group. Every call describes\n        one request, so V groups cannot straddle request boundaries.\n        """\n        if (\n            key.ndim != 3\n            or value.ndim != 3\n            or key.shape[:2] != value.shape[:2]\n            or key.shape[-1] != QFA_QUERY_DIM\n            or value.shape[-1] != QFA_VALUE_DIM\n            or key.shape[0] <= 0\n            or key.dtype != torch.bfloat16\n            or value.dtype != torch.bfloat16\n            or key.device != value.device\n        ):\n            raise ValueError("Expanded QFA KV must be nonempty BF16 K[T,H,192] and V[T,H,128] on one device")\n        key8, key_scale = self._quantize_last_dim(F.pad(key, (0, QFA_DIM - QFA_QUERY_DIM)).contiguous())\n        tokens, heads = key.shape[:2]\n        padded_tokens = (tokens + QFA_SCALE_PAIR - 1) // QFA_SCALE_PAIR * QFA_SCALE_PAIR\n        # Do not retain an additional BF16 TND padded V while quantizing its\n        # token-last copy. Neither temporary survives this quantization call.\n        value8, value_scale = self._quantize_last_dim(\n            F.pad(value, (0, QFA_DIM - QFA_VALUE_DIM, 0, 0, 0, padded_tokens - tokens)).permute(1, 2, 0).contiguous()\n        )\n        value8 = value8.view(torch.uint8).permute(2, 0, 1).contiguous()[:tokens].view(torch.float8_e4m3fn)\n        value_scale = value_scale.view(torch.uint8).permute(2, 0, 1, 3).contiguous().view(torch.float8_e8m0fnu)\n        if value_scale.shape != (padded_tokens // QFA_SCALE_PAIR, heads, QFA_DIM, 2):\n            raise RuntimeError("Expanded QFA V scales do not match token-axis Group32 layout")\n        return key8, value8, key_scale, value_scale\n\n    def partial(self, prepared, key, value, scale, mask=None, *, metadata_cache=None):\n        """Compute one history/current contribution and natural-log LSE."""\n        query = prepared.values\n        if key.ndim != 3 or key.shape[1] != query.shape[1] or key.device != query.device:\n            raise ValueError("Expanded QFA KV heads/device must match the DCP-gathered Query")\n        if mask is not None and (\n            mask.shape != (2048, 2048)\n            or mask.device != query.device\n            or mask.dtype not in (torch.int8, torch.uint8, torch.bool)\n        ):\n            raise ValueError("Expanded QFA causal mask must be INT8/UINT8/BOOL [2048,2048] on the Query device")\n        key8, value8, key_scale, value_scale = self.quantize_kv(key, value)\n        query_tokens, heads = query.shape[:2]\n        kv_tokens = key.shape[0]\n        mode = 3 if mask is not None else 0\n        plan_key = "expanded_qfa", query.device, heads, query_tokens, kv_tokens, QFA_DIM, mode\n        plans = prepared.plans if metadata_cache is None else metadata_cache\n        plan = plans.get(plan_key)\n        if plan is None:\n            cu_kv = torch.tensor([0, kv_tokens], dtype=torch.int32, device=query.device)\n            attrs = dict(\n                cu_seqlens_q=prepared.cu_query,\n                cu_seqlens_kv=cu_kv,\n                seqused_q=None,\n                seqused_kv=None,\n                max_seqlen_q=query_tokens,\n                max_seqlen_kv=kv_tokens,\n                mask_mode=mode,\n                win_left=-1,\n                win_right=-1,\n                layout_q="TND",\n                layout_q_descale="TND",\n                layout_kv="TND",\n                layout_out="TND",\n            )\n            schedule = self.metadata(heads, heads, QFA_DIM, QFA_QUANT_MODE, **attrs)\n            plan = schedule, attrs\n            plans[plan_key] = plan\n        schedule, attrs = plan\n        result = self.attention(\n            query,\n            key8,\n            value8,\n            prepared.descales,\n            key_scale,\n            value_scale,\n            QFA_QUANT_MODE,\n            block_table=None,\n            p_scale=None,\n            sinks=None,\n            attn_mask=None if mask is None else mask.to(torch.int8),\n            metadata=schedule,\n            softmax_scale=scale,\n            return_softmax_lse=True,\n            **attrs,\n        )\n        if not isinstance(result, (tuple, list)) or len(result) != 2:\n            raise RuntimeError("Expanded QFA must return output and natural-log LSE; no fallback is permitted")\n        output, lse = result\n        if (\n            output.shape != (query_tokens, heads, QFA_DIM)\n            or lse.shape != (heads, query_tokens)\n            or output.dtype != torch.bfloat16\n            or lse.dtype != torch.float32\n        ):\n            raise RuntimeError("Expanded QFA returned an incompatible TND output/LSE layout")\n        return output[:, :, :QFA_VALUE_DIM].float(), lse.transpose(0, 1).unsqueeze(-1).float()\n', 'sha256': '67daed2b636416030159b3f1c334e74f1571f08a7a74ea0b87d3a6775b99601f'}, 'expanded': {'module': 'vllm_ascend.attention.kimi_k3_fia_expanded', 'source': '# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n"""Expanded BF16 FIA Prefill over the single persistent full576 FP8 cache.\n\nOnly live history is temporarily converted and projected. Its KV axis is\nbounded by the existing MLA workspace budget; each FIA call retains every Q\nin the request. Decode continues to consume the latent cache through QFM.\n"""\n\nimport torch\nimport torch_npu\n\n\nclass ExpandedFIA:\n    """Private, reloadable BF16 KV-up-projection weights for eager Prefill."""\n\n    def __init__(self, impl):\n        # Import lazily: attention utils imports the normal MLA backends.\n        from vllm_ascend.attention.utils import ascend_chunked_prefill_workspace_size\n\n        self.latent_dim = impl.kv_lora_rank\n        self.nope_dim = impl.qk_nope_head_dim\n        self.raw_dim = impl.qk_rope_head_dim\n        self.value_dim = impl.v_head_dim\n        self.qfa = None\n        if getattr(impl, "qfm_qfa_prefill", False):\n            from vllm_ascend.attention.kimi_k3_qfa_expanded import ExpandedQFA\n\n            self.qfa = ExpandedQFA()\n        if self.latent_dim != 512 or self.raw_dim != 64 or not 0 < self.value_dim <= self.latent_dim:\n            raise ValueError("Expanded FIA requires latent512/raw64 and value dimension in [1,512]")\n        tokens = ascend_chunked_prefill_workspace_size(impl.vllm_config)\n        self.workspace_bytes = tokens * (self.latent_dim + self.raw_dim) * 2\n        self.local_head_weight = None\n        self.w_kv = None\n        self.global_head_weight = None\n        self.global_w_kv = None\n        self._default_max_context_tokens = None\n        self.max_context_tokens = None\n        self.refresh_weights(impl)\n\n    @staticmethod\n    def _store(old, new):\n        if old is not None and old.shape == new.shape and old.dtype == new.dtype and old.device == new.device:\n            old.copy_(new)\n            return old\n        return new\n\n    @staticmethod\n    def _flatten_weight(weight):\n        flat = weight.transpose(0, 1).contiguous().view(weight.shape[1], -1)\n        return torch_npu.npu_format_cast(flat, 29)\n\n    def _update_context_limit(self, heads):\n        # Gathered latent/raw, projected KV, concatenated K and contiguous V\n        # coexist during a native call. Native workspace is managed by FIA.\n        bytes_per_token = 2 * (\n            self.latent_dim + self.raw_dim + heads * (2 * self.nope_dim + 2 * self.value_dim + self.raw_dim)\n        )\n        if self.qfa is not None:\n            # Temporary padded BF16 K/V, V token-axis transpose and FP8\n            # encoded inputs/scales coexist with the expanded BF16 inputs.\n            bytes_per_token += heads * (3 * 256 * 2 + 2 * 256 + 24)\n        limit = max(1, self.workspace_bytes // bytes_per_token)\n        if self.max_context_tokens is None or self.max_context_tokens == self._default_max_context_tokens:\n            self.max_context_tokens = limit\n        self._default_max_context_tokens = limit\n\n    @torch.no_grad()\n    def refresh_weights(self, impl):\n        """Copy private weights; invalidate DCP gathering after a model reload."""\n        key = impl.W_UK_T\n        value = impl.W_UV\n        if key.shape != (impl.num_heads, self.nope_dim, self.latent_dim) or value.shape != (\n            impl.num_heads,\n            self.latent_dim,\n            self.value_dim,\n        ):\n            raise ValueError("Expanded FIA KV projection weights do not match the MLA geometry")\n        local = torch.cat((key.transpose(1, 2), value), dim=-1).to(torch.bfloat16).contiguous()\n        self.local_head_weight = self._store(self.local_head_weight, local)\n        self.w_kv = self._store(self.w_kv, self._flatten_weight(local))\n        # Prefill is eager. Its global weights must be gathered again on all\n        # DCP ranks after reload, rather than using stale remote head weights.\n        self.global_head_weight = None\n        self.global_w_kv = None\n        self._update_context_limit(impl.num_heads)\n\n    @torch.no_grad()\n    def prepare_for_dcp(self, impl):\n        """Call on every rank before Query gathering, including empty shards.\n\n        Gathering the head-major weights in rank order matches the existing\n        head-axis Query gather. Cache the result across all Prefill chunks.\n        """\n        if impl.dcp_enabled and self.global_w_kv is None:\n            self.global_head_weight = impl._dcp_all_gather(self.local_head_weight, dim=0).contiguous()\n            self.global_w_kv = self._flatten_weight(self.global_head_weight)\n            self._update_context_limit(self.global_head_weight.shape[0])\n\n    def expand(self, latent, raw, *, dcp=False):\n        """Project BF16 latent into per-head K/V, retaining raw64 unchanged."""\n        weight = self.global_w_kv if dcp else self.w_kv\n        if weight is None:\n            raise RuntimeError("Call ExpandedFIA.prepare_for_dcp on every rank before Query gathering")\n        heads = weight.shape[1] // (self.nope_dim + self.value_dim)\n        projected = torch.matmul(latent.reshape(-1, self.latent_dim), weight)\n        projected = projected.view(-1, heads, self.nope_dim + self.value_dim)\n        key, value = projected.split((self.nope_dim, self.value_dim), dim=-1)\n        raw = raw.reshape(-1, 1, self.raw_dim).expand(-1, heads, -1)\n        return torch.cat((key, raw), dim=-1), value.contiguous()\n\n\ndef _partial(query, key, value, scale, mask=None):\n    """Baseline expanded MLA TND FIA-v1 contract; return FP32 merge inputs."""\n    output, lse = torch_npu.npu_fused_infer_attention_score(\n        query,\n        key,\n        value,\n        num_heads=query.shape[1],\n        num_key_value_heads=key.shape[1],\n        input_layout="TND",\n        atten_mask=mask,\n        sparse_mode=3 if mask is not None else 0,\n        scale=scale,\n        antiquant_mode=0,\n        antiquant_scale=None,\n        block_table=None,\n        block_size=0,\n        softmax_lse_flag=True,\n        actual_seq_lengths=[query.shape[0]],\n        actual_seq_lengths_kv=[key.shape[0]],\n    )\n    if lse.ndim == 2:\n        lse = lse.transpose(0, 1).unsqueeze(-1)\n    return output.reshape(query.shape[0], query.shape[1], value.shape[-1]).float(), lse.reshape(\n        query.shape[0], query.shape[1], 1\n    ).float()\n\n\ndef _merge(left, right):\n    if left is None:\n        return right\n    output, lse = left\n    next_output, next_lse = right\n    total = torch.logaddexp(lse, next_lse)\n    weight = torch.nan_to_num(torch.exp(lse - total), nan=0.0)\n    next_weight = torch.nan_to_num(torch.exp(next_lse - total), nan=0.0)\n    return output * weight + next_output * next_weight, total\n\n\ndef fill_expanded_fia(impl, q, current_kv, cache, batch, latent_container, lse):\n    """Fill Prefill rows of the mixed P-expanded/D-latent DCP merge buffer.\n\n    Prefill stores V128 in the first V columns, zeros the remaining latent512\n    container columns and never applies V up-projection. Decode rows remain\n    untouched. The caller interprets the rows after the common DCP merge.\n    """\n    # qfm also imports MLA implementation helpers; keep this dependency lazy.\n    from vllm_ascend.attention.kimi_k3_qfm import build_fia_history_plan, read_fia_history_parts\n\n    expanded = impl.fia_expanded\n    expanded.prepare_for_dcp(impl)\n    limit = expanded.max_context_tokens\n    if not isinstance(limit, int) or limit < 1:\n        raise ValueError("Expanded FIA max_context_tokens must be a positive integer")\n    heads = (expanded.global_head_weight if impl.dcp_enabled else expanded.local_head_weight).shape[0]\n    if q.shape[1:] != (heads, expanded.nope_dim + expanded.raw_dim):\n        raise ValueError("Expanded FIA Query must contain unabsorbed Q and all DCP heads")\n    if latent_container.shape[1:] != (heads, expanded.latent_dim):\n        raise ValueError("Expanded FIA requires the mixed head-major latent512 output container")\n    plans = getattr(batch, "fia_history_plans", ())\n    mask = getattr(batch, "fia_mask", None)\n    current_rank = not impl.dcp_enabled or impl.dcp_rank == 0\n    if current_rank and mask is None:\n        # Match the compressed right-down causal mask used by the BF16 MLA\n        # baseline; its 2048 format also handles longer current Q chunks.\n        mask = torch.ones((2048, 2048), dtype=torch.bool, device=q.device).triu_(1)\n    for index, (begin, end, history_length, table) in enumerate(batch.fia_requests):\n        latent_container[begin:end].zero_()\n        lse[begin:end].fill_(-float("inf"))\n        if history_length == 0 and not current_rank:\n            continue\n        query = q[begin:end].to(torch.bfloat16).contiguous()\n        prepared_query = expanded.qfa.prepare_query(query) if expanded.qfa is not None else None\n\n        def partial(key, value, causal_mask=None, *, prepared_query=prepared_query, query=query):\n            if expanded.qfa is not None:\n                if causal_mask is not None and getattr(batch, "qfa_mask", None) is not None:\n                    causal_mask = batch.qfa_mask\n                return expanded.qfa.partial(\n                    prepared_query,\n                    key,\n                    value,\n                    impl.scale,\n                    causal_mask,\n                    metadata_cache=getattr(batch, "qfa_metadata", None),\n                )\n            return _partial(query, key, value, impl.scale, causal_mask)\n\n        result = None\n        if history_length:\n            plan = plans[index] if plans else build_fia_history_plan(table, history_length)\n            if plan.pages.numel() != history_length or plan.positions.numel() != history_length:\n                raise ValueError("Expanded FIA history plan does not cover the live local history")\n            for start in range(0, history_length, limit):\n                stop = min(start + limit, history_length)\n                chunk_plan = type(plan)(plan.pages[start:stop], plan.positions[start:stop], plan.tiles)\n                latent, raw = read_fia_history_parts(cache, chunk_plan)\n                key, value = expanded.expand(latent, raw, dcp=impl.dcp_enabled)\n                result = _merge(result, partial(key, value))\n                del latent, raw, key, value\n        if current_rank:\n            current = current_kv[begin:end].reshape(end - begin, expanded.latent_dim + expanded.raw_dim)\n            current = current.to(torch.bfloat16)\n            key, value = expanded.expand(\n                current[:, : expanded.latent_dim], current[:, expanded.latent_dim :], dcp=impl.dcp_enabled\n            )\n            result = _merge(result, partial(key, value, mask))\n        if result is not None:\n            latent_container[begin:end, :, : expanded.value_dim].copy_(result[0].to(latent_container.dtype))\n            lse[begin:end].copy_(result[1])\n', 'sha256': '76484cd9eb50fc6634552268815a946be7a1b6d6c08548458e399c84a7ec7d10'}, 'native': {'module': 'vllm_ascend.attention.kimi_k3_fia_native_prolog', 'source': '# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n"""CANN package Prolog frontend for K3\'s expanded BF16 FIA Prefill.\n\nThe package ``cann_ops_transformer.mla_prolog`` wraps MlaPrologV4WeightNz,\nwhose NoPE interface is documented in ops-transformer v9.2.0, revision\ndff221330eecd2132233b1e73ed1072cd8925140. This does not establish that a\nparticular container has the matching Python wrapper or native runtime.\n\nNative Prolog normally absorbs UK into Q and returns a 512-dimensional Q.\nFor expanded FIA, a PRIVATE UK=[I_128 | 0] embeds the unabsorbed 128-wide Q\ninto that output. We keep its first 128 columns and append raw64. This is\nnot an inverse or pseudoinverse, and never replaces the model\'s real UK.\nThe operator still performs its 128-to-512 multiplication, emits the wider\nQ, and writes two current-chunk BF16 scratch buffers. Those costs require\nan NPU benchmark; fusion alone does not establish a performance benefit.\n\nOnly current rows are staged here. The caller writes the persistent full576\nFP8 cache and runs FIA; no BF16 history cache or Decode DSL path is changed.\n"""\n\nimport torch\nimport torch_npu\n\nNATIVE_HIDDEN_SIZES = (1024, 2048, 3072, 4096, 5120, 6144, 7168, 7680, 8192)\nNATIVE_Q_RANKS = (1536, 2048)\nQ_NOPE_DIM = 128\nRAW_DIM = 64\nKV_RANK = 512\nCURRENT_BLOCK_SIZE = 128\nMX_GROUP_SIZE = 32\nACL_FORMAT_FRACTAL_NZ = 29\n\n\ndef prepare_native_fia_prolog_weights(impl):\n    """Prepare private native layouts once, after ModelSlim weight loading."""\n    # Reuse the processed-MXFP8 contract checks without importing the linear\n    # implementation during attention-module initialization.\n    from vllm_ascend.attention.kimi_k3_qfm_prolog_weights import prepare_prolog_weights\n\n    if impl.q_lora_rank not in NATIVE_Q_RANKS or impl.qk_nope_head_dim != Q_NOPE_DIM:\n        raise ValueError("Native FIA Prolog requires q rank 1536/2048 and q_nope dim 128")\n    for name in ("q_a_layernorm", "kv_a_layernorm"):\n        if getattr(impl, name).weight.dtype != torch.bfloat16:\n            raise ValueError("Native FIA Prolog requires BF16 RMSNorm weights")\n    prepared = prepare_prolog_weights(impl)\n    hidden_size = prepared["wqa"].shape[1]\n    if hidden_size not in NATIVE_HIDDEN_SIZES:\n        raise ValueError(f"Native FIA Prolog hidden size must be in {NATIVE_HIDDEN_SIZES}")\n\n    native = {}\n    for native_name, prepared_name in (\n        ("weight_dq", "wqa"),\n        ("weight_uq_qr", "wqb"),\n        ("weight_dkv_kr", "wkva"),\n    ):\n        # DSL helpers return ND [out,in]. The package takes NZ [in,out].\n        native[native_name] = torch_npu.npu_format_cast(\n            prepared[prepared_name].transpose(0, 1).contiguous(), ACL_FORMAT_FRACTAL_NZ\n        )\n    for native_name, prepared_name in (\n        ("dequant_scale_w_dq", "descale_wqa"),\n        ("dequant_scale_w_uq_qr", "descale_wqb"),\n        ("dequant_scale_w_dkv_kr", "descale_wkva"),\n    ):\n        # ModelSlim pairs successive Group32 E8 codes. Native consumes them\n        # flattened as [out,in/32], not the DSL [out,in/64,2] view.\n        native[native_name] = prepared[prepared_name].flatten(1).contiguous()\n    native["rmsnorm_gamma_cq"] = prepared["norm_weight_qa"].to(torch.bfloat16)\n    native["rmsnorm_gamma_ckv"] = prepared["norm_weight_kva"].to(torch.bfloat16)\n    native["rmsnorm_epsilon_cq"] = prepared["norm_eps"]\n    native["rmsnorm_epsilon_ckv"] = prepared["norm_eps"]\n\n    # No head padding: the V4 interface allows every integer head count 1..128.\n    # This matrix is independent of the real UK consumed by Decode and FIA K.\n    device = native["weight_dq"].device\n    embedded_uk = torch.zeros((impl.num_heads, Q_NOPE_DIM, KV_RANK), dtype=torch.bfloat16, device=device)\n    embedded_uk[:, :, :Q_NOPE_DIM] = torch.eye(Q_NOPE_DIM, dtype=torch.bfloat16, device=device)\n    native["weight_uk"] = embedded_uk\n    return native\n\n\nclass NativeFIAProlog:\n    """Return unabsorbed BF16 Q192 and current KV576 without touching history."""\n\n    def __init__(self, impl):\n        self.weights = prepare_native_fia_prolog_weights(impl)\n        self.num_heads = impl.num_heads\n        self.hidden_size = self.weights["weight_dq"].shape[0]\n        self.device = self.weights["weight_dq"].device\n        # Lazy import keeps package loading in the worker, outside graph capture.\n        try:\n            from cann_ops_transformer import mla_prolog\n        except ImportError as exc:\n            raise RuntimeError("Native FIA Prolog needs the CANN package mla_prolog NoPE/V4 wrapper") from exc\n        self.op = mla_prolog\n        self._capacity = 0\n        self._current_latent = None\n        self._current_raw = None\n        self._indices = None\n        scheduler = getattr(getattr(impl, "vllm_config", None), "scheduler_config", None)\n        capacity = getattr(scheduler, "max_num_batched_tokens", 0)\n        if isinstance(capacity, int) and not isinstance(capacity, bool) and capacity > 0:\n            self._reserve(capacity)\n\n    def update_weights(self, impl):\n        """Refresh compatible private weights without invalidating addresses."""\n        weights = prepare_native_fia_prolog_weights(impl)\n        for name, value in weights.items():\n            old = self.weights[name]\n            if isinstance(value, torch.Tensor):\n                if old.shape != value.shape or old.dtype != value.dtype or old.device != value.device:\n                    raise ValueError(f"Native FIA Prolog {name} changed; restart workers and recapture")\n            elif old != value:\n                raise ValueError(f"Native FIA Prolog {name} changed; restart workers and recapture")\n        for name, value in weights.items():\n            if isinstance(value, torch.Tensor):\n                self.weights[name].copy_(value)\n\n    def _reserve(self, tokens):\n        if tokens <= self._capacity:\n            return\n        blocks = (tokens + CURRENT_BLOCK_SIZE - 1) // CURRENT_BLOCK_SIZE\n        self._capacity = blocks * CURRENT_BLOCK_SIZE\n        self._current_latent = torch.empty(\n            (blocks, CURRENT_BLOCK_SIZE, 1, KV_RANK), dtype=torch.bfloat16, device=self.device\n        )\n        self._current_raw = torch.empty(\n            (blocks, CURRENT_BLOCK_SIZE, 1, RAW_DIM), dtype=torch.bfloat16, device=self.device\n        )\n        self._indices = torch.arange(self._capacity, dtype=torch.int64, device=self.device)\n\n    def __call__(self, hidden):\n        if (\n            hidden.dtype != torch.bfloat16\n            or hidden.ndim != 2\n            or hidden.shape[1] != self.hidden_size\n            or hidden.device != self.device\n        ):\n            raise ValueError("Native FIA Prolog needs BF16 [physical_tokens, hidden_dim] on the weight device")\n        tokens = hidden.shape[0]\n        if tokens == 0:\n            return hidden.new_empty((0, self.num_heads, Q_NOPE_DIM + RAW_DIM)), hidden.new_empty((0, KV_RANK + RAW_DIM))\n        self._reserve(tokens)\n        x, scales = torch_npu.npu_dynamic_mx_quant(hidden.contiguous(), dst_type=torch.float8_e4m3fn, scale_alg=0)\n        scales = scales.view(torch.float8_e8m0fnu).reshape(tokens, self.hidden_size // MX_GROUP_SIZE).contiguous()\n        blocks = (tokens + CURRENT_BLOCK_SIZE - 1) // CURRENT_BLOCK_SIZE\n        latent_cache = self._current_latent[:blocks]\n        raw_cache = self._current_raw[:blocks]\n        q_latent, q_raw, _, _, _ = self.op(\n            token_x=x,\n            dequant_scale_x=scales,\n            kv_cache=latent_cache,\n            kr_cache=raw_cache,\n            cache_index=self._indices[:tokens],\n            rope_sin=None,\n            rope_cos=None,\n            cache_mode="PA_BSND",\n            weight_quant_mode=3,\n            query_quant_mode=0,\n            kv_cache_quant_mode=0,\n            **self.weights,\n        )\n        if (\n            q_latent.dtype != torch.bfloat16\n            or q_raw.dtype != torch.bfloat16\n            or tuple(q_latent.shape) != (tokens, self.num_heads, KV_RANK)\n            or tuple(q_raw.shape) != (tokens, self.num_heads, RAW_DIM)\n        ):\n            raise RuntimeError("Native FIA Prolog returned incompatible BF16 Q512/raw64 outputs")\n        q = torch.cat((q_latent[:, :, :Q_NOPE_DIM], q_raw), dim=-1)\n        current = torch.cat((latent_cache.view(-1, KV_RANK)[:tokens], raw_cache.view(-1, RAW_DIM)[:tokens]), dim=-1)\n        return q, current\n', 'sha256': '26b89146985a8bcdbd2e661d058b17a73066fec230b57004e04be01869282d67'}, 'qfa_golden': {'module': 'fia_expanded_qfa_golden920', 'source': '# -----------------------------------------------------------------------------------------------------------\n# Copyright (c) 2026 Huawei Technologies Co., Ltd.\n# This program is free software, you can redistribute it and/or modify it under the terms and conditions of\n# CANN Open Software License Agreement Version 2.0 (the "License").\n# Please refer to the License for details. You may not use this file except in compliance with the License.\n# THIS SOFTWARE IS PROVIDED ON AN "AS IS" BASIS, WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED,\n# INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.\n# See LICENSE in the root of the software repository for the full text of the License.\n# -----------------------------------------------------------------------------------------------------------\n# ruff: noqa: RUF059, PLR1730\n"""Pinned official QFA MXFP8 CPU golden and result comparison functions.\n\nPure functions extracted by AST from the official v9.2.0 source. NPU imports,\nCLI/global example configuration and logging setup are deliberately omitted.\nThe probe sets these globals for each native partial call. Its query sampling\nmask is injected separately, preserving each sampled query\'s original index.\n"""\n\nimport logging\nimport math\n\nimport torch\n\nSOURCE_REVISION = "dff221330eecd2132233b1e73ed1072cd8925140"\nGOLDEN_SOURCE_SHA256 = "793bf7d1adc1b28fa69bc5c87ea47f8caebbd10cf44cd8e37d5b07f37eb2c7b0"\nCOMPARE_SOURCE_SHA256 = "c5345e38c6a52cf12afb0da7563ea4283cdf9fc7f57abd6c0d978437cec36edc"\nlogger = logging.getLogger(__name__)\nlogger.setLevel(logging.WARNING)\n_EPS = 1e-10\nD = 256\nD_rope = 0\nENABLE_ROPE = False\nQUANT_GROUP_SIZE = 32\nFP8_DTYPE = torch.float8_e4m3fn\nN_q = 1\nN_kv = 1\nSPARSE_MODE = 0\nSEQUSED_Q = None\nSEQUSED_KV = None\nCU_SEQLENS_Q = None\nCU_SEQLENS_KV = None\n\ndef _derive_seqused(cu_seqlens):\n    if cu_seqlens is None:\n        return None\n    return [cu_seqlens[i + 1] - cu_seqlens[i] for i in range(len(cu_seqlens) - 1)]\n\ndef _get_seqused_q():\n    return SEQUSED_Q if SEQUSED_Q is not None else _derive_seqused(CU_SEQLENS_Q)\n\ndef _get_seqused_kv():\n    return SEQUSED_KV if SEQUSED_KV is not None else _derive_seqused(CU_SEQLENS_KV)\n\ndef broadcast_kv(num_heads, num_kv_heads, kv_tensor):\n    factor = num_heads // num_kv_heads\n    B, _, S, D = kv_tensor.shape\n    result = torch.zeros([B, num_heads, S, D], dtype=kv_tensor.dtype)\n    for i in range(num_heads):\n        result[:, i : i + 1, :, :] = kv_tensor[:, i // factor : i // factor + 1, :, :]\n    return result\n\n\ndef _build_attention_mask(b, Sq, Skv, actual_seq_q, actual_seq_kv, sparse_mode):\n    """构建全局 attention mask\n    sparse_mode=3: causal + padding mask (左下三角 + 右上 padding)\n    其他: 仅 padding mask\n    """\n    q_lens_t = torch.tensor(actual_seq_q, dtype=torch.int32)\n    k_lens_t = torch.tensor(actual_seq_kv, dtype=torch.int32)\n    q_lens_acl = q_lens_t.view(b, 1, 1, 1)\n    k_lens_acl = k_lens_t.view(b, 1, 1, 1)\n\n    q_range = torch.arange(Sq).view(1, 1, -1, 1)\n    k_range = torch.arange(Skv).view(1, 1, 1, -1)\n    q_padding_mask = q_range >= q_lens_acl\n    k_padding_mask = k_range >= k_lens_acl\n\n    if sparse_mode == 3:\n        delta = k_lens_acl - q_lens_acl\n        causal_mask = k_range > (q_range + delta)\n        return causal_mask | q_padding_mask | k_padding_mask\n    else:\n        return q_padding_mask | k_padding_mask\n\n\ndef _compute_s_block(\n    Qi, Kj, deq_scale_q_i, deq_scale_k_j, softmax_scale, Qri=None, Krj=None\n):\n    """计算单个 S block (attention score)"""\n    S_ij = torch.matmul(Qi * deq_scale_q_i, (Kj * deq_scale_k_j).permute(0, 1, 3, 2))\n    if Qri is not None and Krj is not None:\n        S_ij += torch.matmul(\n            Qri.to(torch.float32), Krj.to(torch.float32).permute(0, 1, 3, 2)\n        )\n    return S_ij * softmax_scale\n\n\ndef _online_softmax_update(S_ij, mask_j, mi, si, oi, ln_p_scale, LN2):\n    """Online softmax: 计算 m, P, s 更新 (MXFP8: stored max 不含 -ln(p_scale), P 含 p_scale 因子)\n    1. mask 位置填 -inf\n    2. 求 block 内 max (m_block_j)\n    3. m 对齐到 ln2 整数倍 (ceil)，模拟 NPU MXFP8 量化精度损失\n    4. 与前一个 block 的 m 取 max (stored max 不含 -ln(p_scale))\n    5. 计算 P = exp(S - m + ln_p_scale)，模拟 NPU: exp 用 adjusted max (含 -ln(p_scale))，但 stored max 不含\n    6. 求 s = sum(P)\n    7. P 转 FP8 再转回 FP32，模拟 NPU 侧 P 的量化损失\n    """\n    S_ij = S_ij.masked_fill(mask_j, float("-inf"))\n\n    m_block_j, _ = torch.max(S_ij, dim=-1, keepdims=True)\n    m_block_j = torch.ceil(m_block_j / LN2) * LN2\n    m_block_j = m_block_j - ln_p_scale\n    m_block_j = torch.max(mi, m_block_j)\n\n    P_ij_raw = torch.exp(S_ij - m_block_j)\n    s_block_j = torch.sum(P_ij_raw, dim=-1, keepdims=True)\n    P_ij_drop = P_ij_raw.to(FP8_DTYPE).to(torch.float32)\n\n    return m_block_j, s_block_j, P_ij_drop\n\n\ndef cpu_mxfp8_golden(\n    q_fp8,\n    k_fp8,\n    v_fp8,\n    dequant_scale_q,\n    dequant_scale_k,\n    v_descale,\n    p_scale,\n    actual_seq_q,\n    actual_seq_kv,\n    softmax_scale=None,\n    qr_bf16=None,\n    kr_bf16=None,\n):\n    """CPU Flash Attention golden with MXFP8, C1V1C1V1C2V2 流水"""\n    EPSILON = 1e-20\n    LN2 = math.log(2.0)\n    Q_BLOCK_SIZE = 128\n    if D == 256:\n        K_BLOCK_SIZE = 128\n        V_BLOCK_SIZE = 256\n    else:\n        K_BLOCK_SIZE = 256\n        V_BLOCK_SIZE = 512\n\n    if actual_seq_q is None:\n        actual_seq_q = _get_seqused_q()\n    if actual_seq_kv is None:\n        actual_seq_kv = _get_seqused_kv()\n\n    # FP8 → FP32 反量化\n    q_tensor = q_fp8.to(torch.float32)\n    k_tensor = k_fp8.to(torch.float32)\n    v_tensor = v_fp8.to(torch.float32)\n\n    # GQA: 广播 K/V 到与 Q 相同的 head 数\n    if N_q != N_kv:\n        logger.info("[INFO] GQA 广播")\n        k_tensor = broadcast_kv(N_q, N_kv, k_tensor)\n        v_tensor = broadcast_kv(N_q, N_kv, v_tensor)\n        dequant_scale_k = broadcast_kv(N_q, N_kv, dequant_scale_k)\n        v_descale = broadcast_kv(N_q, N_kv, v_descale)\n        if kr_bf16 is not None:\n            kr_bf16 = broadcast_kv(N_q, N_kv, kr_bf16)\n\n    b, n, s, d = q_tensor.shape\n    d_total = d + (D_rope if ENABLE_ROPE else 0)\n    if softmax_scale is None:\n        softmax_scale = 1.0 / math.sqrt(d_total)\n    dv = v_tensor.shape[-1]\n    Sq, Skv = q_tensor.shape[2], k_tensor.shape[2]\n\n    minValue = torch.tensor(-3.402823466e38, dtype=torch.float32)\n    out = torch.zeros([b, n, Sq, dv], dtype=torch.float32)\n    o_sum = torch.zeros(q_tensor.shape[:-1])[..., None]\n    o_max = torch.full(q_tensor.shape[:-1], minValue.item(), dtype=torch.float32)[\n        ..., None\n    ]\n\n    TILES_Q = (Sq + Q_BLOCK_SIZE - 1) // Q_BLOCK_SIZE\n    TILES_KV = (Skv + K_BLOCK_SIZE - 1) // K_BLOCK_SIZE\n\n    mask_global = _build_attention_mask(\n        b, Sq, Skv, actual_seq_q, actual_seq_kv, SPARSE_MODE\n    )\n\n    Q_BLOCKS = list(torch.split(q_tensor, Q_BLOCK_SIZE, dim=2))\n    K_BLOCKS = list(torch.split(k_tensor, K_BLOCK_SIZE, dim=2))\n    V_BLOCKS = list(torch.split(v_tensor, V_BLOCK_SIZE, dim=2))\n    o_BLOCKS = list(torch.split(out, Q_BLOCK_SIZE, dim=2))\n    s_BLOCKS = list(torch.split(o_sum, Q_BLOCK_SIZE, dim=2))\n    m_BLOCKS = list(torch.split(o_max, Q_BLOCK_SIZE, dim=2))\n\n    Qr_BLOCKS = None\n    Kr_BLOCKS = None\n    if ENABLE_ROPE and qr_bf16 is not None:\n        Qr_BLOCKS = list(torch.split(qr_bf16, Q_BLOCK_SIZE, dim=2))\n        Kr_BLOCKS = list(torch.split(kr_bf16, K_BLOCK_SIZE, dim=2))\n\n    ln_p_scale = torch.tensor([math.log(p_scale)], dtype=torch.float32)\n\n    # dequant_scale 按 group_size 扩展，用于逐元素反量化\n    dequant_scale_q_expanded = dequant_scale_q.repeat_interleave(\n        QUANT_GROUP_SIZE, dim=-1\n    )[:, :, :, :D]\n    dequant_scale_k_expanded = dequant_scale_k.repeat_interleave(\n        QUANT_GROUP_SIZE, dim=-1\n    )[:, :, :, :D]\n    v_descale_expanded = v_descale.repeat_interleave(QUANT_GROUP_SIZE, dim=2)\n\n    logger.info(\n        "[CPU Golden] TILES_Q=%d, TILES_KV=%d, Sq=%d, Skv=%d",\n        TILES_Q,\n        TILES_KV,\n        Sq,\n        Skv,\n    )\n\n    for i in range(TILES_Q):\n        Qi = Q_BLOCKS[i]\n        Sq_start = i * Q_BLOCK_SIZE\n        Sq_end = min(Sq_start + Q_BLOCK_SIZE, Sq)\n        deq_scale_q_i = dequant_scale_q_expanded[:, :, Sq_start:Sq_end, :]\n\n        Qri = Qr_BLOCKS[i] if Qr_BLOCKS is not None else None\n\n        for j in range(0, TILES_KV, 2):\n            # C1V1C1V1C2V2: 每次迭代处理 2 个 K block + 1 个 V block\n            oi, si, mi = o_BLOCKS[i], s_BLOCKS[i], m_BLOCKS[i]\n\n            Kj = K_BLOCKS[j]\n            Sk_start = j * K_BLOCK_SIZE\n            Sk_end = min(Sk_start + K_BLOCK_SIZE, Skv)\n            deq_scale_k_j = dequant_scale_k_expanded[:, :, Sk_start:Sk_end, :]\n            Krj = Kr_BLOCKS[j] if Kr_BLOCKS is not None else None\n\n            S_ij = _compute_s_block(\n                Qi, Kj, deq_scale_q_i, deq_scale_k_j, softmax_scale, Qri, Krj\n            )\n            mask_j = mask_global[:, :, Sq_start:Sq_end, Sk_start:Sk_end]\n            m_block_j, s_block_j, P_ij_drop = _online_softmax_update(\n                S_ij, mask_j, mi, si, oi, ln_p_scale, LN2\n            )\n\n            if j + 1 < TILES_KV:\n                # --- 第二个 K block (j+1) ---\n                Kj1 = K_BLOCKS[j + 1]\n                Sk1_start = (j + 1) * K_BLOCK_SIZE\n                Sk1_end = min(Sk1_start + K_BLOCK_SIZE, Skv)\n                deq_scale_k_j1 = dequant_scale_k_expanded[:, :, Sk1_start:Sk1_end, :]\n                Krj1 = Kr_BLOCKS[j + 1] if Kr_BLOCKS is not None else None\n\n                S_ij1 = _compute_s_block(\n                    Qi, Kj1, deq_scale_q_i, deq_scale_k_j1, softmax_scale, Qri, Krj1\n                )\n                mask_j1 = mask_global[:, :, Sq_start:Sq_end, Sk1_start:Sk1_end]\n                m_block_j1, s_block_j1, P_ij1_drop = _online_softmax_update(\n                    S_ij1, mask_j1, m_block_j, s_block_j, oi, ln_p_scale, LN2\n                )\n\n                # V block: 一个 V_BLOCK_SIZE 对应两个 K_BLOCK_SIZE\n                Vj = V_BLOCKS[j // 2]\n                Sv_start = (j // 2) * V_BLOCK_SIZE\n                Sv_end = min(Sv_start + V_BLOCK_SIZE, Skv)\n                deq_scale_v_j = v_descale_expanded[:, :, Sv_start:Sv_end, :]\n                Vj_dequant = Vj * deq_scale_v_j[:, :, : Vj.shape[2], :]\n\n                V_part1 = Vj_dequant[:, :, : Kj.shape[2], :]\n                V_part2 = Vj_dequant[:, :, Kj.shape[2] : Kj.shape[2] + Kj1.shape[2], :]\n                P_ij_Vj = torch.matmul(\n                    P_ij_drop * torch.exp(m_block_j - m_block_j1), V_part1\n                ) + torch.matmul(P_ij1_drop, V_part2)\n\n                update_mul_si = torch.exp(mi - m_block_j1)\n                si_new = (\n                    update_mul_si * si\n                    + s_block_j * torch.exp(m_block_j - m_block_j1)\n                    + s_block_j1\n                )\n                o_BLOCKS[i] = update_mul_si * oi + P_ij_Vj\n                s_BLOCKS[i] = si_new\n                m_BLOCKS[i] = m_block_j1\n            else:\n                Vj = V_BLOCKS[j // 2]\n                Sv_start = j * K_BLOCK_SIZE\n                Sv_end = min(Sv_start + K_BLOCK_SIZE, Skv)\n                deq_scale_v_j = v_descale_expanded[:, :, Sv_start:Sv_end, :]\n                Vj_expanded = Vj[:, :, : Kj.shape[2], :]\n                Vj_dequant = Vj_expanded * deq_scale_v_j[:, :, : Kj.shape[2], :]\n\n                P_ij_Vj = torch.matmul(P_ij_drop, Vj_dequant)\n                update_mul_si = torch.exp(mi - m_block_j)\n                si_new = update_mul_si * si + s_block_j\n                o_BLOCKS[i] = update_mul_si * oi + P_ij_Vj\n                s_BLOCKS[i] = si_new\n                m_BLOCKS[i] = m_block_j\n\n    out = torch.cat(o_BLOCKS, dim=2)\n    out_sum = torch.cat(s_BLOCKS, dim=2)\n    out = out / (out_sum + EPSILON)\n\n    o_max = torch.cat(m_BLOCKS, dim=2)\n    all_masked = o_max <= minValue.item()\n    lse = torch.where(\n        all_masked,\n        torch.full_like(o_max, float("inf")),\n        o_max + torch.log(out_sum + EPSILON),\n    )\n    out = torch.where(all_masked, torch.zeros_like(out), out)\n    logger.info("[CPU Golden] output=%s", out.shape)\n    return out, lse\n\n\ndef cal_relative_diff_torch(real_data, expect_data):\n    diff = abs(float(real_data) - float(expect_data))\n    return diff / (abs(float(expect_data)) + _EPS)\n\n\ndef display_output_torch(real_data, expect_data, start, end, expect_fp32_data=None):\n    has_fp32 = expect_fp32_data is not None\n\n    logger.info(\n        "---------------------------------------------------------------------------------------"\n    )\n    logger.info(\n        "Loop \\t ExpFP32Out \\t ExpFP16Out \\t NPUOut \\tFpDiff(min) \\t RateDiff"\n        if has_fp32\n        else "Loop \\t ExpectOut \\t RealOut \\t FpDiff \\t RateDiff"\n    )\n    logger.info(\n        "---------------------------------------------------------------------------------------"\n    )\n\n    split_count = int(end - start)\n\n    def display_row(i):\n        j = start + i\n        real_value = float(real_data[j])\n        expect_value = float(expect_data[j])\n        diff_rate = cal_relative_diff_torch(real_value, expect_value)\n        idx = start + i + 1\n\n        if not torch.isfinite(expect_data[j]).item():\n            diff_abs = "inf" if torch.isinf(expect_data[j]).item() else "nan"\n            if has_fp32:\n                logger.info(\n                    "%08d \\t %-7s \\t %-7s \\t %-7s \\t %-7s \\t %-7s",\n                    idx,\n                    float(expect_fp32_data[j]),\n                    expect_value,\n                    real_value,\n                    diff_abs,\n                    diff_rate,\n                )\n            else:\n                logger.info(\n                    "%08d \\t %-7s \\t %-7s \\t %-7s \\t %-7s",\n                    idx,\n                    expect_value,\n                    real_value,\n                    diff_abs,\n                    diff_rate,\n                )\n        else:\n            diff_abs = abs(expect_value - real_value)\n            if has_fp32:\n                logger.info(\n                    "%08d \\t %0.7f \\t %0.7f \\t %0.7f \\t %0.7f \\t %0.7f",\n                    idx,\n                    float(expect_fp32_data[j]),\n                    expect_value,\n                    real_value,\n                    diff_abs,\n                    diff_rate,\n                )\n            else:\n                logger.info(\n                    "%08d \\t %0.7f \\t %0.7f \\t %0.7f \\t %0.7f",\n                    idx,\n                    expect_value,\n                    real_value,\n                    diff_abs,\n                    diff_rate,\n                )\n\n    if split_count <= 20:\n        for i in range(split_count + 1):\n            display_row(i)\n    else:\n        for i in range(10):\n            display_row(i)\n        logger.info("...   \\t   ...   \\t   ...   \\t   ...    \\t   ...")\n        for i in range(split_count - 10 + 1, split_count + 1):\n            display_row(i)\n\n\ndef display_error_output_torch(real_data, expect_data, err_idx, relative_diff):\n    logger.info(\n        "Error Line-----------------------------------------------------------------------------"\n    )\n    logger.info("Loop \\t ExpectOut \\t RealOut \\t FpDiff \\t RateDiff")\n    logger.info(\n        "---------------------------------------------------------------------------------------"\n    )\n\n    len_err = int(err_idx.numel())\n    for count, i in enumerate(err_idx.tolist(), 1):\n        if count < 10 or (90 < count < 100):\n            expect_value = float(expect_data[i])\n            real_value = float(real_data[i])\n            logger.info(\n                "%08d \\t %.7f \\t %.7f \\t %.7f \\t %.7f",\n                i,\n                expect_value,\n                real_value,\n                abs(expect_value - real_value),\n                float(relative_diff[count - 1].item()),\n            )\n        elif count == 10 or (count == 100 and len_err > 100):\n            logger.info(\n                "%08s \\t %07s \\t %07s \\t %07s \\t %07s",\n                "...",\n                "...",\n                "...",\n                "...",\n                "...",\n            )\n        elif count > 100:\n            break\n\n    logger.info(\n        "Max-RE line:---------------------------------------------------------------------------"\n    )\n    max_error = (\n        float(torch.max(relative_diff).item()) if relative_diff.numel() > 0 else 0.0\n    )\n    m_idx_list = err_idx[relative_diff == max_error]\n    for m_count, m_idx in enumerate(m_idx_list.tolist()):\n        if m_count >= 3:\n            break\n        expect_value = float(expect_data[m_idx])\n        real_value = float(real_data[m_idx])\n        logger.info(\n            "%08d \\t %.7f \\t %.7f \\t %.7f \\t %.7f",\n            m_idx,\n            expect_value,\n            real_value,\n            abs(expect_value - real_value),\n            max_error,\n        )\n    logger.info(\n        "---------------------------------------------------------------------------------------"\n    )\n\n\ndef check_result(\n    expect,\n    npu_result,\n    rtol=None,\n    atol=None,\n    diff_thd=None,\n    pct_thd=None,\n    max_diff_hd=None,\n):\n    # 默认值与 ttk result_compare_method.check_result 保持一致:\n    # diff_thd=0.005, pct_thd=0.005, max_diff_hd=10\n    # rtol/atol 按 dtype 分支(bf16 0.0078125/0.0001, 否则 0.005/0.000025)\n    # 调用方可显式传入 rtol/atol 覆盖默认值(例如 LSE 对齐 ttk replay 模式)\n    _diff_thd_default = 0.005\n    _pct_thd_default = 0.005\n    _max_diff_hd_default = 10\n    _rtol_default = 0.005\n    _atol_default = 0.000025\n\n    diff_thd = _diff_thd_default if diff_thd is None else diff_thd\n    pct_thd = _pct_thd_default if pct_thd is None else pct_thd\n    max_diff_hd = _max_diff_hd_default if max_diff_hd is None else max_diff_hd\n    rtol = _rtol_default if rtol is None else rtol\n    atol = _atol_default if atol is None else atol\n\n    real_data = npu_result.detach().cpu().flatten()\n    expect_data = (\n        expect.detach().cpu().flatten()\n        if isinstance(expect, torch.Tensor)\n        else torch.as_tensor(expect).flatten()\n    )\n\n    if real_data.numel() == 0:\n        logger.info(\n            \'The npu_output is [],and it is same as bm_output, the result of data_compare is "Pass"\'\n        )\n        return "Pass", 100.0, 0\n\n    if real_data.numel() != expect_data.numel():\n        logger.info(\n            "Error,the size of npu output[%s] and benchmark[%s] is not equal.",\n            real_data.numel(),\n            expect_data.numel(),\n        )\n        return "Failed", 0.0, 0\n\n    start = 0\n    end = real_data.numel() - 1\n    if end < start:\n        end = start\n    split_count = end - start + 1 if end != start else 1\n    max_error = 0.0\n\n    overflows_count = int(\n        torch.isinf(expect_data).sum().item() + torch.isnan(expect_data).sum().item()\n    )\n    if overflows_count > 0:\n        logger.info(\n            "Overflow,size:%s,benchmark_output:%s, %s",\n            overflows_count,\n            expect_data[torch.isinf(expect_data)][0:10],\n            expect_data[torch.isnan(expect_data)][0:10],\n        )\n\n    logger.info("split_count:%s; max_diff_hd:%s;", float(split_count), max_diff_hd)\n\n    real_float = real_data.to(torch.float32)\n    expect_float = expect_data.to(torch.float32)\n\n    if npu_result.dtype == torch.bfloat16:\n        rtol = 0.0078125\n        atol = 0.0001\n\n    diff_result = torch.isclose(\n        real_float, expect_float, rtol=rtol, atol=atol, equal_nan=True\n    )\n    err_idx = torch.nonzero(~diff_result, as_tuple=False).flatten()\n\n    if expect_data.dtype == torch.bool:\n        expect_data = expect_data.to(torch.int8)\n        real_data = real_data.to(torch.int8)\n        real_float = real_data.to(torch.float32)\n        expect_float = expect_data.to(torch.float32)\n\n    diff_abs = torch.abs(expect_float - real_float)\n    b1 = torch.maximum(torch.abs(real_float), torch.abs(expect_float))\n    b2 = float((1.0 / (1 << 14)) / diff_thd)\n    b = torch.maximum(b1, torch.tensor(b2, dtype=torch.float32)) + _EPS\n    err_diff = (diff_abs / b)[err_idx]\n    err_diff = torch.where(\n        torch.isnan(err_diff) | torch.isinf(err_diff),\n        torch.tensor(float("inf"), dtype=torch.float32),\n        err_diff,\n    )\n\n    fulfill_percent = float(split_count - err_idx.numel()) / float(split_count) * 100.0\n\n    display_output_torch(real_data, expect_data, start, end)\n\n    pct_thd = (1 - pct_thd) * 100.0\n    result = "Pass" if (fulfill_percent >= pct_thd) else "Failed"\n\n    if err_diff.numel() > 0:\n        max_error = float(torch.max(err_diff).item())\n        if max_error >= max_diff_hd:\n            result = "Failed"\n\n    logger.info(\n        "---------------------------------------------------------------------------------------"\n    )\n    logger.info("Rtol   \\t Atol   \\t PctThd   \\t PctRlt   \\t Result")\n    logger.info(\n        "---------------------------------------------------------------------------------------"\n    )\n    logger.info(\n        "%.4f    \\t %.6f  \\t %.2f%%   \\t %.6f%%   \\t %s",\n        rtol,\n        atol,\n        pct_thd,\n        fulfill_percent,\n        result,\n    )\n\n    if err_diff.numel() > 0:\n        logger.info(\n            "Max-RelativeError is