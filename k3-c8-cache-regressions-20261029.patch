+@pytest.mark.parametrize("updatable", [False, True])
+def test_draft_graph_manager_snapshots_lengths_before_replay_dispatch(monkeypatch, updatable):
+    """Check host-side dispatch order only; neither replay nor capture executes."""
+    builder = _real_mla_builder(monkeypatch)
+    kwargs = _metadata_kwargs(builder)
+    events = []
+    original_to = torch.Tensor.to
+
+    def counted_to(tensor, *args, **kwargs):
+        if kwargs.get("device") == "cpu" and kwargs.get("copy") is True:
+            events.append("host_snapshot")
+        return original_to(tensor, *args, **kwargs)
+
+    def upstream_build(_self, **parent_kwargs):
+        assert parent_kwargs["step"] == QUERY_TOKENS
+        events.append("metadata_build")
+        return attn_utils._BUILD_ATTN_METADATA_MODULE.build_attn_metadata(**kwargs)
+
+    def replay_dispatch(*args):
+        events.append("replay_dispatch")
+        metadata = args[-1]
+        assert metadata[0][DRAFT_LAYER].decode.seq_lens_list == [106]
+        return "dispatched"
+
+    monkeypatch.setattr(torch.Tensor, "to", counted_to)
+    monkeypatch.setattr(DSparkSpeculator, "_build_draft_attn_metadata", upstream_build)
+    monkeypatch.setattr(graph_module, "use_updatable_graph", lambda _backend: updatable)
+    speculator = AscendDSparkSpeculator.__new__(AscendDSparkSpeculator)
+    speculator.input_batch = SimpleNamespace(
+        num_reqs=1, seq_lens_cpu_upper_bound=torch.tensor([109], dtype=torch.int32)
+    )
+    speculator.input_buffers = SimpleNamespace(positions=torch.arange(QUERY_TOKENS))
+    speculator.num_query_per_req = QUERY_TOKENS
+    speculator.attn_architecture = "MLA"
+    speculator.attn_backends = {DRAFT_LAYER: object}
+    speculator._group_causal = False
+    manager = DFlashAclGraphManager.__new__(DFlashAclGraphManager)
+    manager.speculator = speculator
+    monkeypatch.setattr(manager, "_updatable_graph_replay", replay_dispatch)
+    monkeypatch.setattr(manager, "_graph_replay", replay_dispatch)
+    desc = SimpleNamespace(num_tokens=QUERY_TOKENS, num_reqs=1)
+
+    assert manager.run_fullgraph(desc) == "dispatched"
+    assert events == ["metadata_build", "host_snapshot", "replay_dispatch"]
