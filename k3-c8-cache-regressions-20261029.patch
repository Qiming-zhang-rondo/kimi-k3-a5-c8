+def _real_mla_builder(monkeypatch):
+    builder = AscendMLAMetadataBuilder.__new__(AscendMLAMetadataBuilder)
+    builder.enable_kimi_k3_sfa_c8 = False  # DSpark draft is BF16, not target C8.
+    builder.pcp_enabled = False
+    builder.dcp_enabled = False
+    builder.decode_threshold = QUERY_TOKENS
+    builder.model_config = SimpleNamespace(get_head_size=lambda: 576)
+    builder.speculative_config = SimpleNamespace(disable_padded_drafter_batch=False)
+    builder.attn_mask_builder = SimpleNamespace(get_splitfuse_attn_mask=lambda: None)
+    builder.metadata_cls = AscendMLAMetadata
+    builder.use_mla_rope = False
+    builder.nope_zero_rope_cache = None
+    monkeypatch.setattr(attention_utils, "is_pd_decode_recompute_scheduler_enabled", lambda *_: False)
+    return builder
