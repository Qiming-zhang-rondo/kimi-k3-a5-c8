+def _metadata_kwargs(builder, *, lengths=None, dcp_local_lengths=None):
+    spec = AscendMLAAttentionSpec(block_size=128, num_kv_heads=1, head_size=576, dtype=torch.bfloat16)
+    group = SimpleNamespace(layer_names=[DRAFT_LAYER], get_metadata_builder=lambda _index: builder)
+    return {
+        "attn_groups": [[group]],
+        "num_reqs": 1,
+        "num_tokens": QUERY_TOKENS,
+        "query_start_loc_gpu": torch.tensor([0, QUERY_TOKENS], dtype=torch.int32),
+        "query_start_loc_cpu": torch.tensor([0, QUERY_TOKENS], dtype=torch.int32),
+        "max_query_len": QUERY_TOKENS,
+        "seq_lens": torch.tensor([106], dtype=torch.int32) if lengths is None else lengths,
+        "seq_lens_cpu_upper_bound": torch.tensor([109], dtype=torch.int32),
+        "max_seq_len": 4096,
+        "block_tables": [torch.tensor([[1]], dtype=torch.int32)],
+        "slot_mappings": torch.tensor([[102, 103, 104, 105]], dtype=torch.int32),
+        "kv_cache_config": KVCacheConfig(
+            num_blocks=2,
+            kv_cache_tensors=[],
+            kv_cache_groups=[KVCacheGroupSpec(layer_names=[DRAFT_LAYER], kv_cache_spec=spec)],
+        ),
+        "dcp_local_seq_lens": dcp_local_lengths,
+    }
