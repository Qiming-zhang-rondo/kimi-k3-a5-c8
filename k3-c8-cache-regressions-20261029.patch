diff --git a/tests/ut/worker/test_kimi_k3_c8_cache_isolation.py b/tests/ut/worker/test_kimi_k3_c8_cache_isolation.py
new file mode 100644
index 000000000..dc84ad48e
--- /dev/null
+++ b/tests/ut/worker/test_kimi_k3_c8_cache_isolation.py
@@ -0,0 +1,299 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Ascend project
+"""Real planner/allocation/view regressions for C8 + BF16 draft hybrid caches.
+
+These CPU tests exercise storage ownership, not an emulation of NPU Attention.
+Only model context is replaced; the planner, allocator, and reshape are real.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+from vllm.v1.kv_cache_interface import HiddenStateCacheSpec, KVCacheGroupSpec, MambaSpec, UniformTypeKVCacheSpecs
+from vllm.v1.kv_cache_layout import KVCacheLayout
+
+from vllm_ascend.attention.mla_v1 import AscendMLABackend
+from vllm_ascend.core.kv_cache_interface import AscendMLAAttentionSpec
+from vllm_ascend.patch.platform import patch_kv_cache_utils as planner
+from vllm_ascend.worker.v2 import attn_utils
+
+BLOCK_SIZE = 128
+LATENT_DIM = 512
+RAW_DIM = 64
+PACKED_WIDTH = 656
+BF16_PAGE_BYTES = BLOCK_SIZE * (LATENT_DIM + RAW_DIM) * 2
+NUM_BLOCKS = 6
+MAIN_PREFIX = "language_model.model.layers."
+DRAFT_NAME = "model.layers.0.self_attn.attn"
+
+
+def _make_case(monkeypatch, *, c8=True, mixed=False, extra_page_bytes=0, override=None):
+    page_bytes = BF16_PAGE_BYTES + extra_page_bytes
+    main_spec = AscendMLAAttentionSpec(
+        block_size=BLOCK_SIZE,
+        num_kv_heads=1,
+        head_size=PACKED_WIDTH if c8 else LATENT_DIM + RAW_DIM,
+        dtype=torch.float8_e4m3fn if c8 else torch.bfloat16,
+        cache_sparse_sfa_c8=c8,
+        page_size_padded=page_bytes,
+    )
+    draft_spec = AscendMLAAttentionSpec(
+        block_size=BLOCK_SIZE,
+        num_kv_heads=1,
+        head_size=LATENT_DIM + RAW_DIM,
+        dtype=torch.bfloat16,
+        non_causal_multi_token_decode=True,
+        page_size_padded=page_bytes,
+    )
+    # Two different-sized states deliberately differ from the contiguous MLA
+    # K/V layout. Their padded page includes bytes that no state view owns.
+    kda_spec = MambaSpec(
+        block_size=BLOCK_SIZE,
+        shapes=((BLOCK_SIZE, 64), (BLOCK_SIZE, 128)),
+        dtypes=(torch.bfloat16, torch.float32),
+        page_size_padded=page_bytes,
+    )
+    specs = {f"{MAIN_PREFIX}3.self_attn.attn": main_spec, DRAFT_NAME: draft_spec}
+    if mixed:
+        specs[f"{MAIN_PREFIX}7.self_attn.attn"] = main_spec
+    for index in range(4 if mixed else 1):
+        specs[f"{MAIN_PREFIX}{index}.linear_attn"] = kda_spec
+    if mixed:
+        groups = planner._get_kimi_k3_dspark_mixed_kv_cache_groups(specs)
+        assert groups is not None
+        assert len(groups[0].layer_names) == 3
+        assert [len(group.layer_names) for group in groups[1:]] == [2, 2]
+        # Two target slots + one draft slot + two overlaid recurrent slots.
+        expected_bytes_per_block = 5 * page_bytes if c8 else 3 * page_bytes
+    else:
+        groups = [KVCacheGroupSpec(layer_names=[name], kv_cache_spec=spec) for name, spec in specs.items()]
+        expected_bytes_per_block = 3 * page_bytes if c8 else page_bytes
+    config = SimpleNamespace(
+        additional_config={},
+        model_config=SimpleNamespace(hf_config=SimpleNamespace(), max_model_len=4 * BLOCK_SIZE),
+        parallel_config=SimpleNamespace(decode_context_parallel_size=1),
+        kv_transfer_config=None,
+        cache_config=SimpleNamespace(
+            cache_dtype="auto",
+            num_gpu_blocks_override=override,
+            prefix_cache_retention_interval=None,
+            mamba_cache_mode="none",
+            get_resolved_kv_cache_layout=lambda: KVCacheLayout.LBNHC,
+        ),
+        quant_config=None,
+    )
+    monkeypatch.setattr(attn_utils, "get_current_vllm_config", lambda: config)
+    monkeypatch.setattr(attn_utils, "enable_sfa", lambda *_: False)
+    monkeypatch.setattr(attn_utils, "enable_fa_quant", lambda *_: False)
+    monkeypatch.setattr(attn_utils, "_get_attention_kv_cache_dims", lambda *_: (LATENT_DIM, RAW_DIM))
+    return config, specs, groups, expected_bytes_per_block
+
+
+def _allocate(config, specs, groups, available_memory):
+    plan = planner._ascend_get_kv_cache_config_from_groups(config, groups, available_memory)
+    raw = attn_utils._allocate_kv_cache(plan, {}, torch.device("cpu"))
+    attn_groups = [
+        SimpleNamespace(
+            kv_cache_group_id=group_id,
+            kv_cache_spec=specs[name],
+            backend=AscendMLABackend,
+            layer_names=[name],
+        )
+        for group_id, group in enumerate(groups)
+        for name in group.layer_names
+    ]
+    views = attn_utils._reshape_kv_cache_v2(attn_groups, raw, "auto", [BLOCK_SIZE] * len(groups), {}, plan)
+    return plan, raw, views
+
+
+def _assert_block_write_isolated(views, writer_name, writer_block, reader_name, reader_block):
+    # Raw-byte sentinels avoid FP8/BF16/FP32 conversion hiding partial overwrites.
+    for tensor in views[reader_name]:
+        tensor[reader_block].view(torch.uint8).fill_(37)
+    before = [tensor[reader_block].view(torch.uint8).clone() for tensor in views[reader_name]]
+    for tensor in views[writer_name]:
+        tensor[writer_block].view(torch.uint8).fill_(91)
+    for tensor, saved in zip(views[reader_name], before):
+        assert torch.equal(tensor[reader_block].view(torch.uint8), saved), (
+            f"{writer_name} block {writer_block} overwrote {reader_name} block {reader_block}"
+        )
+
+
+@pytest.mark.parametrize("mixed", [False, True])
+@pytest.mark.parametrize("extra_page_bytes", [0, 4096])
+def test_c8_target_draft_and_recurrent_blocks_do_not_alias(monkeypatch, mixed, extra_page_bytes):
+    config, specs, groups, bytes_per_block = _make_case(monkeypatch, mixed=mixed, extra_page_bytes=extra_page_bytes)
+    plan, _, views = _allocate(config, specs, groups, NUM_BLOCKS * bytes_per_block)
+    assert plan.num_blocks >= NUM_BLOCKS
+    group_ids = {name: group_id for group_id, group in enumerate(groups) for name in group.layer_names}
+    # Distinct groups cannot own the same scheduler block simultaneously.
+    # Layers in one group must also be isolated at the same block ID.
+    block_ids = (1, 2, plan.num_blocks - 1)
+    for writer_name in specs:
+        for reader_name in specs:
+            if reader_name == writer_name:
+                continue
+            for writer_block in block_ids:
+                for reader_block in block_ids:
+                    if writer_block == reader_block and group_ids[writer_name] != group_ids[reader_name]:
+                        continue
+                    _assert_block_write_isolated(views, writer_name, writer_block, reader_name, reader_block)
+
+
+@pytest.mark.parametrize("mixed", [False, True])
+@pytest.mark.parametrize("extra_page_bytes", [0, 4096])
+def test_c8_isolated_pools_are_counted_once_in_memory_budget(monkeypatch, mixed, extra_page_bytes):
+    config, specs, groups, bytes_per_block = _make_case(monkeypatch, mixed=mixed, extra_page_bytes=extra_page_bytes)
+    available_memory = NUM_BLOCKS * bytes_per_block + bytes_per_block // 2
+    plan, raw, views = _allocate(config, specs, groups, available_memory)
+    assert planner._ascend_pool_bytes_per_block(groups) == bytes_per_block
+    assert plan.num_blocks == NUM_BLOCKS
+    assert {descriptor.size for descriptor in plan.kv_cache_tensors} == {NUM_BLOCKS * bytes_per_block}
+    backing_storages = {
+        tensor.untyped_storage().data_ptr(): tensor.untyped_storage().nbytes() for tensor in raw.values()
+    }
+    assert len(backing_storages) == 1
+    assert sum(backing_storages.values()) == NUM_BLOCKS * bytes_per_block
+    assert sum(backing_storages.values()) <= available_memory
+    assert all(tensor.shape[0] == NUM_BLOCKS for tensors in views.values() for tensor in tensors)
+    for name, tensors in views.items():
+        if name == DRAFT_NAME or isinstance(specs[name], MambaSpec):
+            # No new strided-K/V requirement is imposed on legacy native ops.
+            assert all(tensor.is_contiguous() for tensor in tensors)
+
+
+@pytest.mark.parametrize("mixed", [False, True])
+def test_c8_rank_normalization_uses_the_same_capacity_divisor(monkeypatch, mixed):
+    config, specs, groups, bytes_per_block = _make_case(monkeypatch, mixed=mixed)
+    plan = planner._ascend_get_kv_cache_config_from_groups(config, groups, NUM_BLOCKS * bytes_per_block)
+    normalized_memory = plan.num_blocks * planner._ascend_pool_bytes_per_block(groups)
+    normalized, _, _ = _allocate(config, specs, groups, normalized_memory)
+    assert normalized.num_blocks == plan.num_blocks == NUM_BLOCKS
+
+
+@pytest.mark.parametrize("mixed", [False, True])
+def test_c8_memory_admission_counts_isolated_pool_bytes(monkeypatch, mixed):
+    config, _, groups, bytes_per_block = _make_case(monkeypatch, mixed=mixed)
+    # Four full-attention pages per request; one state page per recurrent group.
+    expected_request_blocks = 6 if mixed else 9
+    assert (
+        planner._ascend_max_memory_usage_bytes_from_groups(config, groups) == expected_request_blocks * bytes_per_block
+    )
+
+
+@pytest.mark.parametrize("reverse", [False, True])
+def test_original_six_block_target_draft_corruption_regression(monkeypatch, reverse):
+    config, specs, groups, bytes_per_block = _make_case(monkeypatch, override=NUM_BLOCKS)
+    plan, _, views = _allocate(config, specs, groups, NUM_BLOCKS * bytes_per_block)
+    assert plan.num_blocks == NUM_BLOCKS
+    main_name = next(iter(specs))
+    if reverse:
+        _assert_block_write_isolated(views, main_name, 5, DRAFT_NAME, 1)
+    else:
+        _assert_block_write_isolated(views, DRAFT_NAME, 1, main_name, 5)
+
+
+@pytest.mark.parametrize("override", [1, 3, NUM_BLOCKS])
+def test_c8_num_blocks_override_is_within_budget(monkeypatch, override):
+    config, specs, groups, bytes_per_block = _make_case(monkeypatch, override=override)
+    available_memory = NUM_BLOCKS * bytes_per_block
+    plan, raw, _ = _allocate(config, specs, groups, available_memory)
+    assert plan.num_blocks == override
+    assert max(tensor.untyped_storage().nbytes() for tensor in raw.values()) == override * bytes_per_block
+
+
+def test_c8_num_blocks_override_cannot_overallocate(monkeypatch):
+    config, _, groups, bytes_per_block = _make_case(monkeypatch, override=NUM_BLOCKS + 1)
+    with pytest.raises(ValueError, match="(?i)(memory|budget|available)"):
+        planner._ascend_get_kv_cache_config_from_groups(config, groups, NUM_BLOCKS * bytes_per_block)
+
+
+@pytest.mark.parametrize("mixed", [False, True])
+def test_c8_off_preserves_existing_planner_and_bf16_views(monkeypatch, mixed):
+    config, specs, groups, bytes_per_block = _make_case(monkeypatch, c8=False, mixed=mixed)
+    available_memory = NUM_BLOCKS * bytes_per_block
+    baseline = planner._orig_get_kv_cache_config_from_groups(config, groups, available_memory)
+    plan, raw, views = _allocate(config, specs, groups, available_memory)
+    assert plan.num_blocks == baseline.num_blocks == NUM_BLOCKS
+    assert plan.kv_cache_tensors == baseline.kv_cache_tensors
+    assert planner._ascend_pool_bytes_per_block(groups) == planner._orig_pool_bytes_per_block(groups)
+    assert len({tensor.untyped_storage().data_ptr() for tensor in raw.values()}) == 1
+    for name in specs:
+        if isinstance(specs[name], MambaSpec):
+            continue
+        key, value = views[name]
+        assert key.dtype == value.dtype == torch.bfloat16
+        assert key.is_contiguous() and value.is_contiguous()
+        assert key.shape == (NUM_BLOCKS, BLOCK_SIZE, 1, LATENT_DIM)
+        assert value.shape == (NUM_BLOCKS, BLOCK_SIZE, 1, RAW_DIM)
+    main_name = next(iter(specs))
+    _assert_block_write_isolated(views, DRAFT_NAME, 1, main_name, NUM_BLOCKS - 1)
+    _assert_block_write_isolated(views, main_name, NUM_BLOCKS - 1, DRAFT_NAME, 1)
+
+
+def test_c8_mixed_uniform_group_retains_scheduler_ownership(monkeypatch):
+    config, _, groups, bytes_per_block = _make_case(monkeypatch, mixed=True)
+    assert isinstance(groups[0].kv_cache_spec, UniformTypeKVCacheSpecs)
+    expected_names = [list(group.layer_names) for group in groups]
+    plan = planner._ascend_get_kv_cache_config_from_groups(config, groups, NUM_BLOCKS * bytes_per_block)
+    # Physical isolation must not silently split the target/draft's one block table.
+    assert [group.layer_names for group in plan.kv_cache_groups] == expected_names
+
+
+def test_c8_worker_refuses_old_overlapping_planner_before_allocation(monkeypatch):
+    config, _, groups, bytes_per_block = _make_case(monkeypatch)
+    old_plan = planner._orig_get_kv_cache_config_from_groups(config, groups, NUM_BLOCKS * bytes_per_block)
+
+    def unexpected_allocation(*args, **kwargs):
+        raise AssertionError("An inconsistent plan must fail before allocating cache memory")
+
+    monkeypatch.setattr(attn_utils.torch, "zeros", unexpected_allocation)
+    with pytest.raises(ValueError, match="isolated-format plan"):
+        attn_utils._allocate_kv_cache(old_plan, {}, torch.device("cpu"))
+
+
+def test_c8_worker_rejects_aliased_mla_specs_with_different_actual_kv_split(monkeypatch):
+    config, specs, groups, bytes_per_block = _make_case(monkeypatch)
+    second_draft = "other_draft.layers.0.self_attn.attn"
+    groups.append(KVCacheGroupSpec(layer_names=[second_draft], kv_cache_spec=specs[DRAFT_NAME]))
+    plan = planner._ascend_get_kv_cache_config_from_groups(config, groups, NUM_BLOCKS * bytes_per_block)
+    monkeypatch.setattr(
+        attn_utils,
+        "_get_attention_kv_cache_dims",
+        lambda name, _spec: (448, 128) if name == second_draft else (LATENT_DIM, RAW_DIM),
+    )
+    with pytest.raises(ValueError, match="different K/V splits"):
+        attn_utils._allocate_kv_cache(plan, {}, torch.device("cpu"))
+
+
+def test_c8_hidden_state_cache_uses_budgeted_backing_without_extra_allocation(monkeypatch):
+    config, specs, groups, bytes_per_block = _make_case(monkeypatch)
+    hidden_name = "draft.cache_only_layers.36"
+    hidden_spec = HiddenStateCacheSpec(
+        block_size=BLOCK_SIZE,
+        num_kv_heads=1,
+        head_size=32,
+        dtype=torch.bfloat16,
+        page_size_padded=BF16_PAGE_BYTES,
+    )
+    specs[hidden_name] = hidden_spec
+    groups.append(KVCacheGroupSpec(layer_names=[hidden_name], kv_cache_spec=hidden_spec))
+    bytes_per_block += BF16_PAGE_BYTES
+    available_memory = NUM_BLOCKS * bytes_per_block
+    plan, raw, views = _allocate(config, specs, groups, available_memory)
+    assert plan.num_blocks == NUM_BLOCKS
+    assert planner._ascend_pool_bytes_per_block(groups) == bytes_per_block
+    assert len({tensor.untyped_storage().data_ptr() for tensor in raw.values()}) == 1
+    assert raw[hidden_name].untyped_storage().nbytes() == available_memory
+    hidden_cache = views[hidden_name]
+    hidden_cache.fill_(1)
+    saved_hidden = hidden_cache.clone()
+    for name, tensors in views.items():
+        if name != hidden_name:
+            for tensor in tensors:
+                tensor.view(torch.uint8).fill_(91)
+    assert torch.equal(hidden_cache, saved_hidden)
+    other_bytes = {name: tensor.clone() for name, tensor in raw.items() if name != hidden_name}
+    hidden_cache.zero_()
+    assert all(torch.equal(raw[name], saved) for name, saved in other_bytes.items())
