@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Run directly with Python; no vLLM initialization or model weights needed."""
+
+import argparse
+import importlib.util
+import json
+import os
+import sys
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--card", type=int, default=0)
+    args = parser.parse_args()
+    os.environ["ASCEND_RT_VISIBLE_DEVICES"] = str(args.card)
+    os.environ.pop("ASCEND_DEVICE_ID", None)
+    import torch
+    import torch_npu  # noqa: F401
+
+    torch.npu.set_device(0)
+    root = Path(__file__).resolve().parents[6]
+    path = root / "vllm_ascend/attention/kimi_k3_qfm.py"
+    spec = importlib.util.spec_from_file_location("qfm_writer_under_test", path)
+    qfm = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = qfm
+    spec.loader.exec_module(qfm)
+    torch.manual_seed(417)
+    for gap in (0, 256):
+        stride, offset = 128 * 576 + gap, 256
+        expected = torch.full((offset + 3 * stride + 256,), 0x5A, dtype=torch.uint8)
+        backing = expected.to("npu")
+        cache = qfm.cache_view(backing[offset : offset + 3 * stride], 3, stride)
+        rows_cpu = torch.randn(5, 576).bfloat16()
+        rows = rows_cpu.to("npu")
+        slots = torch.tensor([128, -1, 0, 383, 127], dtype=torch.int64, device="npu")
+        scale = torch.tensor([0.03125], dtype=torch.float32, device="npu")
+        quant = (rows_cpu.float() / 0.03125).clamp(-448, 448).to(torch.float8_e4m3fn).view(torch.uint8)
+
+        def update_expected(ids, expected=expected, quant=quant, offset=offset, stride=stride):
+            for row, slot in enumerate(ids):
+                if slot < 0:
+                    continue
+                page, token = divmod(slot, 128)
+                for tile in range(18):
+                    begin = offset + page * stride + tile * 4096 + token * 32
+                    expected[begin : begin + 32] = quant[row, tile * 32 : (tile + 1) * 32]
+
+        qfm.write_cache(rows, slots, cache, scale)
+        update_expected([128, -1, 0, 383, 127])
+        torch.npu.synchronize()
+        assert torch.equal(backing.cpu(), expected), "Eager writer bytes/guards mismatch"
+        side = torch.npu.Stream()
+        side.wait_stream(torch.npu.current_stream())
+        with torch.npu.stream(side):
+            qfm.write_cache(rows, slots, cache, scale)
+        torch.npu.current_stream().wait_stream(side)
+        graph = torch.npu.NPUGraph()
+        with torch.npu.graph(graph):
+            qfm.write_cache(rows, slots, cache, scale)
+        for ids in ([-1] * 5, [1, 129, -1, 255, 382]):
+            slots.copy_(torch.tensor(ids, dtype=torch.int64, device="npu"))
+            graph.replay()
+            update_expected(ids)
+            torch.npu.synchronize()
+            assert torch.equal(backing.cpu(), expected), "Replay writer bytes/guards mismatch"
+        print(json.dumps({"event": "qfm_framework_writer", "pass": True, "gap": gap, "offset": offset}))
+    print(
+        json.dumps(
+            {
+                "event": "summary",
+                "pass": True,
+                "scope": "native framework tile writer eager/replay only, not full model",
+            }
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
