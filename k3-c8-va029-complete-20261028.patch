+    assert _resolve_kimi_k3_c8_flag(["KimiK3ForCausalLM"], {}, enabled, False) is enabled
+
+
+@pytest.mark.parametrize("legacy,new", [(False, True), (True, False)])
+def test_conflict_fails(legacy, new):
+    with pytest.raises(ValueError, match="Conflicting"):
+        _resolve_kimi_k3_c8_flag(
+            ["KimiK3ForCausalLM"], {"enable_kimi_k3_sfa_c8": legacy, "enable_sparse_sfa_c8": new}, legacy, new
+        )
+
+
