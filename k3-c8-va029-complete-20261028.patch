+def test_batched_native_decode_padding_dynamic_metadata_and_dense_reference(heads, native_heads):
+    torch.manual_seed(23)
+    state, cache = _state(), _cache()
+    cache_before = cache.view(torch.uint8).clone()
+    native = Mock(side_effect=_native_reference)
