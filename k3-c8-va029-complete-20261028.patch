+@pytest.mark.parametrize("heads", [2, 12, 24, 48])
+def test_group128_prolog_weight_preparation_preserves_linears_and_local_heads(mxfp8, heads):
+    impl = _group128_weight_impl(mxfp8, heads)
+    projections = (impl.fused_qkv_a_proj, impl.q_proj)
+    weights = [layer.weight.float().clone() for layer in projections]
+    scales = [layer.weight_scale.clone() for layer in projections] if mxfp8 else []
+    mark_fused_preprocess_weights(impl)
+    assert impl._fused_preprocess_type() == (PreprocessType.PROLOG_V3 if mxfp8 else None)
+    with patch.object(mla_v1.torch_npu, "npu_format_cast", side_effect=lambda x, *args, **kw: x.clone()):
+        if mxfp8:
+            for layer in projections:
+                layer.quant_method.quant_method.process_weights_after_loading(layer)
+        pointers = [layer.weight.data_ptr() for layer in projections]
+        source_weights = [layer.weight.float().clone() for layer in projections]
+        impl.process_weights_after_loading(torch.bfloat16)
+    assert [layer.weight.data_ptr() for layer in projections] == pointers
+    for layer, source in zip(projections, source_weights):
+        torch.testing.assert_close(layer.weight.float(), source)
+    torch.testing.assert_close(impl.weight_dq.float(), weights[0][:1536].T)
+    torch.testing.assert_close(impl.weight_dkv_kr.float(), weights[0][1536:].T)
+    torch.testing.assert_close(impl.weight_uq_qr.float(), weights[1].T)
+    assert impl.mlapo_num_heads == heads
+    assert impl.mlapo_W_UK_T.shape == (heads, 128, 512)
+    assert impl.mlapo_weight_quant_mode == (3 if mxfp8 else 0)
+    if mxfp8:
+        torch.testing.assert_close(impl.dequant_scale_w_dq, scales[0][:1536])
+        torch.testing.assert_close(impl.dequant_scale_w_dkv_kr, scales[0][1536:])
+        torch.testing.assert_close(impl.dequant_scale_w_uq_qr, scales[1])
+    else:
+        assert impl.dequant_scale_w_dq is None
