@@ -0,0 +1,455 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU contracts for native K3 SFA C8; not a substitute for A5 execution."""
+
+import sys
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+import pytest
+import torch
+
+from vllm_ascend.attention import kimi_k3_sfa_c8 as sfa
+
+
+def _quantize(value, *, dst_type, row_block_size, col_block_size):
+    assert dst_type == torch.float8_e4m3fn and row_block_size == 1 and col_block_size == 128
+    grouped = value.float().reshape(-1, 1, 4, 128)
+    scales = grouped.abs().amax(dim=-1).clamp_min(1e-12) / torch.finfo(dst_type).max
+    quantized = (grouped / scales[..., None]).reshape(value.shape).to(dst_type)
+    return quantized, scales
+
+
+def _pack(latent, raw):
+    with patch.object(sfa.torch_npu, "npu_dynamic_block_quant", side_effect=_quantize, create=True):
+        return sfa.pack_kimi_k3_sfa_c8(latent, raw)
+
+
+def _unpack(packed, dtype=torch.bfloat16):
+    latent = packed[..., :512].float()
+    raw = packed[..., 512:640].contiguous().view(dtype).float()
+    scales = packed[..., 640:].contiguous().view(torch.float32)
+    # The native SFA kernel dequantizes to the query dtype before its matmul.
+    return (latent * scales.repeat_interleave(128, dim=-1)).to(dtype).float(), raw, scales
+
+
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float16])
+@pytest.mark.parametrize("rank", [2, 3])
+def test_pack_preserves_raw_bytes_and_four_per_token_scales(dtype, rank):
+    latent = torch.arange(3 * 512, dtype=torch.float32).reshape(3, 512).to(dtype)
+    raw = torch.linspace(-1, 1, 3 * 64).reshape(3, 64).to(dtype)
+    if rank == 3:
+        latent, raw = latent[:, None], raw[:, None]
+    packed = _pack(latent, raw)
+    assert packed.shape == (3, 1, 656) and packed.dtype == torch.float8_e4m3fn and packed.is_contiguous()
+    torch.testing.assert_close(packed[..., 512:640].contiguous().view(dtype).reshape(3, 64), raw.reshape(3, 64))
+    _, scales = _quantize(latent.reshape(3, 1, 512), dst_type=torch.float8_e4m3fn, row_block_size=1, col_block_size=128)
+    torch.testing.assert_close(packed[..., 640:].contiguous().view(torch.float32), scales)
+    assert not torch.equal(scales[:, :, 0], scales[:, :, 3])
+
+
+def test_pack_preserves_payload_bytes_that_look_like_fp8_nans():
+    raw_bytes = torch.tensor([127, 63, 255, 63], dtype=torch.uint8).repeat(32).reshape(1, 1, 128)
+    raw = raw_bytes.view(torch.bfloat16)
+    scales = torch.tensor([0x3F7FFFFF], dtype=torch.int32).view(torch.float32).repeat(4).reshape(1, 1, 4)
+    quantized = torch.zeros(1, 1, 512, dtype=torch.float8_e4m3fn)
+    with patch.object(sfa.torch_npu, "npu_dynamic_block_quant", return_value=(quantized, scales), create=True):
+        packed = sfa.pack_kimi_k3_sfa_c8(torch.ones(1, 1, 512, dtype=torch.bfloat16), raw)
+    torch.testing.assert_close(packed[..., 512:640].view(torch.uint8), raw_bytes)
+    torch.testing.assert_close(packed[..., 640:].view(torch.uint8), scales.view(torch.uint8))
+
+
+@pytest.mark.parametrize("padding", [0, 64, 1312])
+@pytest.mark.parametrize("slot_dtype", [torch.int32, torch.int64])
+def test_scatter_preserves_page_padding_guards_and_negative_slots(padding, slot_dtype):
+    page_stride = 16 * sfa.PACKED_DIM + padding
+    storage = torch.full((3 * page_stride + 64,), 19, dtype=torch.uint8)
+    cache = torch.as_strided(
+        storage.view(torch.float8_e4m3fn),
+        (3, 16, 1, 656),
+        (page_stride, 656, 656, 1),
+        storage_offset=32,
+    )
+    slots = torch.tensor([15, 16, 47, -1], dtype=slot_dtype)
+    packed = _pack(torch.randn(4, 512).bfloat16(), torch.randn(4, 64).bfloat16())
+    expected = storage.clone()
+    expected_cache = torch.as_strided(
+        expected.view(torch.float8_e4m3fn), cache.shape, cache.stride(), storage_offset=cache.storage_offset()
+    )
+    for row, slot in enumerate(slots.tolist()):
+        if slot >= 0:
+            expected_cache[slot // 16, slot % 16].copy_(packed[row])
+
+    def scatter(value, indices, *, key_cache):
+        target = key_cache
+        assert value.is_contiguous() and target.is_contiguous()
+        flattened = target.reshape(-1, *target.shape[2:])
+        for row, slot in enumerate(indices.tolist()):
+            if slot >= 0:
+                flattened[slot].copy_(value[row])
+
+    with patch.object(sfa.torch_npu, "npu_scatter_pa_cache", side_effect=scatter, create=True):
+        sfa.scatter_kimi_k3_sfa_c8(packed, slots, cache)
+    torch.testing.assert_close(storage, expected)
+
+
+def _reader_reference(query, key, value, indices, scale, **kwargs):
+    assert key is value
+    assert query.shape[1] in sfa.SUPPORTED_HEADS and query.is_contiguous()
+    assert kwargs["layout_query"] == "TND" and kwargs["layout_kv"] == "PA_BSND"
+    assert kwargs["key_quant_mode"] == kwargs["value_quant_mode"] == kwargs["attention_mode"] == 2
+    assert kwargs["quant_scale_repo_mode"] == 1 and kwargs["tile_size"] == 128 and kwargs["rope_head_dim"] == 64
+    assert kwargs["actual_seq_lengths_query"].tolist() == [query.shape[0]]
+    sinks = kwargs["sinks"]
+    assert sinks.shape == (query.shape[1],) and sinks.dtype == torch.float32
+    assert sinks.device == query.device and torch.isneginf(sinks).all()
+    assert indices.is_contiguous() and indices.dtype == torch.int32
+    kv_len = kwargs["actual_seq_lengths_kv"].item()
+    output = torch.empty((*query.shape[:2], 512), dtype=query.dtype)
+    table = kwargs["block_table"][0]
+    for row in range(query.shape[0]):
+        selected = indices[row, 0]
+        valid = selected[selected >= 0].long()
+        assert torch.equal(selected[valid.numel() :], torch.full_like(selected[valid.numel() :], -1))
+        assert len(valid) > 0 and valid.max() < kv_len
+        if kwargs["sparse_mode"] == 3:
+            valid = valid[valid <= kv_len - query.shape[0] + row]
+        cached = key[table[valid // key.shape[1]].long(), valid % key.shape[1], 0]
+        latent, raw, _ = _unpack(cached, query.dtype)
+        keys = torch.cat((latent, raw), dim=-1)
+        scores = (query[row].float() @ keys.T) * scale
+        # Model the native sink contribution, not only plain softmax.
+        probabilities = torch.softmax(torch.cat((scores, sinks[:, None]), dim=-1), dim=-1)[:, :-1]
+        output[row] = probabilities @ latent
+    return output, torch.empty(0), torch.empty(0)
+
+
+@pytest.mark.parametrize("causal", [False, True])
+@pytest.mark.parametrize("index_budget", [2, 10, 1024])
+@pytest.mark.parametrize("heads", [2, 12, 24, 48, 96])
+def test_attention_preserves_dense_semantics_for_chunks_requests_and_empty_request(causal, index_budget, heads):
+    torch.manual_seed(7)
+    cache = _pack(torch.randn(3 * 16, 512).bfloat16(), torch.randn(3 * 16, 64).bfloat16()).reshape(3, 16, 1, 656)
+    query = torch.randn(5, heads, 576).bfloat16()
+    original_query, original_cache = query.clone(), cache.view(torch.uint8).clone()
+    starts, kv_lens = [0, 3, 3, 5], [5, 0, 4]
+    table = torch.tensor([[2], [0], [1]], dtype=torch.int32)
+    scale = 576**-0.5
+    native = Mock(side_effect=_reader_reference)
+    with patch.object(sfa, "require_kimi_k3_sfa_c8_ops", return_value=native):
+        actual = sfa.kimi_k3_sfa_c8_attention(
+            query[..., :512],
+            query[..., 512:],
+            cache,
+            table,
+            torch.tensor(starts, dtype=torch.int32),
+            torch.tensor(kv_lens, dtype=torch.int64),
+            scale,
+            causal=causal,
+            max_index_elements=index_budget,
+        )
+    expected = torch.empty_like(actual)
+    for request, kv_len in enumerate(kv_lens):
+        for row in range(starts[request], starts[request + 1]):
+            visible = kv_len - (starts[request + 1] - starts[request]) + row - starts[request] + 1 if causal else kv_len
+            latent, raw, _ = _unpack(cache[table[request, 0], :visible, 0])
+            scores = query[row].float() @ torch.cat((latent, raw), dim=-1).T * scale
+            expected[row] = torch.softmax(scores, dim=-1) @ latent
+    torch.testing.assert_close(actual, expected, atol=0, rtol=0)
+    assert actual.shape == (5, heads, 512) and actual.is_contiguous()
+    torch.testing.assert_close(query, original_query)
+    torch.testing.assert_close(cache.view(torch.uint8), original_cache)
+    for call in native.call_args_list:
+        indices = call.args[3]
+        assert indices.numel() <= max(index_budget, max(kv_lens))
+        assert call.kwargs["sparse_mode"] == (3 if causal else 0)
+        assert call.args[0].shape[1] == sfa.get_kimi_k3_sfa_c8_padded_heads(heads)
+        assert torch.count_nonzero(call.args[0][:, heads:]) == 0
+
+
+@pytest.mark.parametrize(
+    "heads,expected", [(1, 1), (3, 4), (12, 16), (24, 32), (33, 48), (48, 48), (96, 128), (128, 128)]
+)
+def test_native_head_padding_uses_smallest_supported_count(heads, expected):
+    assert sfa.get_kimi_k3_sfa_c8_padded_heads(heads) == expected
+
+
+@pytest.mark.parametrize("heads", [0, 129])
+def test_native_head_padding_rejects_out_of_range(heads):
+    with pytest.raises(ValueError, match="local query heads"):
+        sfa.get_kimi_k3_sfa_c8_padded_heads(heads)
+
+
+def test_missing_native_extension_fails_without_dequantization_fallback():
+    with (
+        patch.object(sfa.torch_npu, "npu_scatter_pa_cache", Mock(), create=True),
+        patch.object(sfa.importlib, "import_module", side_effect=ImportError("not installed")),
+        pytest.raises(RuntimeError, match="no dequantization fallback"),
+    ):
+        sfa.require_kimi_k3_sfa_c8_ops()
+
+
+def test_native_extension_must_expose_v2_reader():
+    with (
+        patch.object(sfa.torch_npu, "npu_scatter_pa_cache", Mock(), create=True),
+        patch.dict(sys.modules, {"cann_ops_transformer": SimpleNamespace()}),
+        pytest.raises(RuntimeError, match="KvQuantSparseFlashAttentionV2"),
+    ):
+        sfa.require_kimi_k3_sfa_c8_ops()
+
+
+@pytest.mark.parametrize(
+    "change,match",
+    [
+        ({"query_start_loc_cpu": [0, 2]}, "B\\+1 offsets"),
+        ({"query_start_loc_cpu": [0, 4, 3], "kv_lens_cpu": [4, 4]}, "non-decreasing"),
+        ({"kv_lens_cpu": [2]}, "at least Q length"),
+        ({"max_index_elements": 0}, "positive integer"),
+        ({"kv_lens_cpu": [17]}, "insufficient columns"),
+        ({"block_table": torch.zeros(1, 1, dtype=torch.int64)}, "int32"),
+        ({"q_raw": torch.zeros(3, 2, 64, dtype=torch.float16)}, "matching BF16"),
+    ],
+)
+def test_attention_rejects_bad_contracts_before_native_call(change, match):
+    kwargs = {
+        "q_latent": torch.zeros(3, 2, 512, dtype=torch.bfloat16),
+        "q_raw": torch.zeros(3, 2, 64, dtype=torch.bfloat16),
+        "packed_cache": torch.zeros(1, 16, 1, 656, dtype=torch.float8_e4m3fn),
+        "block_table": torch.zeros(1, 1, dtype=torch.int32),
+        "query_start_loc_cpu": [0, 3],
+        "kv_lens_cpu": [3],
+        "scale": 1.0,
+    }
+    kwargs.update(change)
+    with patch.object(sfa, "require_kimi_k3_sfa_c8_ops") as load, pytest.raises(ValueError, match=match):
+        sfa.kimi_k3_sfa_c8_attention(**kwargs)
+    load.assert_not_called()
+
+
+def test_device_lengths_are_rejected_without_copying_them_to_cpu():
+    with pytest.raises(ValueError, match="CPU"):
+        sfa._host_lengths(torch.empty(2, dtype=torch.int32, device="meta"), "lengths")
+
+
+def test_legacy_reader_return_is_not_silently_accepted():
+    native = Mock(return_value=(torch.zeros(1, 2, 512, dtype=torch.bfloat16),))
+    with (
+        patch.object(sfa, "require_kimi_k3_sfa_c8_ops", return_value=native),
+        pytest.raises(RuntimeError, match="three-output"),
