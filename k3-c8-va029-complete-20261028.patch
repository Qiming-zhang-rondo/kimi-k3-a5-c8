+def _group128_weight_impl(mxfp8=False, heads=2):
+    impl = _group128_impl()
+    impl.enable_kimi_k3_sfa_c8 = impl.enable_mlapo = True
+    impl.q_lora_rank, impl.qk_nope_head_dim, impl.qk_head_dim = 1536, 128, 192
+    impl.v_head_dim, impl.num_heads = 128, heads
+    impl.head_padding = (1 << (heads - 1).bit_length()) - heads
+    impl.q_a_layernorm = SimpleNamespace(weight=torch.ones(1536, dtype=torch.bfloat16), variance_epsilon=1e-6)
+    impl.kv_a_layernorm = SimpleNamespace(weight=torch.ones(512, dtype=torch.bfloat16), variance_epsilon=1e-4)
+    projections = []
+    for out_dim, in_dim in ((2112, 1024), (heads * 192, 1536)):
+        layer = torch.nn.Module()
+        layer.bias = None
+        weight = torch.randn(out_dim, in_dim, dtype=torch.bfloat16)
+        if mxfp8:
+            scheme = AscendW8A8MXFP8DynamicLinearMethod.__new__(AscendW8A8MXFP8DynamicLinearMethod)
+            scheme.group_size = 32
+            scheme.dynamic_mx_quant_scale_alg = 0
+            layer.quant_method = SimpleNamespace(quant_method=scheme)
+            layer.weight = torch.nn.Parameter(weight.to(torch.float8_e4m3fn), False)
+            layer.weight_scale = torch.nn.Parameter(
+                torch.randint(100, 127, (out_dim, in_dim // 32), dtype=torch.uint8), False
+            )
+        else:
+            layer.quant_method = UnquantizedLinearMethod()
+            layer.weight = torch.nn.Parameter(weight, False)
+        projections.append(layer)
+    impl.fused_qkv_a_proj, impl.q_proj = projections
+    impl.kv_b_proj = SimpleNamespace(
+        quant_method=UnquantizedLinearMethod(), weight=torch.randn(heads * 256, 512, dtype=torch.bfloat16)
+    )
+    return impl
+
