+            torch.zeros(1, 16, 1, 656, dtype=torch.float8_e4m3fn),
+            torch.zeros(1, 1, dtype=torch.int32),
+            [0, 1],
+            [1],
+            1.0,
+        )
+
+
+def _prolog_inputs(mode=0, tokens=3):
+    weight_dtype = torch.bfloat16 if mode == 0 else torch.float8_e4m3fn
+    result = {
+        "hidden_states": torch.ones(tokens, 1024, dtype=torch.bfloat16),
+        "packed_cache": torch.zeros(2, 16, 1, 656, dtype=torch.float8_e4m3fn),
+        "slots": torch.tensor([15, 16, -1][:tokens], dtype=torch.int32),
+        "weight_dq": torch.empty(1024, 1536, dtype=weight_dtype),
+        "weight_uq_qr": torch.empty(1536, 2 * 192, dtype=weight_dtype),
+        "weight_uk": torch.empty(2, 128, 512, dtype=torch.bfloat16),
+        "weight_dkv_kr": torch.empty(1024, 576, dtype=weight_dtype),
+        "gamma_cq": torch.ones(1536, dtype=torch.bfloat16),
+        "gamma_ckv": torch.ones(512, dtype=torch.bfloat16),
+        "epsilon_cq": 1e-5,
+        "epsilon_ckv": 1e-6,
+        "weight_quant_mode": mode,
+    }
+    if mode == 3:
+        result.update(
+            dequant_scale_w_dq=torch.full((1536, 32), 127, dtype=torch.uint8),
+            dequant_scale_w_uq_qr=torch.full((384, 48), 127, dtype=torch.uint8),
+            dequant_scale_w_dkv_kr=torch.full((576, 32), 127, dtype=torch.uint8),
+        )
+    return result
+
+
+def _prolog_outputs(tokens=3):
+    return (
+        torch.randn(tokens, 2, 512, dtype=torch.bfloat16),
+        torch.randn(tokens, 2, 64, dtype=torch.bfloat16),
+        torch.empty(0),
+        torch.empty(0),
+        torch.empty(0),
+    )
+
+
+def test_bf16_prolog_uses_only_current_token_scratch_then_native_quantize_and_scatter():
+    inputs = _prolog_inputs()
+    result = _prolog_outputs()
+    staged_latent = torch.randn(3, 1, 512, dtype=torch.bfloat16)
+    staged_raw = torch.randn(3, 1, 64, dtype=torch.bfloat16)
+
+    def prolog(*args, **kwargs):
+        assert args[0].ndim == 2 and args[0].dtype == torch.bfloat16
+        assert args[7].shape == (3, 1, 512) and args[8].shape == (3, 1, 64)
+        assert args[7] is not inputs["packed_cache"]
+        assert args[7].dtype == args[8].dtype == torch.bfloat16
+        assert kwargs["cache_mode"] == "TND" and kwargs["cache_index"] is None
+        assert kwargs["rope_sin"] is kwargs["rope_cos"] is None
+        assert kwargs["weight_quant_mode"] == kwargs["kv_cache_quant_mode"] == kwargs["query_quant_mode"] == 0
+        assert kwargs["ckvkr_repo_mode"] == kwargs["quant_scale_repo_mode"] == 0
+        assert kwargs["rmsnorm_epsilon_cq"] == 1e-5 and kwargs["rmsnorm_epsilon_ckv"] == 1e-6
+        assert kwargs["dequant_scale_x"] is kwargs["dequant_scale_w_dq"] is None
+        assert kwargs["dequant_scale_w_uq_qr"] is kwargs["dequant_scale_w_dkv_kr"] is None
+        args[7].copy_(staged_latent)
+        args[8].copy_(staged_raw)
+        return result
+
+    with (
+        patch.object(sfa, "require_kimi_k3_sfa_c8_prolog_ops", return_value=prolog),
+        patch.object(sfa.torch_npu, "npu_dynamic_block_quant", side_effect=_quantize, create=True) as quantize,
+        patch.object(sfa, "scatter_kimi_k3_sfa_c8") as scatter,
+    ):
+        q_latent, q_raw = sfa.kimi_k3_sfa_c8_prolog(**inputs)
+    assert q_latent is result[0] and q_raw is result[1]
+    quantize.assert_called_once()
+    torch.testing.assert_close(quantize.call_args.args[0], staged_latent)
+    assert scatter.call_args.args[1] is inputs["slots"] and scatter.call_args.args[2] is inputs["packed_cache"]
+    packed = scatter.call_args.args[0]
+    assert packed.shape == (3, 1, 656)
+    torch.testing.assert_close(packed[..., 512:640].contiguous().view(torch.bfloat16), staged_raw)
