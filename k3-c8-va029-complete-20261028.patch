+    ):
+        graph_utils.ModelAclGraphManager.run_fullgraph(manager, SimpleNamespace(num_tokens=4))
+    backend.assert_not_called()
+    manager._graph_relay.assert_not_called()
+    manager._updatable_graph_replay.assert_not_called()
+
+
+@pytest.mark.parametrize("updatable", [False, True])
+def test_valid_c8_metadata_preserves_graph_dispatch(updatable):
+    metadata = _metadata()
+    manager = _manager(metadata)
+    desc = SimpleNamespace(num_tokens=4)
+    backend = object()
+    with (
+        patch.object(graph_utils, "set_current_vllm_config", return_value=nullcontext()),
+        patch.object(graph_utils, "_get_graph_update_backend", return_value=backend),
+        patch.object(graph_utils, "use_updatable_graph", return_value=updatable),
+    ):
+        result = graph_utils.ModelAclGraphManager.run_fullgraph(manager, desc)
+    if updatable:
+        assert result == "updatable replay"
+        manager._updatable_graph_replay.assert_called_once_with(desc, metadata)
+        manager._graph_relay.assert_not_called()
+    else:
+        assert result == "legacy replay"
+        manager._graph_relay.assert_called_once_with(backend, desc, 4, metadata)
+        manager._updatable_graph_replay.assert_not_called()
