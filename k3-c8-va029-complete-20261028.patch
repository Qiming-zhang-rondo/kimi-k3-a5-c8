+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A5 native K3 C8 checks; no model checkpoint or mocked NPU operators.
+
+Run with the A5 build and CANN 9.2 native ops installed:
+pytest -sv --noconftest tests/e2e/nightly/single_node/ops/singlecard_ops/test_kimi_k3_sfa_c8.py
+
+This format is group128 FP8 + FP32 scales, not group32 MXFP8.
+
+Prolog ON/OFF accuracy (BF16 and MXFP8 projection weights):
+pytest -sv --noconftest tests/e2e/nightly/single_node/ops/singlecard_ops/test_kimi_k3_sfa_c8.py -k prolog
+
+Opt-in operator-chain microbenchmark, not a whole-model throughput benchmark:
+python tests/e2e/nightly/single_node/ops/singlecard_ops/test_kimi_k3_sfa_c8.py \
+    --benchmark --tokens 1 128 --weight-quant-mode 0 --padded-pages
+Repeat with --weight-quant-mode 3 for MXFP8 projections. Both modes still use
+the same group128/FP32-scale cache; MXFP8 here describes the projection weights.
+"""
+
+import argparse
+import json
+import math
+import time
+from functools import partial
+from itertools import accumulate
+
+import pytest
+import torch
+import torch_npu
+
+from vllm_ascend.attention.kimi_k3_sfa_c8 import (
+    kimi_k3_sfa_c8_attention,
+    kimi_k3_sfa_c8_prolog,
+    pack_kimi_k3_sfa_c8,
+    require_kimi_k3_sfa_c8_ops,
+    scatter_kimi_k3_sfa_c8,
+)
+from vllm_ascend.device.device_config import check_ascend_device_type, is_950
+
+LATENT_DIM = 512
+RAW_DIM = 64
+QUANT_GROUP = 128
+PACKED_DIM = 656
+PAGE_SIZE = 128
+QUERY_HEADS = 64
+ATTENTION_SCALE = (LATENT_DIM + RAW_DIM) ** -0.5
+SAME_CACHE_ATOL = 2e-2
+SAME_CACHE_RTOL = 2e-2
+PROLOG_HIDDEN_DIM = 1024
+PROLOG_Q_RANK = 1536
+PROLOG_QK_DIM = 128
+PROLOG_HEADS = 2
+PROLOG_ATTENTION_SCALE = (PROLOG_QK_DIM + RAW_DIM) ** -0.5
+FRACTAL_NZ = 29
+MX_GROUP_SIZE = 32
+CACHE_GUARD_BYTE = 91
+
+
+@pytest.fixture(scope="module", autouse=True)
+def require_a5_native_c8():
+    if not torch.npu.is_available() or not is_950():
+        pytest.skip("K3 native C8 requires an Ascend 950 device and A5 VA build.")
+    check_ascend_device_type()
+    try:
+        require_kimi_k3_sfa_c8_ops()
+    except RuntimeError as exc:
+        pytest.fail(str(exc))
+
+
+def _unpack_cpu(packed):
+    """Decode the physical bytes independently of the production helper."""
+    packed_bytes = packed.view(torch.uint8).cpu()
+    quantized = packed_bytes[..., :LATENT_DIM].contiguous().view(torch.float8_e4m3fn).float()
+    raw_end = LATENT_DIM + RAW_DIM * 2
+    raw = packed_bytes[..., LATENT_DIM:raw_end].contiguous().view(torch.bfloat16)
+    scales = packed_bytes[..., raw_end:].contiguous().view(torch.float32)
+    assert scales.shape[-1] == LATENT_DIM // QUANT_GROUP
+    assert torch.isfinite(scales).all() and (scales > 0).all()
+    latent = (quantized * scales.repeat_interleave(QUANT_GROUP, dim=-1)).to(torch.bfloat16)
+    return latent, raw, scales
+
+
+def _dense_reference(q_latent, q_raw, latent, raw, query_lengths, kv_lengths, *, scale=ATTENTION_SCALE):
+    """Causal MLA scores use latent AND the unrotated raw positional slice."""
+    outputs = []
+    query_offset = 0
+    for batch, (query_length, kv_length) in enumerate(zip(query_lengths, kv_lengths)):
+        keys = latent[batch][:kv_length, 0].float()
+        raw_keys = raw[batch][:kv_length, 0].float()
+        for row in range(query_length):
+            visible = kv_length - query_length + row + 1
+            q_index = query_offset + row
+            scores = q_latent[q_index].float() @ keys[:visible].T
+            scores += q_raw[q_index].float() @ raw_keys[:visible].T
+            probabilities = torch.softmax(scores * scale, dim=-1)
+            outputs.append(probabilities @ keys[:visible])
+        query_offset += query_length
+    return torch.stack(outputs)
+
+
+def _slots_for_range(block_table, batch, begin, end):
+    positions = torch.arange(begin, end, dtype=torch.long)
+    return block_table[batch, positions // PAGE_SIZE].long() * PAGE_SIZE + positions % PAGE_SIZE
+
+
+def _run_attention(
+    query, raw_query, cache, block_table, query_lengths, kv_lengths, *, chunk_rows, scale=ATTENTION_SCALE
+):
+    return (
+        kimi_k3_sfa_c8_attention(
+            query.npu(),
+            raw_query.npu(),
+            cache,
+            block_table.npu(),
+            torch.tensor((0, *accumulate(query_lengths)), dtype=torch.int32),
+            torch.tensor(kv_lengths, dtype=torch.int32),
+            scale,
+            max_index_elements=chunk_rows * max(kv_lengths),
+        )
+        .float()
+        .cpu()
+    )
+
+
+@torch.inference_mode()
+def test_kimi_k3_c8_pack_preserves_raw64_and_group128_scales():
+    generator = torch.Generator().manual_seed(950)
+    latent = torch.randn(7, 1, LATENT_DIM, generator=generator)
+    # Different group ranges make a scalar-scale or group32 layout mix-up visible.
+    latent *= torch.tensor((0.125, 0.5, 2.0, 8.0)).repeat_interleave(QUANT_GROUP)
+    latent = latent.to(torch.bfloat16)
+    raw = torch.randn(7, 1, RAW_DIM, generator=generator).to(torch.bfloat16)
+    packed = pack_kimi_k3_sfa_c8(latent.npu(), raw.npu())
+    expected_quant, expected_scales = torch_npu.npu_dynamic_block_quant(
+        latent.npu(),
+        dst_type=torch.float8_e4m3fn,
+        row_block_size=1,
+        col_block_size=QUANT_GROUP,
+    )
+    assert packed.shape == (7, 1, PACKED_DIM)
+    assert packed.dtype == torch.float8_e4m3fn
+    packed_bytes = packed.view(torch.uint8).cpu()
+    torch.testing.assert_close(
+        packed_bytes[..., :LATENT_DIM],
+        expected_quant.view(torch.uint8).cpu(),
+        atol=0,
+        rtol=0,
+    )
+    decoded_latent, decoded_raw, decoded_scales = _unpack_cpu(packed)
+    torch.testing.assert_close(decoded_raw.view(torch.uint8), raw.view(torch.uint8), atol=0, rtol=0)
+    torch.testing.assert_close(decoded_scales, expected_scales.float().cpu().reshape(7, 1, -1), atol=0, rtol=0)
+    relative_error = torch.linalg.vector_norm(decoded_latent.float() - latent.float()) / torch.linalg.vector_norm(
+        latent.float()
+    )
+    assert relative_error < 0.04, f"FP8 cache relative L2 error: {relative_error}"
+
