+@pytest.mark.parametrize("query_heads", (QUERY_HEADS, 12, 24), ids=("native64", "tp8-heads12", "tp4-heads24"))
+@pytest.mark.parametrize("padded_pages", (False, True))
+@torch.inference_mode()
+def test_kimi_k3_c8_native_paged_causal_attention_and_append(padded_pages, query_heads):
+    generator = torch.Generator().manual_seed(20261020)
+    initial_kv_lengths = (257, 131)
+    initial_query_lengths = (1, 5)
+    append_lengths = (1, 3)
+    final_kv_lengths = tuple(a + b for a, b in zip(initial_kv_lengths, append_lengths))
+    pages_per_request = tuple(math.ceil(length / PAGE_SIZE) for length in final_kv_lengths)
+    page_count = sum(pages_per_request)
+    # Page 0 and the last page are guards; every live page is out of logical order.
+    physical_pages = torch.arange(page_count, 0, -1, dtype=torch.int32)
+    block_table = torch.zeros(len(final_kv_lengths), max(pages_per_request), dtype=torch.int32)
+    page_offset = 0
+    for batch, pages in enumerate(pages_per_request):
+        block_table[batch, :pages] = physical_pages[page_offset : page_offset + pages]
+        page_offset += pages
+    physical_page_rows = PAGE_SIZE + (2 if padded_pages else 0)
+    backing = torch.full((page_count + 4, physical_page_rows, 1, PACKED_DIM), 91, dtype=torch.uint8, device="npu")
+    cache_bytes = backing[1:-1, :PAGE_SIZE]
+    cache = cache_bytes.view(torch.float8_e4m3fn)
+    source_latent = [
+        torch.randn(length, 1, LATENT_DIM, generator=generator).to(torch.bfloat16) for length in final_kv_lengths
+    ]
+    source_raw = [
+        torch.randn(length, 1, RAW_DIM, generator=generator).to(torch.bfloat16) for length in final_kv_lengths
+    ]
+    packed = [pack_kimi_k3_sfa_c8(k.npu(), r.npu()) for k, r in zip(source_latent, source_raw)]
+    decoded = [_unpack_cpu(tensor) for tensor in packed]
+    dequantized_latent = [item[0] for item in decoded]
+    decoded_raw = [item[1] for item in decoded]
+    for batch, length in enumerate(initial_kv_lengths):
+        slots = _slots_for_range(block_table, batch, 0, length)
+        scatter_kimi_k3_sfa_c8(packed[batch][:length], slots.npu(), cache)
+    before_append = cache_bytes.cpu()
+
+    for phase, (query_lengths, kv_lengths) in enumerate(
+        ((initial_query_lengths, initial_kv_lengths), (append_lengths, final_kv_lengths))
+    ):
+        if phase:
+            for batch, (begin, end) in enumerate(zip(initial_kv_lengths, final_kv_lengths)):
+                slots = _slots_for_range(block_table, batch, begin, end)
+                scatter_kimi_k3_sfa_c8(packed[batch][begin:end], slots.npu(), cache)
+        query = torch.randn(sum(query_lengths), query_heads, LATENT_DIM, generator=generator).to(torch.bfloat16)
+        raw_query = torch.randn(sum(query_lengths), query_heads, RAW_DIM, generator=generator).to(torch.bfloat16)
+        expected = _dense_reference(query, raw_query, dequantized_latent, decoded_raw, query_lengths, kv_lengths)
+        bf16_reference = _dense_reference(query, raw_query, source_latent, source_raw, query_lengths, kv_lengths)
+        # Two query rows per native call forces a non-zero prefill chunk offset.
+        output = _run_attention(query, raw_query, cache, block_table, query_lengths, kv_lengths, chunk_rows=2)
+        # For 12/24 real heads, the native reader pads to 16/32 then crops the
+        # head axis. Multiple requests and rows catch token/head axis mix-ups.
+        assert output.shape == (sum(query_lengths), query_heads, LATENT_DIM)
+        assert torch.isfinite(output).all()
+        torch.testing.assert_close(output, expected, atol=SAME_CACHE_ATOL, rtol=SAME_CACHE_RTOL)
+        quant_relative_error = torch.linalg.vector_norm(output - bf16_reference) / torch.linalg.vector_norm(
+            bf16_reference
+        )
+        assert quant_relative_error < 0.08, f"BF16-versus-C8 relative L2 error: {quant_relative_error}"
+        # A single query chunk must agree with the chunked path.
+        unchunked = _run_attention(
+            query, raw_query, cache, block_table, query_lengths, kv_lengths, chunk_rows=max(query_lengths)
+        )
+        torch.testing.assert_close(output, unchunked, atol=SAME_CACHE_ATOL, rtol=SAME_CACHE_RTOL)
+
+    after_append = cache_bytes.cpu()
+    for batch, length in enumerate(initial_kv_lengths):
+        slots = _slots_for_range(block_table, batch, 0, length)
+        torch.testing.assert_close(
+            after_append[slots // PAGE_SIZE, slots % PAGE_SIZE],
+            before_append[slots // PAGE_SIZE, slots % PAGE_SIZE],
+            atol=0,
+            rtol=0,
+        )
+        final_slots = _slots_for_range(block_table, batch, 0, final_kv_lengths[batch])
+        torch.testing.assert_close(
+            after_append[final_slots // PAGE_SIZE, final_slots % PAGE_SIZE],
+            packed[batch].view(torch.uint8).cpu(),
+            atol=0,
+            rtol=0,
+        )
+    assert torch.all(after_append[0] == 91) and torch.all(after_append[-1] == 91)
+    backing_cpu = backing.cpu()
+    assert torch.all(backing_cpu[0] == 91) and torch.all(backing_cpu[-1] == 91)
+    if padded_pages:
+        assert torch.all(backing_cpu[:, PAGE_SIZE:] == 91)
+
