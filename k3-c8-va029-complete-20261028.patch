+        impl.kv_a_layernorm = SimpleNamespace(weight=object(), variance_epsilon=1e-4)
+        impl.fused_qkv_a_proj = MagicMock(side_effect=AssertionError("must not execute ordinary projections"))
+        impl._q_proj_and_k_up_proj = MagicMock(side_effect=AssertionError("must not project twice"))
+    q_latent = torch.ones(5, heads, 512, dtype=torch.bfloat16)
