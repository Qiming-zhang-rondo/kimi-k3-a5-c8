+def _prolog_case(tokens, weight_quant_mode, epsilon_cq, epsilon_ckv, *, heads=PROLOG_HEADS):
+    """Use dimensions accepted by MlaPrologV4WeightNz, with non-unit gamma."""
+    generator = torch.Generator().manual_seed(9020)
+
+    def random_bf16(*shape, scale=1.0):
+        return (torch.randn(*shape, generator=generator) * scale).to(torch.bfloat16)
+
+    cpu = {
+        "hidden": random_bf16(tokens, PROLOG_HIDDEN_DIM, scale=0.125),
+        "weight_qkv": random_bf16(
+            PROLOG_HIDDEN_DIM, PROLOG_Q_RANK + LATENT_DIM + RAW_DIM, scale=PROLOG_HIDDEN_DIM**-0.5
+        ),
+        "weight_uq_qr": random_bf16(PROLOG_Q_RANK, heads * (PROLOG_QK_DIM + RAW_DIM), scale=PROLOG_Q_RANK**-0.5),
+        "weight_uk": random_bf16(heads, PROLOG_QK_DIM, LATENT_DIM, scale=PROLOG_QK_DIM**-0.5),
+        "gamma_cq": torch.linspace(0.7, 1.3, PROLOG_Q_RANK).to(torch.bfloat16),
+        "gamma_ckv": torch.linspace(1.3, 0.7, LATENT_DIM).to(torch.bfloat16),
+        "epsilon_cq": epsilon_cq,
+        "epsilon_ckv": epsilon_ckv,
+    }
+    ordinary = {
+        key: value.npu() if isinstance(value, torch.Tensor) else value for key, value in cpu.items() if key != "hidden"
+    }
+    fused = {key: ordinary[key] for key in ("weight_uk", "gamma_cq", "gamma_ckv", "epsilon_cq", "epsilon_ckv")}
+    fused["weight_quant_mode"] = weight_quant_mode
+    for name in ("weight_qkv", "weight_uq_qr"):
+        weight = ordinary[name]
+        if weight_quant_mode == 3:
+            # Per-output scales over the reduction dimension, not output groups.
+            quantized, scales = torch_npu.npu_dynamic_mx_quant(
+                weight.T.contiguous(), dst_type=torch.float8_e4m3fn, scale_alg=0
+            )
+            weight = quantized.T.contiguous()
+            scales = scales.view(torch.uint8).reshape(weight.shape[1], weight.shape[0] // MX_GROUP_SIZE)
+            ordinary[name + "_scale"] = scales.reshape(weight.shape[1], -1, 2).transpose(0, 1).contiguous()
+            if name == "weight_qkv":
+                fused["dequant_scale_w_dq"] = scales[:PROLOG_Q_RANK].contiguous()
+                fused["dequant_scale_w_dkv_kr"] = scales[PROLOG_Q_RANK:].contiguous()
+            else:
+                fused["dequant_scale_w_uq_qr"] = scales.contiguous()
+        ordinary[name] = torch_npu.npu_format_cast(weight.contiguous(), FRACTAL_NZ)
+        if name == "weight_qkv":
+            fused["weight_dq"] = torch_npu.npu_format_cast(weight[:, :PROLOG_Q_RANK].contiguous(), FRACTAL_NZ)
+            fused["weight_dkv_kr"] = torch_npu.npu_format_cast(weight[:, PROLOG_Q_RANK:].contiguous(), FRACTAL_NZ)
+        else:
+            fused[name] = ordinary[name]
+    return cpu, ordinary, fused
+
+
+def _cpu_prolog_reference(cpu):
+    """Ordinary BF16 linear/RMSNorm stages; no production Prolog or RoPE."""
+
+    def rms_norm(x, gamma, epsilon):
+        values = x.float()
+        return (values * torch.rsqrt(values.square().mean(-1, keepdim=True) + epsilon) * gamma.float()).to(
+            torch.bfloat16
+        )
+
+    qkv = (cpu["hidden"].float() @ cpu["weight_qkv"].float()).to(torch.bfloat16)
+    q_c = rms_norm(qkv[:, :PROLOG_Q_RANK], cpu["gamma_cq"], cpu["epsilon_cq"])
+    q = (q_c.float() @ cpu["weight_uq_qr"].float()).to(torch.bfloat16)
+    q = q.reshape(-1, cpu["weight_uk"].shape[0], PROLOG_QK_DIM + RAW_DIM)
+    q_latent = (
+        torch.bmm(q[..., :PROLOG_QK_DIM].transpose(0, 1).float(), cpu["weight_uk"].float())
+        .to(torch.bfloat16)
+        .transpose(0, 1)
+    )
+    kv = qkv[:, PROLOG_Q_RANK:]
+    latent = rms_norm(kv[:, :LATENT_DIM], cpu["gamma_ckv"], cpu["epsilon_ckv"]).unsqueeze(1)
+    return q_latent, q[..., PROLOG_QK_DIM:], latent, kv[:, LATENT_DIM:].unsqueeze(1)
+
+
+def _ordinary_prolog(hidden, cache, slots, weights):
+    """enable_mlapo=False analogue: fused QKV linear, Q up, RMS, BMM, writer."""
+
+    def linear(x, name):
+        scale = weights.get(name + "_scale")
+        if scale is None:
+            return x @ weights[name]
+        quantized, x_scale = torch_npu.npu_dynamic_mx_quant(x.contiguous(), dst_type=torch.float8_e4m3fn, scale_alg=0)
+        return torch_npu.npu_quant_matmul(
+            quantized,
+            weights[name],
+            scale,
+            scale_dtype=torch_npu.float8_e8m0fnu,
+            pertoken_scale=x_scale,
+            pertoken_scale_dtype=torch_npu.float8_e8m0fnu,
+            output_dtype=torch.bfloat16,
+            group_sizes=[1, 1, MX_GROUP_SIZE],
+        )
+
+    qkv = linear(hidden, "weight_qkv")
+    q_c = torch_npu.npu_rms_norm(qkv[:, :PROLOG_Q_RANK].contiguous(), weights["gamma_cq"], weights["epsilon_cq"])[0]
+    q = linear(q_c, "weight_uq_qr").reshape(-1, weights["weight_uk"].shape[0], PROLOG_QK_DIM + RAW_DIM)
+    q_latent = (
+        torch.bmm(q[..., :PROLOG_QK_DIM].transpose(0, 1).contiguous(), weights["weight_uk"])
+        .transpose(0, 1)
+        .contiguous()
+    )
+    kv = qkv[:, PROLOG_Q_RANK:]
+    latent = torch_npu.npu_rms_norm(kv[:, :LATENT_DIM].contiguous(), weights["gamma_ckv"], weights["epsilon_ckv"])[0]
+    packed = pack_kimi_k3_sfa_c8(latent, kv[:, LATENT_DIM:])
+    scatter_kimi_k3_sfa_c8(packed, slots, cache)
+    return q_latent, q[..., PROLOG_QK_DIM:].contiguous()
+
+
+def _prolog_cache(tokens, padded_pages):
+    pages = math.ceil(tokens / PAGE_SIZE)
+    physical_rows = PAGE_SIZE + (2 if padded_pages else 0)
+    backing = torch.full((pages + 4, physical_rows, 1, PACKED_DIM), CACHE_GUARD_BYTE, dtype=torch.uint8, device="npu")
+    # Extra storage before the cache and between its pages must remain intact.
+    cache = backing[1:-1, :PAGE_SIZE].view(torch.float8_e4m3fn)
+    table = torch.arange(pages, 0, -1, dtype=torch.int32).reshape(1, pages)
+    return backing, cache, table
+
+
+def _relative_l2(actual, expected):
+    actual, expected = actual.float().cpu(), expected.float().cpu()
+    assert actual.shape == expected.shape and torch.isfinite(actual).all()
+    return (torch.linalg.vector_norm(actual - expected) / torch.linalg.vector_norm(expected).clamp_min(1e-8)).item()
+
+
+def _assert_prolog_cache_guards(backing, slots):
+    backing_cpu = backing.cpu()
+    written = torch.zeros(backing_cpu.shape[:2], dtype=torch.bool)
+    written[slots // PAGE_SIZE + 1, slots % PAGE_SIZE] = True
+    assert torch.all(backing_cpu[~written] == CACHE_GUARD_BYTE)
+
+
+@pytest.mark.parametrize("weight_quant_mode", (0, 3), ids=("bf16", "mxfp8"))
+@pytest.mark.parametrize("query_heads", (PROLOG_HEADS, 12), ids=("native2", "tp8-heads12"))
+@pytest.mark.parametrize(
+    "tokens,padded_pages,epsilon_cq,epsilon_ckv",
+    ((1, False, 1e-6, 1e-6), (7, False, 0.02, 0.04), (129, True, 0.02, 0.04)),
+    ids=("decode", "nondefault-rms", "page-boundary-hybrid-stride"),
+)
+@torch.inference_mode()
+def test_kimi_k3_c8_prolog_on_off_no_rope(
+    weight_quant_mode, query_heads, tokens, padded_pages, epsilon_cq, epsilon_ckv
+):
+    cpu, ordinary, fused = _prolog_case(tokens + 1, weight_quant_mode, epsilon_cq, epsilon_ckv, heads=query_heads)
+    hidden = cpu["hidden"].npu()
+    expected_q, expected_raw_q, expected_latent, expected_raw_k = _cpu_prolog_reference(cpu)
+    off_backing, off_cache, table = _prolog_cache(tokens + 1, padded_pages)
+    on_backing, on_cache, _ = _prolog_cache(tokens + 1, padded_pages)
+    all_slots = _slots_for_range(table, 0, 0, tokens + 1)
+    # Mode3 adds projection quantization; do not demand byte identity to BF16.
+    projection_tolerance = 0.02 if weight_quant_mode == 0 else 0.10
+    cache_tolerance = 0.06 if weight_quant_mode == 0 else 0.12
+    attention_tolerance = 0.10 if weight_quant_mode == 0 else 0.18
+    before_append = None
+    for begin, end in ((0, tokens), (tokens, tokens + 1)):
+        slots = all_slots[begin:end].npu()
+        q_off, raw_off = _ordinary_prolog(hidden[begin:end], off_cache, slots, ordinary)
+        q_on, raw_on = kimi_k3_sfa_c8_prolog(hidden[begin:end], on_cache, slots, **fused)
+        # Prolog and projection weights keep the real local head count; only
+        # the downstream SFA call pads the BF16 query and crops its output.
+        assert q_on.shape == q_off.shape == (end - begin, query_heads, LATENT_DIM)
+        assert raw_on.shape == raw_off.shape == (end - begin, query_heads, RAW_DIM)
+        assert _relative_l2(q_on, q_off) < projection_tolerance
+        assert _relative_l2(raw_on, raw_off) < projection_tolerance
+        # These comparisons specifically detect an accidental rotation of raw64.
+        assert _relative_l2(q_on, expected_q[begin:end]) < projection_tolerance
+        assert _relative_l2(raw_on, expected_raw_q[begin:end]) < projection_tolerance
+        cached = []
+        outputs = []
+        for cache, query, raw_query in ((off_cache, q_off, raw_off), (on_cache, q_on, raw_on)):
+            cache_bytes = cache.view(torch.uint8).cpu()
+            written_slots = all_slots[:end]
+            decoded = _unpack_cpu(cache_bytes[written_slots // PAGE_SIZE, written_slots % PAGE_SIZE])
+            latent, raw, scales = decoded
+            assert _relative_l2(latent, expected_latent[:end]) < cache_tolerance
+            assert _relative_l2(raw, expected_raw_k[:end]) < projection_tolerance
+            expected_attention = _dense_reference(
+                query.cpu(),
+                raw_query.cpu(),
+                [latent],
+                [raw],
+                [end - begin],
+                [end],
+                scale=PROLOG_ATTENTION_SCALE,
+            )
+            output = _run_attention(
+                query,
+                raw_query,
+                cache,
+                table,
+                [end - begin],
+                [end],
+                chunk_rows=17,
+                scale=PROLOG_ATTENTION_SCALE,
+            )
+            assert output.shape == (end - begin, query_heads, LATENT_DIM)
+            torch.testing.assert_close(output, expected_attention, atol=SAME_CACHE_ATOL, rtol=SAME_CACHE_RTOL)
+            cached.append((latent, raw, scales))
+            outputs.append(output)
+        assert _relative_l2(cached[1][0], cached[0][0]) < cache_tolerance
+        assert _relative_l2(cached[1][2], cached[0][2]) < projection_tolerance
+        assert _relative_l2(outputs[1], outputs[0]) < attention_tolerance
+        bf16_attention = _dense_reference(
+            expected_q[begin:end],
+            expected_raw_q[begin:end],
+            [expected_latent],
+            [expected_raw_k],
+            [end - begin],
+            [end],
+            scale=PROLOG_ATTENTION_SCALE,
+        )
+        assert _relative_l2(outputs[1], bf16_attention) < attention_tolerance
+        if begin:
+            old_slots = all_slots[:begin]
+            for cache, previous in zip((off_cache, on_cache), before_append):
+                current = cache.view(torch.uint8).cpu()
+                torch.testing.assert_close(
+                    current[old_slots // PAGE_SIZE, old_slots % PAGE_SIZE],
+                    previous[old_slots // PAGE_SIZE, old_slots % PAGE_SIZE],
+                    atol=0,
+                    rtol=0,
+                )
+        before_append = (off_cache.view(torch.uint8).cpu(), on_cache.view(torch.uint8).cpu())
+        for backing in (off_backing, on_backing):
+            _assert_prolog_cache_guards(backing, all_slots[:end])
+
+
+def _measure_native_ms(operation, *, warmup, iterations):
+    for _ in range(warmup):
+        operation()
+    torch.npu.synchronize()
+    start = time.perf_counter()
+    for _ in range(iterations):
+        operation()
+    torch.npu.synchronize()
+    return (time.perf_counter() - start) * 1000 / iterations
+
+
+def _prolog_attention_pipeline(operation, cache, table, query_starts, kv_lengths):
+    query, raw_query = operation()
+    return kimi_k3_sfa_c8_attention(query, raw_query, cache, table, query_starts, kv_lengths, PROLOG_ATTENTION_SCALE)
+
+
+@torch.inference_mode()
+def _benchmark_prolog(args):
+    if not torch.npu.is_available() or not is_950():
+        raise RuntimeError("This benchmark requires a real Ascend 950 device and an A5 VA build.")
+    check_ascend_device_type()
+    require_kimi_k3_sfa_c8_ops()
+    for tokens in args.tokens:
+        cpu, ordinary, fused = _prolog_case(tokens, args.weight_quant_mode, 1e-6, 1e-6)
+        hidden = cpu["hidden"].npu()
+        kv_length = args.prefix_tokens + tokens
+        caches = [_prolog_cache(kv_length, args.padded_pages) for _ in range(2)]
+        table_cpu = caches[0][2]
+        table = table_cpu.npu()
+        slots = _slots_for_range(table_cpu, 0, args.prefix_tokens, kv_length).npu()
+        if args.prefix_tokens:
+            generator = torch.Generator().manual_seed(128)
+            latent = torch.randn(args.prefix_tokens, 1, LATENT_DIM, generator=generator).to(torch.bfloat16)
+            raw = torch.randn(args.prefix_tokens, 1, RAW_DIM, generator=generator).to(torch.bfloat16)
+            packed = pack_kimi_k3_sfa_c8(latent.npu(), raw.npu())
+            prefix_slots = _slots_for_range(table_cpu, 0, 0, args.prefix_tokens).npu()
+            for _, cache, _ in caches:
+                scatter_kimi_k3_sfa_c8(packed, prefix_slots, cache)
+        operations = (
+            partial(_ordinary_prolog, hidden, caches[0][1], slots, ordinary),
+            partial(kimi_k3_sfa_c8_prolog, hidden, caches[1][1], slots, **fused),
+        )
+        query_starts = torch.tensor([0, tokens], dtype=torch.int32)
+        kv_lengths = torch.tensor([kv_length], dtype=torch.int32)
+        measurements = {}
+        outputs = []
+        for enabled, operation, (_, cache, _) in zip((False, True), operations, caches):
+            pipeline = partial(_prolog_attention_pipeline, operation, cache, table, query_starts, kv_lengths)
+            measurements[f"enable_mlapo_{str(enabled).lower()}"] = {
+                "preprocess_ms": _measure_native_ms(operation, warmup=args.warmup, iterations=args.iterations),
+                "preprocess_plus_attention_ms": _measure_native_ms(
+                    pipeline, warmup=args.warmup, iterations=args.iterations
+                ),
+            }
+            outputs.append(pipeline().float().cpu())
+        error = _relative_l2(outputs[1], outputs[0])
+        assert error < (0.10 if args.weight_quant_mode == 0 else 0.18), f"ON/OFF relative L2 error: {error}"
+        print(
+            json.dumps(
+                {
+                    "scope": "native operator chain; excludes weight preparation and value/output projections",
+                    "timing": "host wall time, synchronized once before/after each iteration group",
+                    "device": torch.npu.get_device_name(),
+                    "tokens": tokens,
+                    "prefix_tokens": args.prefix_tokens,
+                    "padded_pages": args.padded_pages,
+                    "weight_quant_mode": args.weight_quant_mode,
+                    "heads": PROLOG_HEADS,
+                    "iterations": args.iterations,
+                    "on_off_relative_l2": error,
+                    **measurements,
+                }
+            ),
+            flush=True,
+        )
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description="A5 K3 C8 native Prolog ON/OFF microbenchmark.")
+    parser.add_argument("--benchmark", action="store_true", help="Explicitly enable the native benchmark.")
+    parser.add_argument("--tokens", nargs="+", type=int, default=[1, 128])
+    parser.add_argument("--prefix-tokens", type=int, default=256)
+    parser.add_argument("--weight-quant-mode", type=int, choices=(0, 3), default=0)
+    parser.add_argument("--padded-pages", action="store_true")
+    parser.add_argument("--warmup", type=int, default=10)
+    parser.add_argument("--iterations", type=int, default=50)
+    arguments = parser.parse_args()
+    if not arguments.benchmark:
+        parser.error("Use pytest for accuracy tests, or pass --benchmark to run the opt-in microbenchmark.")
+    if min(arguments.tokens) <= 0 or arguments.prefix_tokens < 0 or arguments.warmup < 0 or arguments.iterations <= 0:
+        parser.error("tokens/iterations must be positive and prefix-tokens/warmup must be non-negative.")
+    _benchmark_prolog(arguments)
