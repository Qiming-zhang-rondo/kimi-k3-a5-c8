+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Source regression for the standalone NPU tests; not an NPU capture test."""
+
+import ast
+from pathlib import Path
+
+import pytest
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "test_kimi_k3_c8_native_decode_graph_replay",
+        "test_kimi_k3_c8_native_graph_bucket_switch_with_eager_interleave",
+    ],
+)
+def test_native_capture_uses_owned_side_stream_and_joins_it(name):
+    source = (
+        Path(__file__).resolve().parents[2] / "e2e/nightly/single_node/ops/singlecard_ops/test_kimi_k3_sfa_c8_graph.py"
+    )
+    tree = ast.parse(source.read_text())
+    function = next(node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == name)
+    # Top-level allocation also ensures all buckets reuse one stream.
+    allocation = next(
+        node
+        for node in function.body
+        if isinstance(node, ast.Assign)
+        and any(isinstance(target, ast.Name) and target.id == "capture_stream" for target in node.targets)
+    )
+    assert ast.unparse(allocation.value) == "torch.npu.Stream()"
+    capture = next(
+        node
+        for node in ast.walk(function)
+        if isinstance(node, ast.Call) and ast.unparse(node.func) == "torch.npu.graph"
+    )
+    stream = next(keyword.value for keyword in capture.keywords if keyword.arg == "stream")
+    assert isinstance(stream, ast.Name) and stream.id == "capture_stream"
+    assert allocation.lineno < capture.lineno
+    calls = [node for node in ast.walk(function) if isinstance(node, ast.Call)]
+    assert any(ast.unparse(node) == "torch.npu.synchronize()" and node.lineno < capture.lineno for node in calls)
+    assert any(
+        ast.unparse(node) == "torch.npu.current_stream().wait_stream(capture_stream)" and node.lineno > capture.lineno
+        for node in calls
+    )
