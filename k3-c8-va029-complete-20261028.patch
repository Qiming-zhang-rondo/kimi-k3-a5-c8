+@pytest.mark.parametrize("enabled", [False, True])
+def test_public_switch_routes_k3(arch, enabled):
+    assert _resolve_kimi_k3_c8_flag([arch], {"enable_sparse_sfa_c8": enabled}, False, enabled) is enabled
+
+
+@pytest.mark.parametrize("enabled", [False, True])
