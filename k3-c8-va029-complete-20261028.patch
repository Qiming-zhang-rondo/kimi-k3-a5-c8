+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A5 native K3 C8 decode-graph replay checks, without model checkpoints.
+
+Run on the A5/CANN 9.2 environment, not the CPU mock test environment:
+pytest -sv --noconftest tests/e2e/nightly/single_node/ops/singlecard_ops/test_kimi_k3_sfa_c8_graph.py
+
+One captured B4 graph is replayed with 4 -> 1 -> 3 -> 4 active requests.
+All metadata updates and independent references stay outside capture.
+"""
+
+import math
+
+import pytest
+import torch
+
+from vllm_ascend.attention.kimi_k3_sfa_c8 import (
+    kimi_k3_sfa_c8_prolog,
+    pack_kimi_k3_sfa_c8,
+    require_kimi_k3_sfa_c8_ops,
+    require_kimi_k3_sfa_c8_prolog_ops,
+    scatter_kimi_k3_sfa_c8,
+)
+from vllm_ascend.attention.kimi_k3_sfa_c8_graph import KimiK3C8DecodeState, kimi_k3_sfa_c8_decode
+from vllm_ascend.device.device_config import check_ascend_device_type, is_950
+
+from . import test_kimi_k3_sfa_c8 as native
+
+CAPACITY = 4
+MAX_LIVE_KV_LENGTH = 130
+SHORT_MODEL_LENGTH = 256
+LONG_MODEL_LENGTH = 32768
+PAGE_PADDING_ROWS = 2
+REPLAY_LENGTHS = ((127, 128, 129, 130), (128,), (129, 127, 128), (130, 129, 130, 127))
+WARMUP_ITERATIONS = 2
+GRAPH_BUCKETS = (4, 1, 8)
+BUCKET_REPLAYS = ((4, (127, 127, 127, 127)), (1, (128,)), (8, (129, 128, 128, 128, 127, 127)), (4, (130, 129, 129)))
+
+
+@pytest.fixture(scope="module", autouse=True)
+def require_a5_native_c8_graph():
+    if not torch.npu.is_available() or not is_950():
+        pytest.skip("K3 C8 NPUGraph checks require a real Ascend 950 and A5 VA build.")
+    check_ascend_device_type()
+    try:
+        require_kimi_k3_sfa_c8_ops()
+        require_kimi_k3_sfa_c8_prolog_ops()
+    except RuntimeError as exc:
+        pytest.fail(str(exc))
+
+
+def _graph_cache(capacity=CAPACITY):
+    pages_per_request = math.ceil(MAX_LIVE_KV_LENGTH / native.PAGE_SIZE)
+    page_count = capacity * pages_per_request
+    backing = torch.full(
+        (page_count + 4, native.PAGE_SIZE + PAGE_PADDING_ROWS, 1, native.PACKED_DIM),
+        native.CACHE_GUARD_BYTE,
+        dtype=torch.uint8,
+        device="npu",
+    )
+    # Nonzero storage offset plus padding between pages must survive capture.
+    cache = backing[1:-1, : native.PAGE_SIZE].view(torch.float8_e4m3fn)
+    return backing, cache
+
+
+def _step_table(phase, capacity=CAPACITY):
+    pages_per_request = math.ceil(MAX_LIVE_KV_LENGTH / native.PAGE_SIZE)
+    page_count = capacity * pages_per_request
+    # Every replay changes every request's physical pages; 0/last stay guards.
+    return torch.arange(page_count, 0, -1, dtype=torch.int32).roll(phase).reshape(capacity, pages_per_request)
+
+
+def _prepare_replay(phase, lengths, backings, caches, hidden, state):
+    """Prepare a changed batch outside capture, preserving all graph addresses."""
+    generator = torch.Generator().manual_seed(9200 + phase)
+    table = _step_table(phase)
+    slots = torch.stack(
+        [native._slots_for_range(table, row, length - 1, length)[0] for row, length in enumerate(lengths)]
+    )
+    # Nonzero inactive inputs make stale rows observable; only metadata masks
+    # may stop their cache writes and zero their output.
+    hidden.copy_((torch.randn(hidden.shape, generator=generator) * (0.125 + phase * 0.015)).to(torch.bfloat16).npu())
+    for backing in backings:
+        backing.fill_(native.CACHE_GUARD_BYTE)
+    for row, length in enumerate(lengths):
+        latent = torch.randn(length - 1, 1, native.LATENT_DIM, generator=generator).to(torch.bfloat16)
+        raw = torch.randn(length - 1, 1, native.RAW_DIM, generator=generator).to(torch.bfloat16)
+        packed = pack_kimi_k3_sfa_c8(latent.npu(), raw.npu())
+        prefix_slots = native._slots_for_range(table, row, 0, length - 1).npu()
+        for cache in caches:
+            scatter_kimi_k3_sfa_c8(packed, prefix_slots, cache)
+    lengths_cpu = torch.tensor(lengths, dtype=torch.int32)
+    state.update(lengths_cpu, table.npu(), slots.npu(), len(lengths), seq_lens_device=lengths_cpu.npu())
+    return table, slots, backings[0].cpu()
+
+
+def _state_addresses(state):
+    return tuple(
+        getattr(state, name).data_ptr()
+        for name in (
+            "seq_lens",
+            "query_ends",
+            "block_table",
+            "slots",
+            "active",
+            "positions",
+            "indices",
+            "invalid_indices",
+        )
+    )
+
+
+def _assert_only_current_slots_changed(backing, before, slots):
+    actual = backing.cpu()
+    changed = torch.zeros(actual.shape[:2], dtype=torch.bool)
+    changed[slots // native.PAGE_SIZE + 1, slots % native.PAGE_SIZE] = True
+    # Includes all existing prefix rows, inactive requests, unused pages, the
+    # leading/trailing storage guards and the two padding rows in every page.
+    torch.testing.assert_close(actual[~changed], before[~changed], atol=0, rtol=0)
+
+
+def _dense_decode_from_packed(query, raw_query, cache, table, lengths):
+    cache_bytes = cache.view(torch.uint8).cpu()
+    latent, raw = [], []
+    for row, length in enumerate(lengths):
+        slots = native._slots_for_range(table, row, 0, length)
+        unpacked = native._unpack_cpu(cache_bytes[slots // native.PAGE_SIZE, slots % native.PAGE_SIZE])
+        latent.append(unpacked[0])
+        raw.append(unpacked[1])
+    return native._dense_reference(
+        query.cpu(),
+        raw_query.cpu(),
+        latent,
+        raw,
+        [1] * len(lengths),
+        lengths,
+        scale=native.PROLOG_ATTENTION_SCALE,
+    )
+
+
+@pytest.mark.parametrize("query_heads", (12, 24, 48), ids=("tp8-heads12", "tp4-heads24", "tp2-heads48"))
+@pytest.mark.parametrize("path", ("ordinary-bf16", "ordinary-mxfp8", "mlapo-bf16", "mlapo-mxfp8"))
+@torch.inference_mode()
+def test_kimi_k3_c8_native_decode_graph_replay(path, query_heads):
+    weight_quant_mode = 3 if path.endswith("mxfp8") else 0
+    cpu, ordinary, fused = native._prolog_case(CAPACITY, weight_quant_mode, 0.02, 0.04, heads=query_heads)
+    hidden = cpu["hidden"].npu()
+    graph_backing, graph_cache = _graph_cache()
+    eager_backing, eager_cache = _graph_cache()
+    # This case validates a 32768-wide fixed index buffer with short live
+    # contexts, not a claim about full 32768-token throughput or accuracy.
+    max_seq_len = LONG_MODEL_LENGTH if path == "mlapo-mxfp8" and query_heads == 12 else SHORT_MODEL_LENGTH
+    state = KimiK3C8DecodeState(CAPACITY, max_seq_len, math.ceil(max_seq_len / native.PAGE_SIZE), hidden.device)
+    addresses = _state_addresses(state)
+    hidden_address, cache_address = hidden.data_ptr(), graph_cache.data_ptr()
+
+    def preprocess(cache):
+        if path.startswith("ordinary"):
+            return native._ordinary_prolog(hidden, cache, state.slots, ordinary)
+        return kimi_k3_sfa_c8_prolog(hidden, cache, state.slots, **fused)
+
+    def pipeline():
+        query, raw_query = preprocess(graph_cache)
+        output = kimi_k3_sfa_c8_decode(query, raw_query, graph_cache, state, native.PROLOG_ATTENTION_SCALE)
+        return query, raw_query, output
+
+    _prepare_replay(0, REPLAY_LENGTHS[0], (graph_backing, eager_backing), (graph_cache, eager_cache), hidden, state)
+    for _ in range(WARMUP_ITERATIONS):
+        pipeline()
+    torch.npu.synchronize()
+    graph = torch.npu.NPUGraph()
+    # Standalone pytest runs on the default stream, unlike MRV2's outer
+    # graph_capture context. Capture must use an explicit non-default stream.
+    capture_stream = torch.npu.Stream()
+    # Match MRV2's default/global capture mode; auto-dispatch could hide an
+    # operator that cannot participate in the actual production graph.
+    with torch.npu.graph(graph, stream=capture_stream):
+        graph_query, graph_raw, graph_output = pipeline()
+    torch.npu.current_stream().wait_stream(capture_stream)
+    output_address = graph_output.data_ptr()
+
+    for phase, lengths in enumerate(REPLAY_LENGTHS):
+        table, slots, before = _prepare_replay(
+            phase, lengths, (graph_backing, eager_backing), (graph_cache, eager_cache), hidden, state
+        )
+        assert _state_addresses(state) == addresses
+        assert hidden.data_ptr() == hidden_address and graph_cache.data_ptr() == cache_address
+        assert graph_output.data_ptr() == output_address
+        graph.replay()
+        actual = graph_output.float().cpu()
+        active = len(lengths)
+        assert actual.shape == (CAPACITY, query_heads, native.LATENT_DIM)
+        assert torch.isfinite(actual).all()
+        torch.testing.assert_close(actual[active:], torch.zeros_like(actual[active:]), atol=0, rtol=0)
+
+        eager_query, eager_raw = preprocess(eager_cache)
+        torch.testing.assert_close(
+            graph_query.cpu(), eager_query.cpu(), atol=native.SAME_CACHE_ATOL, rtol=native.SAME_CACHE_RTOL
+        )
+        torch.testing.assert_close(
+            graph_raw.cpu(), eager_raw.cpu(), atol=native.SAME_CACHE_ATOL, rtol=native.SAME_CACHE_RTOL
+        )
+        torch.testing.assert_close(graph_backing.cpu(), eager_backing.cpu(), atol=0, rtol=0)
+        _assert_only_current_slots_changed(graph_backing, before, slots)
+        # This reference uses the ordinary eager reader rather than the new
+        # graph decode API, so an incorrect fixed-batch layout cannot agree
+        # merely because both sides exercise the same graph metadata logic.
+        eager_output = native._run_attention(
+            eager_query[:active],
+            eager_raw[:active],
+            eager_cache,
+            table[:active],
+            [1] * active,
+            lengths,
+            chunk_rows=1,
+            scale=native.PROLOG_ATTENTION_SCALE,
+        )
+        dense_output = _dense_decode_from_packed(graph_query[:active], graph_raw[:active], graph_cache, table, lengths)
+        torch.testing.assert_close(
+            actual[:active], eager_output, atol=native.SAME_CACHE_ATOL, rtol=native.SAME_CACHE_RTOL
+        )
+        torch.testing.assert_close(
+            actual[:active], dense_output, atol=native.SAME_CACHE_ATOL, rtol=native.SAME_CACHE_RTOL
+        )
+
+
+def _prepare_bucket_replay(buffers, phase, lengths, backing, cache, *, initialize_cache=True):
+    """Update scheduler-owned device values without replacing captured buffers."""
+    generator = torch.Generator().manual_seed(9300 + phase)
+    # Continuous bucket switches retain page ownership; lengths and slots
+    # advance. The other parametrized test covers changing physical tables.
+    table = _step_table(phase if initialize_cache else 0, max(GRAPH_BUCKETS))[: len(lengths)]
+    slot_values = [native._slots_for_range(table, row, length - 1, length)[0] for row, length in enumerate(lengths)]
+    slots = torch.stack(slot_values) if slot_values else torch.empty(0, dtype=torch.int64)
+    for name in ("query", "raw_query", "latent", "raw"):
+        target = buffers[name]
+        target.copy_(torch.randn(target.shape, generator=generator).to(torch.bfloat16).npu())
+    if initialize_cache:
+        backing.fill_(native.CACHE_GUARD_BYTE)
+        for row, length in enumerate(lengths):
+            latent = torch.randn(length - 1, 1, native.LATENT_DIM, generator=generator).to(torch.bfloat16)
+            raw = torch.randn(length - 1, 1, native.RAW_DIM, generator=generator).to(torch.bfloat16)
+            prefix_slots = native._slots_for_range(table, row, 0, length - 1).npu()
+            scatter_kimi_k3_sfa_c8(pack_kimi_k3_sfa_c8(latent.npu(), raw.npu()), prefix_slots, cache)
+    lengths_cpu = torch.tensor(lengths, dtype=torch.int32)
+    buffers["state"].update(lengths_cpu, table.npu(), slots.npu(), len(lengths), seq_lens_device=lengths_cpu.npu())
+    return table, slots
+
+
+def _bucket_pipeline(buffers, cache):
+    packed = pack_kimi_k3_sfa_c8(buffers["latent"], buffers["raw"])
+    scatter_kimi_k3_sfa_c8(packed, buffers["state"].slots, cache)
+    return kimi_k3_sfa_c8_decode(
+        buffers["query"], buffers["raw_query"], cache, buffers["state"], native.PROLOG_ATTENTION_SCALE
+    )
+
+
+@pytest.mark.parametrize("shared_pool", (False, True), ids=("private-pools", "mrv2-shared-pool"))
+@torch.inference_mode()
+def test_kimi_k3_c8_native_graph_bucket_switch_with_eager_interleave(shared_pool):
+    """Capture B4/B1/B8 separately, switch 4 -> 1 -> 8 -> 4, then all inactive."""
+    heads = 12
+    backing, cache = _graph_cache(max(GRAPH_BUCKETS))
+    cache_address = cache.data_ptr()
+    pool = torch.npu.graph_pool_handle() if shared_pool else None
+    # Reuse the same non-default stream for every graph sharing this pool.
+    capture_stream = torch.npu.Stream()
+    buckets = {}
+    for capacity in GRAPH_BUCKETS:
+        buffers = {
+            "state": KimiK3C8DecodeState(
+                capacity, SHORT_MODEL_LENGTH, SHORT_MODEL_LENGTH // native.PAGE_SIZE, cache.device
+            ),
+            "query": torch.empty((capacity, heads, native.LATENT_DIM), dtype=torch.bfloat16, device=cache.device),
+            "raw_query": torch.empty((capacity, heads, native.RAW_DIM), dtype=torch.bfloat16, device=cache.device),
+            "latent": torch.empty((capacity, 1, native.LATENT_DIM), dtype=torch.bfloat16, device=cache.device),
+            "raw": torch.empty((capacity, 1, native.RAW_DIM), dtype=torch.bfloat16, device=cache.device),
+        }
+        _prepare_bucket_replay(buffers, capacity, (127,) * capacity, backing, cache)
+        for _ in range(WARMUP_ITERATIONS):
+            _bucket_pipeline(buffers, cache)
+        torch.npu.synchronize()
+        graph = torch.npu.NPUGraph()
+        with torch.npu.graph(graph, pool=pool, stream=capture_stream):
+            output = _bucket_pipeline(buffers, cache)
+        torch.npu.current_stream().wait_stream(capture_stream)
+        buffers["graph"] = graph
+        buffers["output"] = output
+        buffers["addresses"] = _state_addresses(buffers["state"])
+        buffers["input_addresses"] = tuple(buffers[name].data_ptr() for name in ("query", "raw_query", "latent", "raw"))
+        buffers["output_address"] = output.data_ptr()
+        buckets[capacity] = buffers
+    assert len({item["state"].seq_lens.data_ptr() for item in buckets.values()}) == len(GRAPH_BUCKETS)
+    # Shared graph pools may reuse output storage between buckets. Require
+    # each captured output's address to remain fixed, not globally distinct.
+
+    # Initialize each request's first 126 tokens once. No cache reset or
+    # re-prefill is allowed during the actual bucket-switch replay sequence.
+    _prepare_bucket_replay(buckets[max(GRAPH_BUCKETS)], 0, (127,) * max(GRAPH_BUCKETS), backing, cache)
+    first_b4_output = None
+    graph_written_history = {}
+    for phase, (capacity, lengths) in enumerate((*BUCKET_REPLAYS, (4, ()))):
+        buffers = buckets[capacity]
+        table, slots = _prepare_bucket_replay(buffers, phase, lengths, backing, cache, initialize_cache=False)
+        cache_before = cache.view(torch.uint8).cpu()
+        for previous_slot, previous_bytes in graph_written_history.items():
+            torch.testing.assert_close(
+                cache_before[previous_slot // native.PAGE_SIZE, previous_slot % native.PAGE_SIZE],
+                previous_bytes,
+                atol=0,
+                rtol=0,
+            )
+        active = len(lengths)
+        if active:
+            # Real eager writer/reader interleave: change both current slots
+            # and a history row. The graph must preserve the history edit,
+            # overwrite only its current slots and read the new query values.
+            # Edit history position zero, never the previous graph-written
+            # decode tokens: those must become inputs to later graph replays.
+            eager_slots = torch.cat(
+                [
+                    torch.cat(
+                        (
+                            native._slots_for_range(table, row, 0, 1),
+                            native._slots_for_range(table, row, length - 1, length),
+                        )
+                    )
+                    for row, length in enumerate(lengths)
+                ]
+            )
+            eager_latent = buffers["latent"][:active].repeat_interleave(2, dim=0) * 0.75
+            eager_raw = buffers["raw"][:active].repeat_interleave(2, dim=0) * 0.5
+            scatter_kimi_k3_sfa_c8(pack_kimi_k3_sfa_c8(eager_latent, eager_raw), eager_slots.npu(), cache)
+            buffers["query"].add_(0.125)
+            eager_output = native._run_attention(
+                buffers["query"][:active],
+                buffers["raw_query"][:active],
+                cache,
+                table,
+                [1] * active,
+                lengths,
+                chunk_rows=1,
+                scale=native.PROLOG_ATTENTION_SCALE,
+            )
+            eager_reference = _dense_decode_from_packed(
+                buffers["query"][:active], buffers["raw_query"][:active], cache, table, lengths
+            )
+            torch.testing.assert_close(
+                eager_output, eager_reference, atol=native.SAME_CACHE_ATOL, rtol=native.SAME_CACHE_RTOL
+            )
+            buffers["query"].mul_(0.875)
+        before = backing.cpu()
+        assert cache.data_ptr() == cache_address
+        assert _state_addresses(buffers["state"]) == buffers["addresses"]
+        assert (
+            tuple(buffers[name].data_ptr() for name in ("query", "raw_query", "latent", "raw"))
+            == buffers["input_addresses"]
+        )
+        assert buffers["output"].data_ptr() == buffers["output_address"]
+        buffers["graph"].replay()
+        actual = buffers["output"].float().cpu()
+        assert actual.shape == (capacity, heads, native.LATENT_DIM) and torch.isfinite(actual).all()
+        torch.testing.assert_close(actual[active:], torch.zeros_like(actual[active:]), atol=0, rtol=0)
+        _assert_only_current_slots_changed(backing, before, slots)
+        if active:
+            cache_after = cache.view(torch.uint8).cpu()
+            expected_packed = (
+                pack_kimi_k3_sfa_c8(buffers["latent"][:active], buffers["raw"][:active]).view(torch.uint8).cpu()
+            )
+            torch.testing.assert_close(
+                cache_after[slots // native.PAGE_SIZE, slots % native.PAGE_SIZE], expected_packed, atol=0, rtol=0
+            )
+            for slot in slots.tolist():
+                graph_written_history[slot] = cache_after[slot // native.PAGE_SIZE, slot % native.PAGE_SIZE].clone()
+            expected = _dense_decode_from_packed(
+                buffers["query"][:active], buffers["raw_query"][:active], cache, table, lengths
+            )
+            torch.testing.assert_close(
+                actual[:active], expected, atol=native.SAME_CACHE_ATOL, rtol=native.SAME_CACHE_RTOL
+            )
+            if phase == 0:
+                first_b4_output = actual.clone()
+            elif capacity == 4:
+                assert not torch.equal(actual[:active], first_b4_output[:active])
