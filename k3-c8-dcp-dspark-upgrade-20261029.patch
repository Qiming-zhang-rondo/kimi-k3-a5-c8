+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU mathematical/metadata contracts; not native or distributed NPU proof."""
+
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+import torch
+
+from vllm_ascend.attention import kimi_k3_sfa_c8_graph as graph
+from vllm_ascend.attention import mla_v1
+
+from .test_kimi_k3_sfa_c8_graph import _cache, _dequantize, _native_reference
+from .test_kimi_k3_sfa_c8_integration import _group128_impl
+
+
+def test_dspark_role_uses_loader_scope_not_target_architecture():
+    config = SimpleNamespace(model_config=SimpleNamespace(runner_type="generate"))
+    assert not mla_v1._is_mla_draft_model(config)
+    with mla_v1.compilation_backends.set_model_tag("dspark_head"):
+        assert mla_v1._is_mla_draft_model(config)
+    assert not mla_v1._is_mla_draft_model(config)
+    config.model_config.runner_type = "draft"
+    assert mla_v1._is_mla_draft_model(config)
+
+
+def test_speculative_config_is_not_a_blanket_c8_exclusion():
+    impl = _group128_impl()
+    impl.speculative_config = SimpleNamespace(method="dspark", num_speculative_tokens=3)
+    impl.vllm_config.parallel_config.decode_context_parallel_size = 2
+    impl._merge_dcp_attention_output = lambda *args: None
+    with (
+        patch.object(mla_v1, "get_ascend_config", return_value=SimpleNamespace(kvpp_config=SimpleNamespace(size=1))),
+        patch.object(mla_v1, "require_kimi_k3_sfa_c8_ops"),
+    ):
+        impl._validate_kimi_k3_sfa_c8()
+
+
+@pytest.mark.parametrize("world", [1, 2, 4])
+@pytest.mark.parametrize("interleave", [1, 4, 16])
+def test_multiquery_dcp_prefixes_and_lse_merge_match_dense(world, interleave):
+    torch.manual_seed(97)
+    cache = _cache()
+    query = torch.randn(8, 12, 576).bfloat16()
+    starts = torch.tensor([0, 3, 5, 8], dtype=torch.int32)
+    # CPU upper bounds deliberately differ from acceptance-corrected lengths.
+    bounds = torch.tensor([20, 10, 0], dtype=torch.int32)
+    lengths = torch.tensor([17, 7, 0], dtype=torch.int32)
+    table = torch.tensor([[0, 1, 2], [3, 4, 5]], dtype=torch.int32)
+    visible = [15, 16, 17, 6, 7]
+    expected = torch.zeros(8, 12, 512)
+    for row, length in enumerate(visible):
+        req = 0 if row < 3 else 1
+        pos = torch.arange(length)
+        latent, raw = _dequantize(cache[table[req, pos // 16].long(), pos % 16, 0])
+        scores = query[row].float() @ torch.cat((latent, raw), -1).T * 0.05
+        expected[row] = scores.softmax(-1) @ latent
+    outputs, lses = [], []
+    for rank in range(world):
+        local = torch.zeros_like(cache.view(torch.uint8)).view(cache.dtype)
+        for req, length in enumerate([17, 7]):
+            pos = torch.arange(length)
+            selected = pos[(pos // interleave) % world == rank]
+            local_pos = torch.arange(len(selected))
+            local.view(torch.uint8)[table[req, local_pos // 16].long(), local_pos % 16] = cache.view(torch.uint8)[
+                table[req, selected // 16].long(), selected % 16
+            ]
+        state = graph.KimiK3C8DecodeState(8, 48, 3, torch.device("cpu"))
+        addresses = {k: v.data_ptr() for k, v in vars(state).items() if isinstance(v, torch.Tensor)}
+        state.update(
+            bounds,
+            table,
+            torch.arange(5),
+            5,
+            seq_lens_device=lengths,
+            query_start_loc_cpu=starts,
+            dcp_size=world,
+            dcp_rank=rank,
+            interleave=interleave,
+        )
+        for row, length in enumerate(visible):
+            assert state.seq_lens[row] == sum((p // interleave) % world == rank for p in range(length))
+        with patch.object(graph, "require_kimi_k3_sfa_c8_ops", return_value=_native_reference):
+            out, lse = graph.kimi_k3_sfa_c8_decode(
+                query[..., :512], query[..., 512:], local, state, 0.05, return_lse=True
+            )
+        assert torch.isfinite(out).all()
+        assert out[5:].count_nonzero() == 0
+        assert torch.isneginf(lse[5:]).all()
+        outputs.append(out.float())
+        lses.append(lse)
+        # Rejection/batch shrink must remove stale token rows without moving buffers.
+        state.update(torch.tensor([3]), table[:1], torch.tensor([0]), 1)
+        assert state.slots.tolist() == [0] + [-1] * 7
+        assert addresses == {k: v.data_ptr() for k, v in vars(state).items() if isinstance(v, torch.Tensor)}
+    weights = torch.stack(lses)[:, :5].softmax(0)
+    merged = (weights * torch.stack(outputs)[:, :5]).sum(0)
+    # Local outputs are BF16 before reduction. Bound their rounding error,
+    # rather than using relative tolerance near cancellation/zero outputs.
+    rounding_bound = 0.004 * (weights * torch.stack(outputs)[:, :5].abs()).sum(0) + 2e-5
+    assert ((merged - expected[:5]).abs() <= rounding_bound).all()
+    assert (merged - expected[:5]).norm() / expected[:5].norm() < 0.004
+
+
+def test_multiquery_builder_uses_token_bucket_and_device_lengths():
+    builder = mla_v1.AscendMLAMetadataBuilder.__new__(mla_v1.AscendMLAMetadataBuilder)
+    builder.enable_kimi_k3_sfa_c8 = True
+    builder.kimi_k3_c8_decode_states = {}
+    builder.metadata_cls = mla_v1.AscendMLAMetadata
+    builder.model_config = SimpleNamespace(max_model_len=48)
+    builder.device = torch.device("cpu")
+    builder.dcp_size, builder.dcp_rank, builder.cp_local_block_size = 2, 1, 4
+    common = SimpleNamespace(
+        num_reqs=2,
+        num_actual_tokens=6,
+        graph_pad_size=8,
+        query_start_loc_cpu=torch.tensor([0, 3, 6]),
+        query_start_loc=torch.tensor([0, 3, 6]),
+        _seq_lens_cpu=torch.tensor([19, 11]),
+        seq_lens=torch.tensor([17, 7]),
+        block_table_tensor=torch.tensor([[0, 1], [2, 3]], dtype=torch.int32),
+        slot_mapping=torch.arange(6),
+        causal=True,
+    )
+    state = builder.build(0, common).kimi_k3_c8_decode_state
+    assert state.capacity == 8
+    assert state.seq_lens.tolist() == [7, 8, 8, 1, 2, 3, 0, 0]
+    assert state.block_table[:6].tolist() == [[0, 1]] * 3 + [[2, 3]] * 3
+
+
+@pytest.mark.parametrize("starts", [[1, 2], [0, 3, 2], [0], [0, 3]])
+def test_invalid_multiquery_offsets_fail_before_buffer_update(starts):
+    state = graph.KimiK3C8DecodeState(4, 48, 2, torch.device("cpu"))
+    with pytest.raises(ValueError, match="Query offsets"):
+        state.update(
+            torch.tensor([10]),
+            torch.zeros(1, 2, dtype=torch.int32),
+            torch.arange(2),
+            2,
+            query_start_loc_cpu=torch.tensor(starts),
+        )
+
+
+@pytest.mark.parametrize("rank", [0, 1])
+def test_eager_verification_uses_acceptance_corrected_lengths(rank):
+    impl = _group128_impl()
+    impl.dcp_size, impl.dcp_rank = 2, rank
+    impl.vllm_config.parallel_config.cp_kv_cache_interleave_size = 4
+    impl.scale = 0.05
+    cache = _cache()
+    query = torch.randn(5, 12, 576).bfloat16()
+    table = torch.tensor([[0, 1, 2], [3, 4, 5]], dtype=torch.int32)
+    state = graph.KimiK3C8DecodeState(5, 48, 3, torch.device("cpu"))
+    state.update(
+        torch.tensor([20, 10]),
+        table,
+        torch.arange(5),
+        5,
+        seq_lens_device=torch.tensor([17, 7]),
+        query_start_loc_cpu=torch.tensor([0, 3, 5]),
+        dcp_size=2,
+        dcp_rank=rank,
+        interleave=4,
+    )
+    with patch.object(graph, "require_kimi_k3_sfa_c8_ops", return_value=_native_reference):
+        expected = graph.kimi_k3_sfa_c8_decode(query[..., :512], query[..., 512:], cache, state, 0.05, return_lse=True)
+        actual = impl._kimi_k3_c8_verify_attention(
+            query[..., :512], query[..., 512:], cache, table, [0, 3, 5], [20, 10], torch.tensor([17, 7])
+        )
+    for got, want in zip(actual, expected):
+        torch.testing.assert_close(got, want)
+
+
+def test_dcp_graph_update_skips_c8_and_kda_tasks():
+    from vllm_ascend.attention.context_parallel import mla_cp
+
+    context = SimpleNamespace(
+        attn_metadata={
+            "kda": SimpleNamespace(),
+            "mla": SimpleNamespace(decode=None, kimi_k3_c8_decode_state=object()),
+        }
+    )
+    with (
+        patch.object(mla_cp, "_EXTRA_CTX", SimpleNamespace(is_draft_model=False)),
+        patch.object(mla_cp, "get_graph_params", return_value=None),
+    ):
+        mla_cp.AscendMlaDCPImpl.update_graph_params(None, context, 8)
