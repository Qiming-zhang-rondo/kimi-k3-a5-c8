+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Native verification-prefix/LSE contracts on one A5, without model weights.
+
+Simulates DCP shards on one device; this does NOT validate HCCL collectives or
+the DSpark scheduler. Both still require the multi-card model acceptance test.
+"""
+
+import pytest
+import torch
+import torch_npu
+
+from vllm_ascend.attention.kimi_k3_sfa_c8 import pack_kimi_k3_sfa_c8, scatter_kimi_k3_sfa_c8
+from vllm_ascend.attention.kimi_k3_sfa_c8_graph import KimiK3C8DecodeState, kimi_k3_sfa_c8_decode
+
+from . import test_kimi_k3_sfa_c8 as native
+from .test_kimi_k3_sfa_c8_graph import require_a5_native_c8_graph  # noqa: F401
+
+
+@pytest.mark.parametrize("world,interleave", [(1, 1), (2, 1), (4, 128)])
+@pytest.mark.parametrize("capture", [False, True])
+def test_native_multiquery_shards_lse_and_replay(world, interleave, capture):
+    generator = torch.Generator().manual_seed(931)
+    capacity, heads, max_len = 4, 12, 256
+    latent = torch.randn(max_len, 1, 512, generator=generator).bfloat16()
+    raw = torch.randn(max_len, 1, 64, generator=generator).bfloat16()
+    q = (torch.randn(capacity, heads, 576, generator=generator) * 0.2).bfloat16().npu()
+    packed = pack_kimi_k3_sfa_c8(latent.npu(), raw.npu())
+    decoded, decoded_raw, _ = native._unpack_cpu(packed)
+    positions = torch.arange(max_len)
+    table = torch.tensor([[0, 1]], dtype=torch.int32, device="npu")
+    shards = []
+    for rank in range(world):
+        cache = torch.zeros(2, 128, 1, 656, dtype=torch.uint8, device="npu").view(torch.float8_e4m3fn)
+        selected = positions[(positions // interleave) % world == rank]
+        # Scatter includes ownership-negative slots, as the framework writer does.
+        slots = torch.full((max_len,), -1, dtype=torch.int64)
+        slots[selected] = torch.arange(len(selected))
+        scatter_kimi_k3_sfa_c8(packed, slots.npu(), cache)
+        state = KimiK3C8DecodeState(capacity, max_len, 2, q.device)
+        shards.append((cache, state))
+
+    def update(length, tokens):
+        # A larger CPU bound models async acceptance correction on device.
+        for rank, (_, state) in enumerate(shards):
+            state.update(
+                torch.tensor([length + 2]),
+                table,
+                torch.full((tokens,), -1, device="npu", dtype=torch.int64),
+                tokens,
+                seq_lens_device=torch.tensor([length], dtype=torch.int32, device="npu"),
+                query_start_loc_cpu=torch.tensor([0, tokens]),
+                dcp_size=world,
+                dcp_rank=rank,
+                interleave=interleave,
+            )
+
+    def run():
+        outputs, lses = [], []
+        for cache, state in shards:
+            out, lse = kimi_k3_sfa_c8_decode(
+                q[..., :512], q[..., 512:], cache, state, native.ATTENTION_SCALE, return_lse=True
+            )
+            outputs.append(out.float().flatten(0, 1))
+            lses.append(lse.flatten())
+        merged, _ = torch_npu.npu_attention_update(lses, outputs, 0)
+        merged = merged.view(capacity, heads, 512)
+        return merged.masked_fill(~shards[0][1].active[:, None, None], 0)
+
+    update(130, 4)
+    if capture:
+        stream = torch.npu.Stream()
+        stream.wait_stream(torch.npu.current_stream())
+        with torch.npu.stream(stream):
+            for _ in range(2):
+                run()
+        torch.npu.current_stream().wait_stream(stream)
+        captured = torch.npu.NPUGraph()
+        with torch.npu.graph(captured, stream=stream):
+            output = run()
+        torch.npu.current_stream().wait_stream(stream)
+    for length, tokens in [(130, 4), (7, 1), (129, 3), (17, 4)]:
+        update(length, tokens)
+        if capture:
+            captured.replay()
+        else:
+            output = run()
+        torch.npu.synchronize()
+        expected = native._dense_reference(
+            q[..., :512].cpu()[:tokens], q[..., 512:].cpu()[:tokens], [decoded], [decoded_raw], [tokens], [length]
+        )
+        actual = output.cpu().float()
+        torch.testing.assert_close(actual[:tokens], expected, atol=native.SAME_CACHE_ATOL, rtol=native.SAME_CACHE_RTOL)
+        assert torch.isfinite(actual).all()
+        assert actual[tokens:].count_nonzero() == 0
