diff --git a/vllm_ascend/core/kimi_k3_cache_layout.py b/vllm_ascend/core/kimi_k3_cache_layout.py
new file mode 100644
index 000000000..56fe9e531
--- /dev/null
+++ b/vllm_ascend/core/kimi_k3_cache_layout.py
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Ascend project
+
+from collections import Counter
+
+from vllm.v1.kv_cache_interface import KVCacheGroupSpec, KVCacheSpec, MambaSpec, UniformTypeKVCacheSpecs
+
+
+def get_kimi_k3_c8_cache_layout(
+    groups: list[KVCacheGroupSpec],
+) -> tuple[int, dict[str, int]] | None:
+    """Budget disjoint storage regions for incompatible hybrid cache formats.
+
+    Packed C8 uses page-major storage; ordinary MLA uses whole-pool K/V
+    planes and Mamba uses whole-pool state planes. Different block IDs do
+    not isolate these layouts when they alias the same byte range. Keep
+    the existing native tensor layouts, but allow storage reuse only among
+    identical specs in different scheduler groups.
+
+    Return the total bytes per global block and each layer's region offset
+    *per block*. Multiply both by num_blocks when building descriptors.
+    Logical groups/block tables are unchanged. Non-C8 models are untouched.
+    """
+    layer_groups = [
+        [
+            (
+                name,
+                group.kv_cache_spec.kv_cache_specs[name]
+                if isinstance(group.kv_cache_spec, UniformTypeKVCacheSpecs)
+                else group.kv_cache_spec,
+            )
+            for name in group.layer_names
+        ]
+        for group in groups
+    ]
+    specs = [spec for layers in layer_groups for _, spec in layers]
+    if not any(getattr(spec, "cache_sparse_sfa_c8", False) for spec in specs) or not any(
+        isinstance(spec, MambaSpec) for spec in specs
+    ):
+        return None
+
+    pool_widths: dict[KVCacheSpec, int] = {}
+    for layers in layer_groups:
+        for spec, count in Counter(spec for _, spec in layers).items():
+            pool_widths[spec] = max(pool_widths.get(spec, 0), count)
+
+    pool_offsets: dict[KVCacheSpec, int] = {}
+    bytes_per_block = 0
+    for spec, width in pool_widths.items():
+        pool_offsets[spec] = bytes_per_block
+        bytes_per_block += width * spec.page_size_bytes
+
+    layer_offsets: dict[str, int] = {}
+    for layers in layer_groups:
+        indices: Counter[KVCacheSpec] = Counter()
+        for name, spec in layers:
+            if name in layer_offsets:
+                raise ValueError(f"Duplicate hybrid cache layer: {name}.")
+            layer_offsets[name] = pool_offsets[spec] + indices[spec] * spec.page_size_bytes
+            indices[spec] += 1
+    return bytes_per_block, layer_offsets
